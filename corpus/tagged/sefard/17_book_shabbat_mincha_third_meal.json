  "he:Shabbat Mincha/Pirkei Avot:5:11": {
   "parts": [
    {
     "text": "<b>יא</b> אַרְבַּע מִדּוֹת בַּדֵּעוֹת: נֹחַ לִכְעוֹס וְנֹחַ לִרְצוֹת,",
     "kind": "prayer"
    },
    {
     "text": " יָצָא שְׂכָרוֹ בְהֶפְסֵדוֹ. קָשֶׁה לִכְעוֹס וְקָשֶׁה לִרְצוֹת,",
     "kind": "prayer"
    },
    {
     "text": " יָצָא הֶפְסֵדוֹ בִשְׂכָרוֹ. ",
     "kind": "prayer"
    },
    {
     "text": "<small>(כך גרס הרע\"ב, ויש גורסים להפך)</small>",
     "kind": "instruction",
     "en": "(This is the text of the Ra'avad; some manuscripts read the opposite)"
    },
    {
     "text": ". קָשֶׁה לִכְעוֹס וְנֹחַ לִרְצוֹת,",
     "kind": "prayer"
    },
    {
     "text": " חָסִיד. נֹחַ לִכְעוֹס וְקָשֶׁה לִרְצוֹת,",
     "kind": "prayer"
    },
    {
     "text": " רָשָׁע: ",
     "kind": "prayer"
    }
   ]
