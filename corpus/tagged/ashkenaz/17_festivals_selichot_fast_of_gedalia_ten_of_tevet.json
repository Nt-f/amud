  "he:Festivals/Selichot/Fast of Gedalia:32": {
   "parts": [
    {
     "kind": "prayer",
     "node": "kaddish.half",
     "role": "chazzan",
     "voice": "aloud",
     "minyan": true,
     "text": "יִתְגַּדַּל וְיִתְקַדַּשׁ שְׁמֵהּ רַבָּא. "
    },
    {
     "kind": "speaker",
     "en": "The congregation responds:",
     "role": "congregation",
     "minyan": true,
     "node": "kaddish.half",
     "text": "<br>ועונים: "
    },
    {
     "kind": "prayer",
     "node": "kaddish.half",
     "role": "congregation",
     "minyan": true,
     "text": "אמן<br>"
    }
   ]
  },
  "he:Festivals/Selichot/Fast of Gedalia:34": {
   "kind": "prayer",
   "node": "kaddish.half",
   "role": "chazzan",
   "voice": "aloud",
   "minyan": true
  },
  "he:Festivals/Selichot/Fast of Gedalia:36": {
   "parts": [
    {
     "kind": "prayer",
     "node": "kaddish.half",
     "role": "chazzan",
     "voice": "aloud",
     "minyan": true,
     "text": "וְיַמְלִיךְ מַלְכוּתֵהּ וְיַצְמַח פּוּרְקָנֵהּ וִיקָרֵב "
    },
    {
     "kind": "prayer",
     "node": "kaddish.half",
     "role": "chazzan",
     "voice": "aloud",
     "minyan": true,
     "when": "x_saysKetzMeshicheh",
     "text": "<em><small> קֵץ</small></em>"
    },
    {
     "kind": "prayer",
     "node": "kaddish.half",
     "role": "chazzan",
     "voice": "aloud",
     "minyan": true,
     "text": " מְשִׁיחֵהּ. "
    },
    {
     "kind": "speaker",
     "en": "The congregation responds:",
     "role": "congregation",
     "minyan": true,
     "node": "kaddish.half",
     "text": "<br>ועונים: "
    },
    {
     "kind": "prayer",
     "node": "kaddish.half",
     "role": "congregation",
     "minyan": true,
     "text": "אמן<br>"
    }
   ]
  },
  "he:Festivals/Selichot/Fast of Gedalia:38": {
   "kind": "prayer",
   "node": "kaddish.half",
   "role": "chazzan",
   "voice": "aloud",
   "minyan": true
  },
  "he:Festivals/Selichot/Fast of Gedalia:39": {
   "kind": "instruction",
   "en": "The congregation answers Amen and joins in the next sentence:",
   "role": "congregation",
   "minyan": true,
   "node": "kaddish.half"
  },
  "he:Festivals/Selichot/Fast of Gedalia:40": {
   "kind": "prayer",
   "node": "kaddish.half",
   "role": "congregation",
   "minyan": true
  },
  "he:Festivals/Selichot/Fast of Gedalia:41": {
   "parts": [
    {
     "kind": "prayer",
     "node": "kaddish.half",
     "role": "chazzan",
     "voice": "aloud",
     "minyan": true,
     "text": "יִתְבָּרַךְ   וְיִשְׁתַּבַּח וְיִתְפָּאַר וְיִתְרוֹמַם וְיִתְנַשֵּׂא וְיִתְהַדָּר וְיִתְעַלֶּה וְיִתְהַלָּל , שְׁמֵהּ דְּקוּדְשָׁא בְּרִיךְ הוּא "
    },
    {
     "kind": "speaker",
     "en": "The congregation responds:",
     "role": "congregation",
     "minyan": true,
     "node": "kaddish.half",
     "text": "<br> ועונים: "
    },
    {
     "kind": "prayer",
     "node": "kaddish.half",
     "role": "congregation",
     "minyan": true,
     "text": "בְּרִיךְ הוּא <br>"
    }
   ]
  },
  "he:Festivals/Selichot/Fast of Gedalia:42": {
   "parts": [
    {
     "kind": "prayer",
     "node": "kaddish.half",
     "role": "chazzan",
     "voice": "aloud",
     "minyan": true,
     "when": "!aseretYemeiTeshuva",
     "alt": "leila",
     "text": "לְעֵילָא "
    },
    {
     "kind": "instruction",
     "en": "During the Ten Days of Repentance:",
     "when": "aseretYemeiTeshuva",
     "node": "kaddish.half",
     "text": "<em><small>בעשרת ימי תשובה: "
    },
    {
     "kind": "prayer",
     "node": "kaddish.half",
     "role": "chazzan",
     "voice": "aloud",
     "minyan": true,
     "when": "aseretYemeiTeshuva",
     "alt": "leila",
     "text": "וּלְעֵילָא מִכָּל</small></em> "
    },
    {
     "kind": "prayer",
     "node": "kaddish.half",
     "role": "chazzan",
     "voice": "aloud",
     "minyan": true,
     "when": "!aseretYemeiTeshuva",
     "text": "מִן כָּל "
    },
    {
     "kind": "prayer",
     "node": "kaddish.half",
     "role": "chazzan",
     "voice": "aloud",
     "minyan": true,
     "text": "בִּרְכָתָא וְשִׁירָתָא, תֻּשְׁבְּחָתָא וְנֶחָמָתָא, דַאֲמִירָן בְּעָלְמָא. וְאִמְרוּ אָמֵן:"
    }
   ]
  },
