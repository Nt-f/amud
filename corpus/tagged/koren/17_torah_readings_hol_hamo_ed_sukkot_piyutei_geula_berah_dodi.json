  "en:Torah Readings/Simhat Torah:2": {
   "parts": [
    {
     "text": "<i class=\"instruction\">In Israel, if Simḥat Torah falls on Shabbat, the first three verses of the reading for the ḥatan Torah </i>",
     "kind": "instruction"
    },
    {
     "text": "(",
     "kind": "prayer"
    },
    {
     "text": "<i class=\"instruction\"> page </i>",
     "kind": "instruction"
    },
    {
     "text": "1162",
     "kind": "prayer"
    },
    {
     "text": "<i class=\"instruction\">b</i>",
     "kind": "instruction"
    },
    {
     "text": ")",
     "kind": "prayer"
    },
    {
     "text": "<i class=\"instruction\">, from </i>",
     "kind": "instruction"
    },
    {
     "text": "“",
     "kind": "prayer"
    },
    {
     "text": "<i class=\"instruction\">Your sanctuary</i>",
     "kind": "instruction"
    },
    {
     "text": "”",
     "kind": "prayer"
    },
    {
     "text": "<i class=\"instruction\"> through </i>",
     "kind": "instruction"
    },
    {
     "text": "“",
     "kind": "prayer"
    },
    {
     "text": "<i class=\"instruction\">their high places,</i>",
     "kind": "instruction"
    },
    {
     "text": "”",
     "kind": "prayer"
    },
    {
     "text": "<i class=\"instruction\"> are read for Shishi</i>",
     "kind": "instruction"
    },
    {
     "text": ".",
     "kind": "prayer"
    }
   ],
