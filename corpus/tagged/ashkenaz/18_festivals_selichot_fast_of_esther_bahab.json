    {
     "kind": "prayer",
     "node": "x.selichot.piyyut",
     "text": "בִּהְיוֹת מִזְבְּחִי וּמִקְדָּשִׁי עַל מְכוֹנוֹ וּגְבוּלוֹ, הָיוּ מְכַפְּרִים עָלֵינוּ בִּשְׂעִירִים הָעוֹלִים לְגוֹרָלוֹ, וְעַתָּה בְּאַשְׁמָתֵנוּ לוּ חָפֵץ יְהֹוָה לַהֲמִיתֵנוּ: ",
     "role": "chazzan"
    }
