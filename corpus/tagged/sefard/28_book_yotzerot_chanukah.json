  "he:Yotzerot/Shabbat HaGadol:47": {
   "parts": [
    {
     "text": "<b>אֵין</b> עֲרוֹךְ אֵלֶיךָ לְהַגִּיד וּלְדַבֵּר. חֵקֶר פִּלְאֵי נִסֶּיךָ לְהָבִין וּלְסַבֵּר ",
     "kind": "prayer",
