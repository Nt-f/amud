  "he:Yotzerot/Musaf for Hachodesh:53": {
   "parts": [
    {
     "text": "<b>שִׂים שָׁלוֹם</b> טוֹבָה וּבְרָכָה,",
     "kind": "prayer",
     "node": "amidah.birkat_kohanim",
     "role": "chazzan",
     "voice": "aloud",
     "minyan": true,
     "gestures": [
