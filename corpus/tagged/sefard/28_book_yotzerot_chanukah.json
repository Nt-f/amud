     "kind": "prayer"
    }
   ]
  },
  "he:Chanukah/Menorah Lighting:32": {
   "parts": [
    {
     "text": "<b><b>חֲסִין קָדוֹשׁ בְּרוֹב טוּבְךָ נַהֵל עֲדָתֶךָ. ",
     "kind": "prayer"
    },
    {
     "text": "<small>חק\"ב טנ\"ע</small>",
     "kind": "instruction",
     "en": "Hk\"B Tn\"E"
    },
    {
     "text": ":</b></b>",
     "kind": "prayer"
    }
   ]
  },
  "he:Chanukah/Menorah Lighting:33": {
   "parts": [
    {
     "text": "<b><b>יָחִיד גֵּאֶה לְעַמְּךָ פְּנֵה זוֹכְרֵי קְדֻשָּׁתֶךָ. ",
     "kind": "prayer"
    },
    {
     "text": "<small>יג\"ל פז\"ק</small>",
     "kind": "instruction",
     "en": "Yg\"L Pz\"K"
    },
    {
     "text": ":</b></b>",
     "kind": "prayer"
    }
   ]
  },
  "he:Chanukah/Menorah Lighting:34": {
   "parts": [
    {
     "text": "<b><b>שַׁוְעָתֵנוּ קַבֵּל וּשְׁמַע צַעֲקָתֵנוּ יוֹדֵעַ תַּעֲלוּמוֹת. ",
     "kind": "prayer"
    },
    {
     "text": "<small>שק\"ו צי\"ת</small>",
     "kind": "instruction",
     "en": "ShK\"V TzY\"T"
    },
    {
     "text": ":</b></b>",
     "kind": "prayer"
    }
   ]
  },
  "he:Chanukah/Menorah Lighting:35": {
   "parts": [
    {
     "text": "<b><b><small>בלחש:</small>",
     "kind": "instruction",
     "en": "Whisper:"
    },
    {
     "text": " בָּרוּךְ שֵׁם כְּבוֹד מַלְכוּתוֹ לְעוֹלָם וָעֶד:</b></b>",
