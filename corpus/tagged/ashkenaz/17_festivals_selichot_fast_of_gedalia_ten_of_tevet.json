  "he:Festivals/Selichot/Fast of Gedalia:256": {
   "parts": [
    {
     "kind": "prayer",
     "node": "tachanun.yud_gimmel_middot",
     "role": "chazzan_then_congregation",
     "minyan": true,
     "text": "וְסָלַחְתָּ לַעֲו‍ֹנֵנוּ וּלְחַטָּאתֵנוּ וּנְחַלְתָּנוּ. <em><small>שמות לד, ט</small></em>    "
    },
    {
     "kind": "prayer",
     "node": "selichot.fast_day",
     "text": "סְלַח לָנוּ אָבִינוּ כִּי חָטָאנוּ, מְחַל לָנוּ מַלְכֵּנוּ כִּי פָשַׁעְנוּ. <em><small>מתוך תפילת שמונה עשרה</small></em>    כִּי אַתָּה אֲדֹנָי טוֹב וְסַלָּח וְרַב חֶסֶד לְכָל קֹרְאֶיךָ. <em><small>תהלים פו, ה</small></em>"
    }
   ]
  },
  "he:Festivals/Selichot/Fast of Gedalia:299": {
   "parts": [
    {
     "kind": "prayer",
     "node": "tachanun.yud_gimmel_middot",
     "role": "chazzan_then_congregation",
     "minyan": true,
     "text": "וְסָלַחְתָּ לַעֲו‍ֹנֵנוּ וּלְחַטָּאתֵנוּ וּנְחַלְתָּנוּ. <em><small>שמות לד, ט</small></em>    "
    },
    {
     "kind": "prayer",
     "node": "selichot.fast_day",
     "text": "סְלַח לָנוּ אָבִינוּ כִּי חָטָאנוּ, מְחַל לָנוּ מַלְכֵּנוּ כִּי פָשַׁעְנוּ. <em><small>מתוך תפילת שמונה עשרה</small></em>    כִּי אַתָּה אֲדֹנָי טוֹב וְסַלָּח וְרַב חֶסֶד לְכָל קֹרְאֶיךָ. <em><small>תהלים פו, ה</small></em>"
