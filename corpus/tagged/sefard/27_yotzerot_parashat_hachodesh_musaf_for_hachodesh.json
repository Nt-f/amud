  "he:Yotzerot/Parashat HaChodesh:58": {
   "kind": "heading",
   "en": "Priestly Blessing",
   "gloss": "Heading for Birkat Kohanim"
  },
  "he:Yotzerot/Parashat HaChodesh:59": {
   "parts": [
    {
     "text": "<b>שִׂים שָׁלוֹם</b> טוֹבָה וּבְרָכָה,",
     "kind": "prayer",
     "node": "amidah.birkat_kohanim",
     "role": "chazzan",
     "voice": "aloud",
     "minyan": true,
     "gloss": "Chazzan says this when no kohanim are duchening"
    },
    {
     "text": " חַיִּים,",
     "kind": "prayer",
     "node": "amidah.birkat_kohanim",
     "role": "chazzan",
     "voice": "aloud",
     "minyan": true,
     "gloss": "Chazzan says this when no kohanim are duchening"
    },
    {
     "text": " חֵן וָחֶסֶד,",
     "kind": "prayer",
     "node": "amidah.birkat_kohanim",
     "role": "chazzan",
     "voice": "aloud",
     "minyan": true,
     "gloss": "Chazzan says this when no kohanim are duchening"
    },
    {
     "text": " וְרַחֲמִים,",
     "kind": "prayer",
     "node": "amidah.birkat_kohanim",
     "role": "chazzan",
     "voice": "aloud",
     "minyan": true,
     "gloss": "Chazzan says this when no kohanim are duchening"
    },
    {
     "text": " עָלֵינוּ וְעַל כָּל יִשְׂרָאֵל עַמֶּךָ. בָּרְכֵנוּ אָבִינוּ,",
     "kind": "prayer",
     "node": "amidah.birkat_kohanim",
     "role": "chazzan",
     "voice": "aloud",
     "minyan": true,
     "gloss": "Chazzan says this when no kohanim are duchening"
    },
    {
     "text": " כֻּלָּנוּ כְּאֶחָד ",
     "kind": "prayer",
     "node": "amidah.birkat_kohanim",
     "role": "chazzan",
     "voice": "aloud",
     "minyan": true,
     "gloss": "Chazzan says this when no kohanim are duchening"
    },
    {
     "text": "<small>(יַחַד)</small>",
     "kind": "prayer",
     "node": "amidah.birkat_kohanim",
     "role": "chazzan",
     "voice": "aloud",
     "minyan": true,
     "gloss": "Chazzan says this when no kohanim are duchening"
    },
    {
     "text": " בְּאוֹר פָּנֶיךָ,",
     "kind": "prayer",
     "node": "amidah.birkat_kohanim",
     "role": "chazzan",
     "voice": "aloud",
     "minyan": true,
     "gloss": "Chazzan says this when no kohanim are duchening"
    },
    {
     "text": " כִּי בְאוֹר פָּנֶיךָ נָתַתָּ לָּנוּ יְהֹוָה אֱלֹהֵינוּ,",
     "kind": "prayer",
     "node": "amidah.birkat_kohanim",
     "role": "chazzan",
     "voice": "aloud",
     "minyan": true,
     "gloss": "Chazzan says this when no kohanim are duchening"
    },
    {
     "text": " תּוֹרַת חַיִּים,",
     "kind": "prayer",
     "node": "amidah.birkat_kohanim",
     "role": "chazzan",
     "voice": "aloud",
     "minyan": true,
     "gloss": "Chazzan says this when no kohanim are duchening"
    },
    {
     "text": " וְאַהֲבַת חֶסֶד,",
     "kind": "prayer",
     "node": "amidah.birkat_kohanim",
     "role": "chazzan",
     "voice": "aloud",
     "minyan": true,
     "gloss": "Chazzan says this when no kohanim are duchening"
    },
    {
     "text": " וּצְדָקָה וּבְרָכָה וְרַחֲמִים,",
     "kind": "prayer",
     "node": "amidah.birkat_kohanim",
     "role": "chazzan",
     "voice": "aloud",
     "minyan": true,
     "gloss": "Chazzan says this when no kohanim are duchening"
    },
    {
     "text": " וְחַיִּים וְשָׁלוֹם. ",
     "kind": "prayer",
     "node": "amidah.birkat_kohanim",
     "role": "chazzan",
     "voice": "aloud",
     "minyan": true,
     "gloss": "Chazzan says this when no kohanim are duchening"
    },
    {
     "text": "<small>(וְכָל טוּב)</small>",
     "kind": "prayer",
     "node": "amidah.birkat_kohanim",
     "role": "chazzan",
     "voice": "aloud",
     "minyan": true,
     "gloss": "Chazzan says this when no kohanim are duchening"
    },
    {
     "text": " וְטוֹב יִהְיֶה בְּעֵינֶיךָ לְבָרְכֵנוּ וּלְבָרֵךְ אֶת כָּל עַמְּךָ יִשְׂרָאֵל בְּכָל עֵת וּבְכָל שָׁעָה בִּשְׁלוֹמֶךָ,",
     "kind": "prayer",
     "node": "amidah.birkat_kohanim",
     "role": "chazzan",
     "voice": "aloud",
     "minyan": true,
     "gloss": "Chazzan says this when no kohanim are duchening"
    },
    {
     "text": " בְּרֹב עֹז וְשָׁלוֹם. ",
     "kind": "prayer",
     "node": "amidah.birkat_kohanim",
     "role": "chazzan",
     "voice": "aloud",
     "minyan": true,
     "gloss": "Chazzan says this when no kohanim are duchening"
    }
   ]
  },
