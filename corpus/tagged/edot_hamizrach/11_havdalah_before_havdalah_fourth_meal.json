  "he:Havdalah/Before Havdalah:3": {
   "kind": "prayer"
  },
  "he:Havdalah/Before Havdalah:4": {
   "parts": [
    {
     "text": "<b>אִישׁ</b> אִישׁ אֲשֶׁר קִנֵּא לְשֵׁם הָאֵל ",
     "kind": "prayer"
    },
    {
     "text": "<small>אֵלִֽיָּהוּ הַנָּבִיא</small>",
     "kind": "prayer"
    },
    {
     "text": ",",
     "kind": "prayer"
    },
    {
     "text": " אִישׁ בֻּשַּׂר שָׁלוֹם עַל יַד יְקוּתִיאֵל ",
     "kind": "prayer"
    },
    {
     "text": "<small>אֵלִֽיָּהוּ הַנָּבִיא</small>",
     "kind": "prayer"
    },
    {
     "text": ",",
     "kind": "prayer"
    },
    {
     "text": " אִישׁ גָּשׁ וַיְכַפֵּר עַל בְּנֵי יִשְׂרָאֵל. ",
     "kind": "prayer"
    },
    {
     "text": "<small>אֵלִֽיָּהוּ הַנָּבִיא זָכוּר לְטוֹב</small>",
     "kind": "prayer"
    },
    {
     "text": ":",
     "kind": "prayer"
    }
   ]
  },
  "he:Havdalah/Before Havdalah:5": {
   "parts": [
    {
     "text": "<b>אִישׁ</b> דּוֹרוֹת שְׁנֵים עָשָׂר רָאוּ עֵינָיו ",
     "kind": "prayer"
    },
    {
     "text": "<small>אֵלִֽיָּהוּ הַנָּבִיא</small>",
     "kind": "prayer"
    },
    {
     "text": ",",
     "kind": "prayer"
    },
    {
     "text": " אִישׁ הַנִּקְרָא בַּֽעַל שֵׂעָר בְּסִימָּנָיו ",
     "kind": "prayer"
    },
    {
     "text": "<small>אֵלִֽיָּהוּ הַנָּבִיא</small>",
     "kind": "prayer"
    },
    {
     "text": ",",
     "kind": "prayer"
    },
    {
     "text": " אִישׁ וְאֵזוֹר עוֹר אָזוּר בְּמָתְנָיו. ",
     "kind": "prayer"
    },
    {
     "text": "<small>אֵלִֽיָּהוּ הַנָּבִיא זָכוּר לְטוֹב</small>",
     "kind": "prayer"
    },
    {
     "text": ":",
     "kind": "prayer"
    }
   ]
  },
  "he:Havdalah/Before Havdalah:6": {
   "parts": [
    {
     "text": "<b>אִישׁ</b> זָעַף עַל עֽוֹבְדֵֽי חַמָּנִים ",
