{
  "book": "Siddur Ashkenaz",
  "chunk": "Shabbat/Daytime Meal [Kiddusha Rabba .. Zemirot for Second Meal]",
  "leaves": [
    {
      "path": "Shabbat/Daytime Meal/Kiddusha Rabba",
      "title": "קידושא רבה",
      "node": "shabbat.kiddush_day",
      "service": "none",
      "he": {
        "version": "Daat Siddur Ashkenaz",
        "segs": [
          {"ref": "1", "kind": "prayer", "role": "head_of_household", "text": "ושמרו בני ישראל את השבת, לעשות את השבת לדורותם ברית עולם. ביני ובין בני ישראל אות היא לעולם. כי ששת ימים עשה ה' את השמים ואת הארץ, וביום השביעי שבת וינפש."},
          {"ref": "3", "kind": "prayer", "role": "head_of_household", "text": "זכור את יום השבת לקדשו. ששת ימים תעבוד ועשית כל מלאכתך, וביום השביעי שבת לה' אלהיך, לא תעשה כל מלאכה, אתה ובנך ובתך, ועבדך ואמתך ובהמתך, וגרך אשר בשעריך. כי ששת ימים עשה ה' את השמים ואת הארץ, את הים ואת כל אשר בם, וינח ביום השביעי, על כן בירך ה' את יום השבת ויקדשהו."},
          {"ref": "5", "kind": "prayer", "role": "head_of_household", "gestures": ["hold_cup"], "text": "ברוך אתה ה' אלהינו מלך העולם בורא פרי הגפן."}
        ]
      }
    },
    {
      "path": "Shabbat/Daytime Meal/Zemirot for Second Meal/Baruch Kel Elyon",
      "title": "ברוך אל עליון",
      "node": "x.zemirot.baruch_kel_elyon",
      "service": "none",
      "he": {
        "version": "Daat Siddur Ashkenaz",
        "segs": [
          {"ref": "1", "kind": "prayer", "text": "בָּרוּךְ אֵל עֶלְיוֹן <br> אֲשֶׁר נָתַן מְנוּחָה"},
          {"ref": "3", "kind": "prayer", "text": "לְנַפְשֵׁנוּ פִּדְיוֹן <br> מִשְּׁאֵת וַאֲנָחָה"},
          {"ref": "5", "kind": "prayer", "text": "וְהוּא יִדְרשׁ לְצִיּוֹן <br> עִיר הַנִּדָּחָה"},
          {"ref": "7", "kind": "prayer", "text": "עַד-אָנָה תּוּגְיוֹן <br> נֶפֶשׁ נֶאֱנָחָה"},
          {"ref": "9", "kind": "prayer", "text": "הַשּׁוֹמֵר שַׁבָּת <br> הַבֵּן עִם הַבַּת<br> לָאֵל יֵרָצוּ <br> כְּמִנְחָה עַל-מַחֲבַת"},
          {"ref": "13", "kind": "prayer", "text": "רוֹכֵב בָּעֲרָבוֹת <br> מֶלֶךְ עוֹלָמִים"},
          {"ref": "15", "kind": "prayer", "text": "אֶת-עַמוֹ לִשְׁבֹּת <br> אִזֵּן בַּנְּעִימִים"},
          {"ref": "17", "kind": "prayer", "text": "בְּמַאֲכָלוֹת עֲרֵבוֹת <br> בְּמִינֵי מַטְעַמִים"},
          {"ref": "19", "kind": "prayer", "text": "בְּמַלְבּוּשֵׁי כָבוֹד <br> זֶבַח מִשְׁפָּחָה"},
          {"ref": "21", "kind": "prayer", "text": "הַשּׁוֹמֵר שַׁבָּת <br> הַבֵּן עִם הַבַּת <br>לָאֵל יֵרָצוּ <br> כְּמִנְחָה עַל-מַחֲבַת"},
          {"ref": "25", "kind": "prayer", "text": "וְאַשְׁרֵי כָּל-חוֹכֶה <br> לְתַשְׁלוּמֵי כֵפֶל"},
          {"ref": "27", "kind": "prayer", "text": "מֵאֵת כָּל סוֹכֶה <br> שׁוֹכֵן בָּעֲרָפֶל"},
          {"ref": "29", "kind": "prayer", "text": "נַחֲלָה לוֹ יִזְכֶּה <br> בָּהָר וּבַשָׁפֶל"},
          {"ref": "31", "kind": "prayer", "text": "נַחֲלָה וּמְנוּחָה <br> כַּשֶׁמֶשׁ לוֹ זָרְחָה"},
          {"ref": "33", "kind": "prayer", "text": "הַשּׁוֹמֵר שַׁבָּת <br> הַבֵּן עִם הַבַּת <br>לָאֵל יֵרָצוּ <br> כְּמִנְחָה עַל-מַחֲבַת"},
          {"ref": "37", "kind": "prayer", "text": "כָּל-שׁוֹמֵר שַׁבָּת <br> כַּדָּת מֵחֲלָלוֹ"},
          {"ref": "39", "kind": "prayer", "text": "הֵן הַכְשֶׁר חִבַּת <br> קֹדֶשׁ גּוֹרָלוֹ"},
          {"ref": "41", "kind": "prayer", "text": "וְאִם יֵצֵא חוֹבַת <br> הַיּוֹם אַשְׁרֵי לוֹ"},
          {"ref": "43", "kind": "prayer", "text": "לְאֵל אָדוֹן מְחוֹלְלוֹ <br> מִנְחָה הִיא שְׁלוּחָה"},
          {"ref": "45", "kind": "prayer", "text": "הַשּׁוֹמֵר שַׁבָּת <br> הַבֵּן עִם הַבַּת <br>לָאֵל יֵרָצוּ <br> כְּמִנְחָה עַל-מַחֲבַת"},
          {"ref": "49", "kind": "prayer", "text": "חֶמְדַּת הַיָּמִים <br> קְרָאוֹ אֵלִי צוּר"},
          {"ref": "51", "kind": "prayer", "text": "וְאַשְׁרֵי לִתְמִימִים <br> אִם-יִהְיֶה נָצוּר"},
          {"ref": "53", "kind": "prayer", "text": "כֶּתֶר הִלּוֹמִים <br> עַל-רֹאשָׁם יָצוּר"},
          {"ref": "55", "kind": "prayer", "text": "צוּר הָעוֹלָמִים <br> רוּחוֹ בָּם נָחָה"},
          {"ref": "57", "kind": "prayer", "text": "הַשּׁוֹמֵר שַׁבָּת <br> הַבֵּן עִם הַבַּת <br>לָאֵל יֵרָצוּ <br> כְּמִנְחָה עַל-מַחֲבַת"},
          {"ref": "61", "kind": "prayer", "text": "זָכוֹר אֶת-יוֹם הַ<br>שַׁבָּת לְקַדְּשׁוֹ"},
          {"ref": "63", "kind": "prayer", "text": "קַרְנוֹ כִּי גָּבְהָה <br> נֵזֶר עַל-רֹאשׁוֹ"},
          {"ref": "65", "kind": "prayer", "text": "עַל-כֵּן יִתֵּן הָ<br>אָדָם לְנַפְשׁוֹ"},
          {"ref": "67", "kind": "prayer", "text": "עֹנֶג וְגַם-שִׂמְחָה <br> בָּהֶם לוֹ לְמָשְׁחָה"},
          {"ref": "69", "kind": "prayer", "text": "הַשּׁוֹמֵר שַׁבָּת <br> הַבֵּן עִם הַבַּת <br>לָאֵל יֵרָצוּ <br> כְּמִנְחָה עַל-מַחֲבַת"},
          {"ref": "73", "kind": "prayer", "text": "קֹדֶשׁ הִיא לָכֶם <br> שַׁבָּת הַמַּלְכָּה"},
          {"ref": "75", "kind": "prayer", "text": "אֶל-תּוֹךְ בָּתֵּיכֶם <br> לְהָנִיחַ בְּרָכָה"},
          {"ref": "77", "kind": "prayer", "text": "בְּכָל-מוֹשְׁבוֹתֵיכֶם <br> לֹא תַּעֲשׂוּ מְלָאכָה"},
          {"ref": "79", "kind": "prayer", "text": "בְּנֵיכֶם וּבְנוֹתֵיכֶם <br> עֶבֶד וְגַם-שִׁפְחָה"},
          {"ref": "81", "kind": "prayer", "text": "הַשּׁוֹמֵר שַׁבָּת <br> הַבֵּן עִם הַבַּת <br>לָאֵל יֵרָצוּ <br> כְּמִנְחָה עַל-מַחֲבַת"},
          {"ref": "83", "kind": "commentary", "en": "Author: R. Baruch bar Shmuel of Mainz", "text": "מחבר: ר' ברוך בר שמואל ממגנצא"}
        ]
      }
    },
    {
      "path": "Shabbat/Daytime Meal/Zemirot for Second Meal/Yom Zeh Mechubad",
      "title": "יום זה מכובד",
      "node": "x.zemirot.yom_zeh_mechubad",
      "service": "none",
      "he": {
        "version": "Daat Siddur Ashkenaz",
        "segs": [
          {"ref": "1", "kind": "prayer", "text": "יוֹם זֶה מְכֻבָּד מִכָּל יָמִים, כִּי בוֹ שָׁבַת צוּר עוֹלָמִים:"},
          {"ref": "4", "kind": "prayer", "text": "שֵׁשֶׁת יָמִים תַּעֲשֶׂה מְלַאכְתֶּךָ,"},
          {"ref": "6", "kind": "prayer", "text": "וְיוֹם הַשְּׁבִיעִי לֵאלֹהֶיךָ,"},
          {"ref": "8", "kind": "prayer", "text": "שַׁבָּת לֹא תַעֲשֶׂה בוֹ מְלָאכָה,"},
          {"ref": "10", "kind": "prayer", "text": "כִּי כֹל עָשָׂה שֵׁשֶׁת יָמִים."},
          {"ref": "13", "kind": "prayer", "text": "יוֹם זֶה מְכֻבַּד מִכָּל יָמִים, כִּי בוֹ שָׁבַת צוּר עוֹלָמִים:"},
          {"ref": "17", "kind": "prayer", "text": "רִאשׁוֹן הוּא לְמִקְרָאֵי קֹדֶשׁ,"},
          {"ref": "19", "kind": "prayer", "text": "יוֹם שַׁבָּתוֹן יוֹם שַׁבָּת קֹדֶשׁ,"},
          {"ref": "21", "kind": "prayer", "text": "עַל כֵּן כָּל אִישׁ בְּיֵינוֹ יְקַדֵּשׁ,"},
          {"ref": "23", "kind": "prayer", "text": "עַל שְׁתֵּי לֶחֶם יִבְצְעוּ תְמִימִים."},
          {"ref": "26", "kind": "prayer", "text": "יוֹם זֶה מְכֻבָּד מִכָּל יָמִים, כִּי בוֹ שָׁבַת צוּר עוֹלָמִים:"},
          {"ref": "29", "kind": "prayer", "text": "אֱכוֹל מַשְׁמַנִּים שְׁתֵה מַמְתַּקִּים,"},
          {"ref": "31", "kind": "prayer", "text": "כִּי אֵל יִתֵּן לְכֹל בּוֹ דְּבֵקִים,"},
          {"ref": "33", "kind": "prayer", "text": "בֶּגֶד לִלְבֹּשׁ, לֶחֶם חֻקִּים,"},
          {"ref": "35", "kind": "prayer", "text": "בָּשָׂר וְדָגִים וְכָל מַטְעַמִּים."},
          {"ref": "38", "kind": "prayer", "text": "יוֹם זֶה מְכֻבַּד מִכָּל יָמִים, כִּי בוֹ שָׁבַת צוּר עוֹלָמִים:"},
          {"ref": "42", "parts": [
            {"kind": "prayer", "text": "לֹא תְחַסַּר "},
            {"kind": "note", "en": "Alternate reading: תֶחְסַר", "text": "<em><small>נ\"א: תֶחְסַר</small></em>"},
            {"kind": "prayer", "text": " כֹּל בּוֹ וְאָכַלְתָּ,"}
          ]},
          {"ref": "44", "kind": "prayer", "text": "וְשָּׂבָעְתָּ וּבֵרַכְתָּ"},
          {"ref": "46", "kind": "prayer", "text": "אֶת ה' אֱלֹהֶיךָ אֲשֶׁר אָהַבְתָּ,"},
          {"ref": "48", "kind": "prayer", "text": "כִּי בֵרַכְךָ מִכָּל הָעַמִּים."},
          {"ref": "51", "kind": "prayer", "text": "יוֹם זֶה מְכֻבַּד מִכָּל יָמִים, כִּי בוֹ שָׁבַת צוּר עוֹלָמִים:"},
          {"ref": "54", "kind": "prayer", "text": "הַשָּׁמַיִם מְסַפְּרִים כְּבוֹדוֹ,"},
          {"ref": "56", "kind": "prayer", "text": "וְגַם הָאָרֶץ מָלְאָה חַסְדּוֹ,"},
          {"ref": "58", "kind": "prayer", "text": "רְאוּ כִּי כָל אֵלֶּה עָשְׂתָה יָדוֹ,"},
          {"ref": "60", "kind": "prayer", "text": "כִּי הוּא הַצּוּר, פָּעֳלוֹ תָמִים."},
          {"ref": "63", "kind": "prayer", "text": "יוֹם זֶה מְכֻבָּד מִכָּל יָמִים, כִּי בוֹ שָׁבַת צוּר עוֹלָמִים:"},
          {"ref": "67", "kind": "commentary", "en": "Author: R. Israel the Convert, a righteous convert of the 12th century", "text": "מחבר: ר' ישראל הגֵר, גר צדק מהמאה ה-12"}
        ]
      },
      "en": {
        "version": "Sefaria Community Translation",
        "segs": [
          {"ref": "1", "translates": ["1"], "text": "This day is glorified above all days, for on it did rest the Rock of Ages."},
          {"ref": "4", "translates": ["4"], "text": "Six days do your work,"},
          {"ref": "6", "translates": ["6"], "text": "And the Seventh Day is for your god."},
          {"ref": "8", "translates": ["8"], "text": "On the Sabbath do not do work,"},
          {"ref": "10", "translates": ["10"], "text": "For all was made in the six days."},
          {"ref": "13", "translates": ["13"], "text": "This day is glorified above all days, for on it did rest the Rock of Ages."},
          {"ref": "17", "translates": ["17"], "text": "First is it to the holy readings,"},
          {"ref": "19", "translates": ["19"], "text": "A day of Shabbaton, the holy Sabbath day!"},
          {"ref": "21", "translates": ["21"], "text": "Therefore all people with their wine sanctify it"},
          {"ref": "23", "translates": ["23"], "text": "over two loaves the pure ones cut."},
          {"ref": "26", "translates": ["26"], "text": "This day is glorified above all days, for on it did rest the Rock of Ages."},
          {"ref": "29", "translates": ["29"], "text": "Eat fats, drink sweets,"},
          {"ref": "31", "translates": ["31"], "text": "For god will give to all who grasp him,"},
          {"ref": "33", "translates": ["33"], "text": "clothing to wear, bread of the laws,"},
          {"ref": "35", "translates": ["35"], "text": "meat and fish and all delicacies."},
          {"ref": "38", "translates": ["38"], "text": "This day is glorified above all days, for on it did rest the Rock of Ages."},
          {"ref": "42", "translates": ["42"], "text": "Do not deny yourself anything on it, and eat"},
          {"ref": "44", "translates": ["44"], "text": "and be satisfied and bless"},
          {"ref": "46", "translates": ["46"], "text": "the LORD your god which you love"},
          {"ref": "48", "translates": ["48"], "text": "for he has blessed you above all other nations."},
          {"ref": "51", "translates": ["51"], "text": "This day is glorified above all days, for on it did rest the Rock of Ages."},
          {"ref": "54", "translates": ["54"], "text": "The heavens tell his glory,"},
          {"ref": "56", "translates": ["56"], "text": "and also the land is filled with his charity"},
          {"ref": "58", "translates": ["58"], "text": "See that all this his hand made,"},
          {"ref": "60", "translates": ["60"], "text": "for he is the Rock, his act is perfect."},
          {"ref": "63", "translates": ["63"], "text": "This day is glorified above all days, for on it did rest the Rock of Ages."},
          {"ref": "67", "translates": ["67"], "text": "Author: R. Israel the 12th-century convert."}
        ]
      }
    },
    {
      "path": "Shabbat/Daytime Meal/Zemirot for Second Meal/Yom Shabbaton",
      "title": "יום שבתון",
      "node": "x.zemirot.yom_shabbaton",
      "service": "none",
      "he": {
        "version": "Daat Siddur Ashkenaz",
        "segs": [
          {"ref": "1", "kind": "prayer", "text": "יוֹם שַׁבָּתוֹן אֵין לִשְׁכֹּחַ"},
          {"ref": "3", "kind": "prayer", "text": "זִכְרוֹ כְּרֵיחַ הַנִּיחוֹחַ"},
          {"ref": "5", "kind": "prayer", "text": "יוֹנָה מָצְאָה בוֹ מָנוֹחַ"},
          {"ref": "7", "kind": "prayer", "text": "וְשָׁם יָנוּחוּ יְגִיעֵי כֹחַ"},
          {"ref": "9", "kind": "prayer", "text": "יוֹנָה מָצְאָה בוֹ מָנוֹחַ וְשָׁם יָנוּחוּ יְגִיעֵי כֹחַ"},
          {"ref": "11", "kind": "prayer", "text": "הַיּוֹם נִכְבָּד לִבְנֵי אֱמוּנִים"},
          {"ref": "13", "kind": "prayer", "text": "זְהִירִים לְשָׁמְרוֹ אָבוֹת וּבָנִים"},
          {"ref": "15", "kind": "prayer", "text": "חָקוּק בִּשְׁנֵי לֻחוֹת אֲבָנִים"},
          {"ref": "17", "kind": "prayer", "text": "מֵרֹב אוֹנִים וְאַמִּיץ כֹּחַ"},
          {"ref": "19", "kind": "prayer", "text": "יוֹנָה מָצְאָה בוֹ מָנוֹחַ וְשָׁם יָנוּחוּ יְגִיעֵי כֹחַ"},
          {"ref": "21", "kind": "prayer", "text": "וּבָאוּ כֻלָּם בִּבְרִית יַחַד"},
          {"ref": "23", "kind": "prayer", "text": "נַעֲשֶׂה וְנִשְׁמַע אָמְרוּ כְּאֶחָד"},
          {"ref": "25", "kind": "prayer", "text": "וּפָתְחוּ וְעָנוּ יְיָ אֶחָד"},
          {"ref": "27", "kind": "prayer", "text": "בָּרוּךְ הַנּוֹתֵן לַיָּעֵף כֹּחַ"},
          {"ref": "29", "kind": "prayer", "text": "יוֹנָה מָצְאָה בוֹ מָנוֹחַ וְשָׁם יָנוּחוּ יְגִיעֵי כֹחַ"},
          {"ref": "31", "kind": "prayer", "text": "דִּבֵּר בְּקָדְשׁוֹ בְּהַר הַמֹּר"},
          {"ref": "33", "kind": "prayer", "text": "יוֹם הַשְּׁבִיעִי זָכוֹר וְשָׁמוֹר"},
          {"ref": "35", "kind": "prayer", "text": "וְכָל פִּקּוּדָיו יַחַד לִגְמֹר"},
          {"ref": "37", "kind": "prayer", "text": "חַזֵּק מָתְנַיִם וְאַמֵּץ כֹּחַ"},
          {"ref": "39", "kind": "prayer", "text": "יוֹנָה מָצְאָה בוֹ מָנוֹחַ וְשָׁם יָנוּחוּ יְגִיעֵי כֹחַ"},
          {"ref": "41", "kind": "prayer", "text": "הָעָם אֲשֶׁר נָע כַּצֹּאן תָּעָה"},
          {"ref": "43", "kind": "prayer", "text": "יִזְכּוֹר לְפָקְדוֹ בִּבְרִית וּשְׁבוּעָה"},
          {"ref": "45", "kind": "prayer", "text": "לְבַל יַעֲבֹר בָּם מִקְרֵי רָעָה"},
          {"ref": "47", "kind": "prayer", "text": "כַּאֲשֶׁר נִשְׁבַּעְתָּ עַל מֵי נֹחַ"},
          {"ref": "49", "kind": "prayer", "text": "יוֹנָה מָצְאָה בוֹ מָנוֹחַ וְשָׁם יָנוּחוּ יְגִיעֵי כֹחַ"},
          {"ref": "51", "kind": "commentary", "en": "Author: R. Yehuda HaLevi", "text": "מחבר: ר' יהודה הלוי"}
        ]
      }
    },
    {
      "path": "Shabbat/Daytime Meal/Zemirot for Second Meal/Shimru Shabtotai",
      "title": "שמרו שבתותי",
      "node": "x.zemirot.shimru_shabtotai",
      "service": "none",
      "he": {
        "version": "Daat Siddur Ashkenaz",
        "segs": [
          {"ref": "1", "kind": "prayer", "text": "שִׁמְרוּ שַׁבְּתוֹתַי,"},
          {"ref": "2", "kind": "prayer", "text": "לְמַעַן תִּינְקוּ וּשְׂבַעְתֶּם מִזִּיו בִּרְכוֹתַי,"},
          {"ref": "3", "kind": "prayer", "text": "אֶל הַמְּנוּחָה כִּי בָּאתֶם,"},
          {"ref": "4", "kind": "prayer", "text": "וְלְּווּ עָלַי בָּנַי וְעִדְּנוּ מַעֲדַנַי,"},
          {"ref": "5", "kind": "prayer", "text": "שַׁבָּת הַיּוֹם לה':"},
          {"ref": "7", "kind": "prayer", "text": "לֶעָמֵל קִרְאוּ דְּרוֹר,"},
          {"ref": "8", "kind": "prayer", "text": "וְנָתַתִּי אֶת בִּרְכָתִי,"},
          {"ref": "9", "kind": "prayer", "text": "אִשָּׁה אֶל אֲחוֹתָהּ לַצְּרוֹר,"},
          {"ref": "10", "kind": "prayer", "text": "לְגַלּוֹת עַל יוֹם שִׂמְחָתִי,"},
          {"ref": "11", "kind": "prayer", "text": "בִּגְדֵי שֵׁשׁ עִם שָׁנִי,"},
          {"ref": "12", "kind": "prayer", "text": "וְהִתְבּוֹנְנוּ מִזְקֵנַי:"},
          {"ref": "13", "kind": "prayer", "text": "שַׁבַּת הַיּוֹם לה', וּלְווּ עָלַי..."},
          {"ref": "15", "kind": "prayer", "text": "מַהֲרוּ אֶת הַמָּנֶּה,"},
          {"ref": "16", "kind": "prayer", "text": "לַעֲשׂוֹת אֶת דְּבַר אֶסְתֵּר,"},
          {"ref": "17", "kind": "prayer", "text": "וְחִשְׁבוּ עִם הַקּוֹנֶה,"},
          {"ref": "18", "kind": "prayer", "text": "לְשַׁלֵּם אָכוֹל וְהוֹתֵר,"},
          {"ref": "19", "kind": "prayer", "text": "בִּטְּחוּ אֱמוּנַי,"},
          {"ref": "20", "kind": "prayer", "text": "וּשְׁתוּ יֵין מִשְׁמַנַּי:"},
          {"ref": "21", "kind": "prayer", "text": "שַׁבַּת הַיּוֹם לה', וּלְווּ עָלַי..."},
          {"ref": "23", "kind": "prayer", "text": "הִנֵּה יוֹם גְּאֻלָּה,"},
          {"ref": "24", "kind": "prayer", "text": "יוֹם שַׁבָּת אִם תִּשְׁמְרוּ,"},
          {"ref": "25", "kind": "prayer", "text": "וֶהֱיִיתֶם לִי סְגֻלָּה,"},
          {"ref": "26", "kind": "prayer", "text": "לִינוּ וְאַחַר תַּעַבֹרוּ,"},
          {"ref": "27", "kind": "prayer", "text": "וְאָז תִּחְיוּ לְפָנַי,"},
          {"ref": "28", "kind": "prayer", "text": "וּתְמַלְּאוּ צְפוּנַי:"},
          {"ref": "29", "kind": "prayer", "text": "שַׁבַּת הַיּוֹם לה', וּלְווּ עָלַי..."},
          {"ref": "31", "kind": "prayer", "text": "חַזֵּק קִרְיָתִי,"},
          {"ref": "32", "kind": "prayer", "text": "אֵל אֱלֹקִים עֶלְיוֹן,"},
          {"ref": "33", "kind": "prayer", "text": "וְהָשֵׁב אֶת נְוָתִי,"},
          {"ref": "34", "kind": "prayer", "text": "בְּשִּׂמְחָה וּבְהִגָּיוֹן,"},
          {"ref": "35", "kind": "prayer", "text": "יְשׁוֹרְרוּ שָׁם רְנָנַי,"},
          {"ref": "36", "kind": "prayer", "text": "לְוִיַי וְכֹהֲנַי,"},
          {"ref": "37", "kind": "prayer", "text": "וְאָז תִּתְעַנַג עַל ה':"},
          {"ref": "38", "kind": "prayer", "text": "שַׁבַּת הַיּוֹם לה', וּלְווּ עָלַי..."}
        ]
      }
    },
    {
      "path": "Shabbat/Daytime Meal/Zemirot for Second Meal/Ki Eshmera",
      "title": "כי אשמרה",
      "node": "x.zemirot.ki_eshmera",
      "service": "none",
      "he": {
        "version": "Daat Siddur Ashkenaz",
        "segs": [
          {"ref": "1", "kind": "prayer", "text": "כי אשמרה שבת א-ל ישמרני אות היא לעולמי עד בינו וביני"},
          {"ref": "4", "kind": "prayer", "text": "אסור מצוא חפץ עשות דרכים"},
          {"ref": "6", "kind": "prayer", "text": "גם מלדבר בו דברי צרכים"},
          {"ref": "8", "kind": "prayer", "text": "דברי סחורה אף דברי מלכים"},
          {"ref": "10", "kind": "prayer", "text": "אהגה בתורת א-ל ותחכמני"},
          {"ref": "13", "kind": "prayer", "text": "בו אמצאה תמיד נופש לנפשי"},
          {"ref": "15", "kind": "prayer", "text": "הנה לדור ראשון נתן קדושי"},
          {"ref": "17", "kind": "prayer", "text": "מופת בתת לחם משנה בשישי"},
          {"ref": "19", "kind": "prayer", "text": "ככה בכל שישי יכפיל מזוני"},
          {"ref": "22", "kind": "prayer", "text": "רשם בדת הא-ל חוק אל סגניו"},
          {"ref": "24", "kind": "prayer", "text": "בו לערוך לחם פנים לפניו"},
          {"ref": "26", "kind": "prayer", "text": "גם בו להתענות <em><small>בו</small></em> על פי נבוניו"},
          {"ref": "28", "kind": "prayer", "text": "אסור לבד מיום כיפור עווני"},
          {"ref": "31", "kind": "prayer", "text": "הוא יום מכובד הוא יום תענוגים"},
          {"ref": "33", "kind": "prayer", "text": "לחם ויין טוב בשר ודגים"},
          {"ref": "35", "kind": "prayer", "text": "מתאבלים בו אחור נסוגים"},
          {"ref": "37", "kind": "prayer", "text": "כי יום שמחות הוא ותשמחני"},
          {"ref": "40", "kind": "prayer", "text": "מחל מלאכה בו סופו להכרית"},
          {"ref": "42", "kind": "prayer", "text": "על כן אכבס בו ליבי בבורית"},
          {"ref": "44", "kind": "prayer", "text": "אתפללה אל א-ל ערבית ושחרית"},
          {"ref": "46", "kind": "prayer", "text": "מוסף וגם מנחה הוא יענני"},
          {"ref": "49", "kind": "commentary", "en": "Author: R. Avraham ibn Ezra", "text": "מחבר: ר' אברהם בן עזרא"}
        ]
      }
    },
    {
      "path": "Shabbat/Daytime Meal/Zemirot for Second Meal/Dror Yikrah",
      "title": "דרור יקרא",
      "node": "x.zemirot.dror_yikrah",
      "service": "none",
      "he": {
        "version": "Daat Siddur Ashkenaz",
        "segs": [
          {"ref": "1", "kind": "prayer", "text": "דְּרוֹר יִקְרָא לְבֵן עִם בַּת."},
          {"ref": "3", "kind": "prayer", "text": "וְיִנְצָרְכֶם כְּמוֹ בָבַת."},
          {"ref": "5", "kind": "prayer", "text": "נְעִים שִׁמְכֶם וְלֹא יֻשְׁבַּת."},
          {"ref": "7", "kind": "prayer", "text": "שְׁבוּ נוּחוּ בְּיוֹם שַׁבָּת:"},
          {"ref": "10", "kind": "prayer", "text": "דְּרוֹשׁ נָוִי וְאוּלָמִי."},
          {"ref": "12", "kind": "prayer", "text": "וְאוֹת יֶשַׁע עֲשֵׂה עִמִּי."},
          {"ref": "14", "kind": "prayer", "text": "נְטַע שׂוֹרֵק בְּתוֹךְ כַּרְמִי."},
          {"ref": "16", "kind": "prayer", "text": "שְׁעֵה שַׁוְעַת בְּנֵי עַמִּי:"},
          {"ref": "19", "kind": "prayer", "text": "דְּרוֹךְ פּוּרָה בְּתוֹךְ בָּצְרָה."},
          {"ref": "21", "parts": [
            {"kind": "prayer", "text": "וְגַם בָּבֶל "},
            {"kind": "note", "en": "Alternate reading: אֱדוֹם", "text": "<em><small>נ\"א: אֱדוֹם</small></em>"},
            {"kind": "prayer", "text": " אֲשֶׁר גָּבְרָה."}
          ]},
          {"ref": "23", "kind": "prayer", "text": "נְתוֹץ צָרַי בְּאַף וְעֶבְרָה."},
          {"ref": "25", "kind": "prayer", "text": "שְׁמַע קוֹלִי בְּיוֹם אֶקְרָא:"},
          {"ref": "28", "kind": "prayer", "text": "אֱלֹקים תֵּן בַּמִּדְבָּר הַר."},
          {"ref": "30", "parts": [
            {"kind": "prayer", "text": "הֲדַס שִׁטָּה בְּרוֹשׁ "},
            {"kind": "note", "en": "Alternate reading: בְּרֹאשׁ", "text": "<em><small>נ\"א: בְּרֹאשׁ</small></em>"},
            {"kind": "prayer", "text": " תִּדְהָר."}
          ]},
          {"ref": "32", "kind": "prayer", "text": "וְלַמַּזְהִיר וְלַנִּזְהָר."},
          {"ref": "34", "kind": "prayer", "text": "שְׁלוֹמִים תֵּן כְּמֵי נָהָר:"},
          {"ref": "37", "kind": "prayer", "text": "הֲדוֹךְ קָמַי חַי אֵל קַנָּא."},
          {"ref": "39", "parts": [
            {"kind": "prayer", "text": "בְּמוֹג לֵבָב וּבִמְגִנָּה "},
            {"kind": "note", "en": "Alternate reading: וּבַמְגִנָּה", "text": "<em><small>נ\"א: וּבַמְגִנָּה</small></em>."}
          ]},
          {"ref": "41", "kind": "prayer", "text": "וְנַרְחִיב פֶּה וּנְמַלֶּאנָּה."},
          {"ref": "43", "kind": "prayer", "text": "לְשׁוֹנֵנוּ לְךָ רִנָּה:"},
          {"ref": "46", "kind": "prayer", "text": "דְּעֵה חָכְמָה לְנַפְשֶׁךָ."},
          {"ref": "48", "kind": "prayer", "text": "וְהִיא כֶתֶר לְרֹאשֶׁךָ."},
          {"ref": "50", "parts": [
            {"kind": "prayer", "text": "נְצוֹר מִצְוַת קְדֹשֶׁךָ "},
            {"kind": "note", "en": "Alternate reading: אֱלֹהֶיךָ", "text": "<em><small>נ\"א: אֱלֹהֶיךָ</small></em>"}
          ]},
          {"ref": "52", "kind": "prayer", "text": "שְׁמוֹר שַׁבָּת קָדְשֶׁךָ:"},
          {"ref": "55", "kind": "commentary", "en": "Author: Dunash ben Labrat", "text": "מחבר: דונש בן לברט"}
        ]
      }
    }
  ]
