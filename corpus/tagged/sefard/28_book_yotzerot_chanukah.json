    },
    {
     "text": ":",
     "kind": "prayer"
    }
   ]
  },
  "he:Chanukah/Menorah Lighting:29": {
   "parts": [
    {
     "text": "<b><b>קַבֵּל רִנַּת עַמְּךָ שַׂגְּבֵנוּ טַהֲרֵנוּ נוֹרָא. ",
     "kind": "prayer"
