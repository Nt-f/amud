  },
  "he:Chanukah/Menorah Lighting:28": {
   "parts": [
    {
     "text": "<b>אָנָּא</b> בְּכֹחַ גְּדֻלַּת יְמִינְךָ תַּתִּיר צְרוּרָה. ",
     "kind": "prayer"
    },
    {
     "text": "<small>אב\"ג ית\"ץ</small>",
     "kind": "instruction",
