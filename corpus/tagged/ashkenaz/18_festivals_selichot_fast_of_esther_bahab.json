  "he:Festivals/Selichot/Yom Kippur Katan:1": {
   "kind": "prayer",
   "node": "x.selichot.ykk_opening"
  },
  "he:Festivals/Selichot/Yom Kippur Katan:2": {
   "kind": "commentary",
   "en": "This piyyut was composed by Rabbi Yehuda Aryeh of Modena; his name is hinted at the beginning of each stanza.",
   "node": "x.selichot.ykk_opening"
  },
  "he:Festivals/Selichot/Yom Kippur Katan:3": {
   "kind": "prayer",
   "node": "x.selichot.ykk_opening"
  },
  "he:Festivals/Selichot/Yom Kippur Katan:5": {
   "parts": [
    {
     "text": "יום: ",
     "kind": "instruction",
     "en": "Refrain: \"יום\"",
     "node": "x.selichot.ykk_opening"
    },
    {
     "kind": "prayer",
     "node": "x.selichot.ykk_opening",
     "text": "וַדַּאי זְדוֹן לִבִּי אֶצְלוֹ גָלוּי, חוּטֵי עֲוֹנוֹתַי עִם דּוֹק רִשְׁעִי, דִּינִי אֲנִי אֵדָע בָּאֵשׁ קָלוּי, כִּי רַע וּבִישׁ אָרַגְתִּי אֶל פִּשְׁעִי, הוֹלֵךְ בְּיוֹם וָיוֹם אַחַר בִּצְעִי, מִבֵּית מְקוֹם סֵפֶר תִּינוֹק בּוֹרֵחַ. "
    }
   ]
  },
  "he:Festivals/Selichot/Yom Kippur Katan:7": {
   "parts": [
    {
     "text": "יום: ",
     "kind": "instruction",
     "en": "Refrain: \"יום\"",
     "node": "x.selichot.ykk_opening"
    },
    {
     "kind": "prayer",
     "node": "x.selichot.ykk_opening",
     "text": "אָכֵן בְּחַבְלֵי שָׁוְא עָוֹן מוֹשֵׁךְ, אָחוֹר, לְךָ אֵלִי בָּאתִי נִצָּב, רִפְאוּת לְאֶרֶס מַר נָחָשׁ נוֹשֵׁךְ, שׁוֹאֵל וּמִתְחַנֵּן נִכְאָב נֶעֱצָּב, יוֹשֵׁב בְּעִנוּיֵי אֶבֶן מַחֲצָב, יָד פֶּה וְעַיִן אֵין לִי טַעַם וָרֵיחַ. "
    }
   ]
  },
  "he:Festivals/Selichot/Yom Kippur Katan:9": {
   "parts": [
    {
     "text": "יום: ",
     "kind": "instruction",
     "en": "Refrain: \"יום\"",
     "node": "x.selichot.ykk_opening"
    },
    {
     "kind": "prayer",
     "node": "x.selichot.ykk_opening",
     "text": "הֵן רֹאשׁ חֳדָשִׁים אֶל עַמְּךָ נָתַתָּ, לִזְמַן כַּפָּרָה עַל כָּל תּוֹלְדוֹתָם, מֵאֵת אֲהוּבֶיךָ שׂוֹטֵן הִשְׁבַּתָּ, עַל כֵּן אֲקַדֶּמְךָ בִּתְחִנָּתָם, מִיּוֹם לְפָנָיו בָּא כִּי אָז אֵיתָם, אָשׁוּב לְאִישׁ תּוֹשָׁב לֹא עוֹד אוֹרֵחַ. "
    }
   ]
  },
  "he:Festivals/Selichot/Yom Kippur Katan:11": {
   "parts": [
    {
     "text": "יום: ",
     "kind": "instruction",
     "en": "Refrain: \"יום\"",
     "node": "x.selichot.ykk_opening"
    },
    {
     "kind": "prayer",
     "node": "x.selichot.ykk_opening",
     "text": "וּבְרוֹב חֲסָדֶיךָ אַתָּה מַלְכִּי, תָּקוּם תְּרַחֵם אֶת צִיּוֹן קָדְשֵׁנוּ, דִּירַת מְנוּחָתְךָ שִׂים כָּבוֹד, כִּי בָהּ נַעֲלֶה עוֹלוֹת רָאשֵׁי חָדְשֵׁנוּ, נָא אֵל שְׁלַח נוֹשֵׂא נֵזֶר רֹאשֵׁנוּ, כִּי שָׁם לְבָבֵנוּ שׁוֹאֵף זוֹרֵחַ. "
    }
   ]
  },
  "he:Festivals/Selichot/Yom Kippur Katan:13": {
   "kind": "instruction",
   "en": "Refrain: \"Yom\"",
   "node": "x.selichot.ykk_opening"
  },
  "he:Festivals/Selichot/Yom Kippur Katan:15": {
   "kind": "prayer",
   "node": "x.selichot.ykk_opening"
  },
  "he:Festivals/Selichot/Yom Kippur Katan:16": {
   "kind": "instruction",
   "en": "After the order of the offerings, Ashrei, Half Kaddish, and the silent Amidah, begin here after the chazzan's repetition.",
   "node": "selichot.fast_day"
  },
  "he:Festivals/Selichot/Yom Kippur Katan:17": {
   "kind": "prayer",
   "node": "selichot.fast_day"
  },
  "he:Festivals/Selichot/Yom Kippur Katan:18": {
   "parts": [
    {
     "text": "<em><small>חו\"ק</small></em>",
     "kind": "speaker",
     "en": "Chazzan, then congregation:",
     "role": "chazzan_then_congregation",
     "node": "selichot.fast_day"
    },
    {
     "kind": "prayer",
     "node": "selichot.fast_day",
     "text": "הֲשִׁיבֵנוּ יְהֹוָה אֵלֶיךָ וְנָשׁוּבָה חַדֵּשׁ יָמֵינוּ כְּקֶדֶם: ",
     "role": "chazzan_then_congregation",
     "repeat": 3
    }
   ]
  },
  "he:Festivals/Selichot/Yom Kippur Katan:19": {
   "kind": "instruction",
   "en": "Three times",
   "node": "selichot.fast_day"
  },
