  "he:Shabbat Evening/Atkenu Seudata:1": {
   "kind": "heading",
   "en": "Let us prepare the meal"
  },
  "he:Shabbat Evening/Atkenu Seudata:2": {
   "parts": [
    {
     "text": "<b>אַתְקִינוּ</b> סְעֻדָּתָא דִּמְהֵימְנוּתָא שְׁלֵימָתָא,",
     "kind": "prayer"
    },
    {
     "text": " חֶדְוָתָא דְמַלְכָּא קַדִּישָׁא: אַתְקִינוּ סְעֻדָּתָא דְמַלְכָּא,",
     "kind": "prayer"
    },
    {
     "text": " דָּא הִיא סְעֻדָּתָא דַּחֲקַל תַּפּוּחִין קַדִּישִׁין ",
     "kind": "prayer"
    },
    {
     "text": "<small>(וּזְעֵיר אַנְפִּין ועַתִּיקָא קַדִּישָׁא אַתְיָן לסַעֲדָא בַּהֲדֵיהּ)</small>",
     "kind": "prayer"
    },
    {
     "text": ":",
     "kind": "prayer"
    }
   ]
  },
