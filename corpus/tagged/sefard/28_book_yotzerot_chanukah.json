     "kind": "prayer"
    }
   ]
  },
  "he:Chanukah/Menorah Lighting:31": {
   "parts": [
    {
     "text": "<b><b>בָּרְכֵם טַהֲרֵם רַחֲמֵי צִדְקָתְךָ תָּמִיד גָּמְלֵם. ",
