   "role": "chazzan_then_congregation",
   "minyan": true
  },
  "he:Festivals/Selichot/Ten of Tevet:42": {
   "kind": "prayer",
   "node": "tachanun.yud_gimmel_middot",
   "role": "chazzan_then_congregation",
   "minyan": true
  },
  "he:Festivals/Selichot/Ten of Tevet:17": {
   "parts": [
    {
     "kind": "prayer",
     "node": "tachanun.yud_gimmel_middot",
     "role": "chazzan_then_congregation",
     "minyan": true,
     "text": "יְהֹוָה יְהֹוָה אֵל רַחוּם וְחַנּוּן אֶרֶךְ אַפַּיִם וְרַב חֶסֶד וֶאֱמֶת: נֹצֵר חֶסֶד לָאֲלָפִים נֹשֵׂא עָוֹן וָפֶשַׁע וְחַטָּאָה וְנַקֵּה: וְסָלַחְתָּ לַעֲוֹנֵנוּ וּלְחַטָּאתֵנוּ וּנְחַלְתָּנוּ: "
    },
    {
     "kind": "prayer",
     "node": "selichot.fast_day",
     "text": "סְלַח לָנוּ אָבִינוּ כִּי חָטָאנוּ מְחַל לָנוּ מַלְכֵּנוּ כִּי פָשָׁעְנוּ: כִּי אַתָּה אֲדֹנָי טוֹב וְסַלָּח וְרַב חֶסֶד לְכָל קֹרְאֶיךָ: "
    }
   ]
  },
  "he:Festivals/Selichot/Ten of Tevet:25": {
