  "he:Mishna Study for Shabbat/Pirkei Avot:66": {
   "parts": [
    {
     "text": "<b>כג</b> רִבִּי אֶלְעָזָר ",
     "kind": "prayer"
    },
    {
     "text": "<small>(בֶּן)</small>",
     "kind": "prayer"
    },
    {
     "text": " חִסְמָא אוֹמֵר,",
     "kind": "prayer"
    },
    {
     "text": " קִנִּין וּפִתְחֵי נִדָּה,",
     "kind": "prayer"
    },
    {
     "text": " הֵן הֵן גּוּפֵי הֲלָכוֹת. תְּקוּפוֹת וְגִימַטְרִיָּאוֹת,",
     "kind": "prayer"
    },
    {
     "text": " פַּרְפְּרָאוֹת לַחָכְמָה:",
     "kind": "prayer"
    }
   ]
  },
