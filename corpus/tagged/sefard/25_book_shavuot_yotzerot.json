     "kind": "prayer",
     "node": "amidah.birkat_kohanim",
     "role": "chazzan",
     "minyan": true
    },
    {
     "text": " כֻּלָּנוּ כְּאֶחָד ",
     "kind": "prayer",
     "node": "amidah.birkat_kohanim",
     "role": "chazzan",
     "minyan": true
    },
    {
