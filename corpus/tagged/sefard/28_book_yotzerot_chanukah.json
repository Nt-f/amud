  "he:Yotzerot/Shabbat HaGadol:71": {
   "kind": "instruction",
   "en": "Priestly Blessing"
  },
  "he:Yotzerot/Shabbat HaGadol:72": {
   "parts": [
    {
     "text": "<b>שִׂים שָׁלוֹם</b> טוֹבָה וּבְרָכָה,",
     "kind": "prayer",
     "role": "chazzan"
    },
    {
     "text": " חַיִּים,",
     "kind": "prayer",
     "role": "chazzan"
    },
    {
     "text": " חֵן וָחֶסֶד,",
     "kind": "prayer",
     "role": "chazzan"
    },
    {
     "text": " וְרַחֲמִים,",
     "kind": "prayer",
     "role": "chazzan"
    },
    {
     "text": " עָלֵינוּ וְעַל כָּל יִשְׂרָאֵל עַמֶּךָ. בָּרְכֵנוּ אָבִינוּ,",
     "kind": "prayer",
     "role": "chazzan"
    },
    {
     "text": " כֻּלָּנוּ כְּאֶחָד ",
     "kind": "prayer",
     "role": "chazzan"
    },
    {
     "text": "<small>(יַחַד)</small>",
     "kind": "prayer",
     "role": "chazzan",
     "en": "(Together)"
    },
    {
     "text": " בְּאוֹר פָּנֶיךָ,",
     "kind": "prayer",
     "role": "chazzan"
    },
    {
     "text": " כִּי בְאוֹר פָּנֶיךָ נָתַתָּ לָּנוּ יְהֹוָה אֱלֹהֵינוּ,",
     "kind": "prayer",
     "role": "chazzan"
    },
    {
     "text": " תּוֹרַת חַיִּים,",
     "kind": "prayer",
     "role": "chazzan"
    },
    {
     "text": " וְאַהֲבַת חֶסֶד,",
     "kind": "prayer",
     "role": "chazzan"
    },
    {
     "text": " וּצְדָקָה וּבְרָכָה וְרַחֲמִים,",
     "kind": "prayer",
     "role": "chazzan"
    },
    {
     "text": " וְחַיִּים וְשָׁלוֹם. ",
     "kind": "prayer",
     "role": "chazzan"
    },
    {
     "text": "<small>(וְכָל טוּב)</small>",
     "kind": "prayer",
     "role": "chazzan",
     "en": "(And all good)"
    },
    {
     "text": " וְטוֹב יִהְיֶה בְּעֵינֶיךָ לְבָרְכֵנוּ וּלְבָרֵךְ אֶת כָּל עַמְּךָ יִשְׂרָאֵל בְּכָל עֵת וּבְכָל שָׁעָה בִּשְׁלוֹמֶךָ,",
     "kind": "prayer",
     "role": "chazzan"
    },
    {
     "text": " בְּרֹב עֹז וְשָׁלוֹם. ",
     "kind": "prayer",
     "role": "chazzan"
    }
   ]
  },
