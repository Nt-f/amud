   "en": "Drink a revi'it and bless over the vine."
  },
  "he:Havdalah/Havdala:17": {
   "kind": "prayer"
  },
  "he:Havdalah/Havdala:18": {
   "parts": [
    {
     "text": "<small><small>בראש חודש</small>",
     "kind": "instruction",
     "en": "On Rosh Chodesh"
    },
    {
     "text": " וְזָכְרֵֽנוּ לְטוֹבָה בְּיוֹם רֹאשׁ חֹֽדֶשׁ הַזֶּה.</small>",
     "kind": "prayer",
     "when": "roshChodesh"
    }
   ]
  },
  "he:Havdalah/Havdala:19": {
   "parts": [
    {
     "text": "<small><small>חוה''מ פסח</small>",
     "kind": "instruction",
     "en": "On Chol HaMoed Pesach"
    },
    {
     "text": " וְשַׂמְּחֵֽנוּ בְּיוֹם חַג הַמַּצּוֹת הַזֶּה בְּיוֹם מִקְרָא קֹֽדֶשׁ הַזֶּה.</small>",
     "kind": "prayer",
     "when": "cholHamoedPesach"
    }
   ]
  },
  "he:Havdalah/Havdala:20": {
   "parts": [
    {
     "text": "<small><small>חוה''מ סוכות</small>",
     "kind": "instruction",
     "en": "On Chol HaMoed Sukkot"
    },
    {
     "text": " וְשַׂמְּחֵֽנוּ בְּיוֹם חַג הַסֻּכּוֹת הַזֶּה בְּיוֹם מִקְרָא קֹֽדֶשׁ הַזֶּה.</small>",
     "kind": "prayer",
     "when": "cholHamoedSukkot"
    }
   ]
  },
  "he:Havdalah/Havdala:21": {
   "parts": [
    {
     "text": "כִּי אַתָּה טוֹב וּמֵטִיב לַכֹּל,",
     "kind": "prayer"
    },
    {
     "text": " וְנוֹדֶה לְךָ עַל הָאָֽרֶץ וְעַל פְּרִי הַגֶּֽפֶן ",
     "kind": "prayer"
    },
    {
     "text": "<small>(גַפְנָהּ)</small>",
     "kind": "instruction",
     "en": "(vine)"
    },
    {
     "text": " בָּרוּךְ אַתָּה יְהֹוָה,",
     "kind": "prayer"
    },
    {
     "text": " עַל הָאָֽרֶץ וְעַל פְּרִי הַגֶּֽפֶן: ",
     "kind": "prayer"
    },
    {
     "text": "<small>(גַפְנָהּ:)</small>",
     "kind": "instruction",
     "en": "(vine:)"
    }
   ]
  },
  "he:Havdalah/Motzei Shabbat Songs:1": {
   "kind": "heading",
   "en": "Songs for Motzei Shabbat"
  },
  "he:Havdalah/Motzei Shabbat Songs:2": {
   "kind": "prayer"
  },
  "he:Havdalah/Motzei Shabbat Songs:3": {
   "parts": [
    {
     "text": "יוֹם פָּנָה כְּצֵל תֹּֽמֶר. אֶקְרָא לָאֵל עָלַי גּוֹמֵר. יוֹם אֲשֶׁר אָמַר שׁוֹמֵר. אָתָא בֽוֹקֶר וְגַם לָֽיְלָה: ",
     "kind": "prayer"
    },
    {
     "text": "<small>(המבדיל)</small>",
     "kind": "instruction",
     "en": "(Hamavdil)"
    }
   ]
  },
  "he:Havdalah/Motzei Shabbat Songs:4": {
   "parts": [
    {
     "text": "צִדְקָֽתְךָֽ כְּהַר תָּבוֹר. עֲלֵי פְשָׁעַי עָבוֹר תַּעֲבוֹר. כְּיוֹם אֶתְמוֹל כִּי יַעֲבֹר. וְאַשְׁמוּרָה בַלָּֽיְלָה: ",
     "kind": "prayer"
    },
    {
     "text": "<small>(המבדיל)</small>",
     "kind": "instruction",
     "en": "(Hamavdil)"
    }
   ]
  },
  "he:Havdalah/Motzei Shabbat Songs:5": {
   "parts": [
    {
     "text": "חָֽלְפָֽה עוֹנַת מִנְחָתִי. מִי יִתֵּן מְנוּחָתִי. יָגַֽעְתִּי בְאַנְחָתִי. אַשְׂחֶה בְכָל־לַֽיְלָה: ",
     "kind": "prayer"
    },
    {
     "text": "<small>(המבדיל)</small>",
     "kind": "instruction",
     "en": "(Hamavdil)"
    }
   ]
  },
  "he:Havdalah/Motzei Shabbat Songs:6": {
   "parts": [
    {
     "text": "קוֹלִי שִׁמְעָה בַּל יֻנְטַל. פְּתַח לִי שַֽׁעַר הַמְּנֻטָּל. שֶׁרֹאשִׁי נִמְלָא טָל. קְוֻצּוֹתַי רְסִֽיסֵי לָֽיְלָה: ",
     "kind": "prayer"
    },
    {
     "text": "<small>(המבדיל)</small>",
     "kind": "instruction",
     "en": "(Hamavdil)"
    }
   ]
  },
  "he:Havdalah/Motzei Shabbat Songs:7": {
   "parts": [
    {
     "text": "הֵעָתֵר נוֹרָא וְאָיוֹם. אֲשַׁוֵּֽעַ תְּנָה פִדְיוֹם. בְּנֶֽשֶׁף בְּעֶרֶב יוֹם. בְּאִישׁוֹן לָֽיְלָה: ",
     "kind": "prayer"
    },
    {
     "text": "<small>(המבדיל)</small>",
     "kind": "instruction",
     "en": "(Hamavdil)"
    }
   ]
  },
  "he:Havdalah/Motzei Shabbat Songs:8": {
   "parts": [
    {
     "text": "קְרָאתִֽיךָ יָּהּ הוֹשִׁיעֵֽנִי. אֽוֹרַח חַיִּים תּוֹדִיעֵֽנִי. מִדַּלּוּת תְּבַצְּעֵֽנִי. מִיּוֹם וְעַד לָֽיְלָה: ",
     "kind": "prayer"
    },
    {
     "text": "<small>(המבדיל)</small>",
     "kind": "instruction",
     "en": "(Hamavdil)"
    }
   ]
  },
  "he:Havdalah/Motzei Shabbat Songs:9": {
   "parts": [
    {
     "text": "טַהֵר טִנּוּף מַעֲשַׂי. פֶּן יֹאמְרוּ מַכְעִיסַי. אַיֵּה אֱלוֹהַּ עוֹשַׂי. נוֹתֵן זְמִירוֹת בַּלָּיְלָה: ",
     "kind": "prayer"
    },
    {
     "text": "<small>(המבדיל)</small>",
     "kind": "instruction",
     "en": "(Hamavdil)"
    }
   ]
  },
  "he:Havdalah/Motzei Shabbat Songs:10": {
   "parts": [
    {
     "text": "נַֽחְנוּ בְיָֽדְךָֽ כַּחֹֽמֶר. סְלַח נָא עַל קַל וָחֽוֹמֶר. יוֹם לְיוֹם יַבִּֽיעַ אֹמֶר,",
     "kind": "prayer"
    },
    {
     "text": " וְלַֽיְלָה לְלָֽיְלָה: ",
     "kind": "prayer"
    },
    {
     "text": "<small>(המבדיל)</small>",
     "kind": "instruction",
     "en": "(Hamavdil)"
    }
   ]
  },
  "he:Havdalah/Motzei Shabbat Songs:11": {
   "parts": [
    {
     "text": "אֵל פּוֹדֶה מִכָּל־צָר. קְרָאנֽוּךָ מִן הַמֵּצָר. יָֽדְךָֽ לֹא תִקְצָר. לֹא יוֹם וְלֹא לָֽיְלָה: ",
     "kind": "prayer"
    },
    {
     "text": "<small>(המבדיל)</small>",
     "kind": "instruction",
     "en": "(Hamavdil)"
    }
   ]
  },
  "he:Havdalah/Motzei Shabbat Songs:12": {
   "parts": [
    {
     "text": "מִיכָאֵל שַׂר יִשְׂרָאֵל. אֵלִיָּֽהוּ וְגַבְרִיאֵל. בֹּֽאוּ נָא עִם הַגּוֹאֵל. קֽוּמוּ בַחֲצִי הַלָּֽיְלָה: ",
     "kind": "prayer"
    },
    {
     "text": "<small>(המבדיל)</small>",
     "kind": "instruction",
     "en": "(Hamavdil)"
    }
   ]
  },
  "he:Havdalah/Motzei Shabbat Songs:13": {
   "parts": [
    {
     "text": "מִימִינֵֽנוּ מִיכָאֵל. וּמִשְּׂמֹאלֵֽנוּ גַּבְרִיאֵל. וְעַל רֹאשֵֽׁנוּ שְׁכִינַת אֵל. בְּכָל־יוֹם וּבְכָל־לָֽיְלָה: ",
     "kind": "prayer"
    },
    {
     "text": "<small>(המבדיל)</small>",
     "kind": "instruction",
     "en": "(Hamavdil)"
    }
   ]
  },
  "he:Havdalah/Motzei Shabbat Songs:14": {
   "parts": [
    {
     "text": "תְּנָה לָּֽנוּ שָׁבוּעַ טוֹב. רַעֲנָן כְּגַן רָטוֹב. וּמֵיְהֹוָה יָבוֹא הַטּוֹב. כָּל־הַיּוֹם וְכָל־הַלָּֽיְלָה: ",
     "kind": "prayer"
    },
    {
     "text": "<small>(המבדיל)</small>",
     "kind": "instruction",
     "en": "(Hamavdil)"
    }
   ]
  },
  "he:Havdalah/Motzei Shabbat Songs:15": {
   "parts": [
    {
     "text": "יְבוֹרַךְ הַבַּֽיִת הַזֶּה. מִפִּי נָבִיא וְגַם חוֹזֶה. כִּי כֵן יְצַוֶּה אֱלֹהֵֽינוּ זֶה. לְשָׁמְרוֹ יוֹמָם וָלָֽיְלָה: ",
     "kind": "prayer"
    },
    {
     "text": "<small>(המבדיל)</small>",
     "kind": "instruction",
     "en": "(Hamavdil)"
    }
   ]
  },
  "he:Havdalah/Motzei Shabbat Songs:16": {
   "parts": [
    {
     "text": "הַמַּבְדִּיל בֵּין מַֽיִם לְמַֽיִם. יְחַיֵּֽנוּ מִיּוֹמָֽיִם. יַרְאֵֽנוּ בְּטוּב יְרוּשָׁלַֽיִם. וְלִמְשׁוֹל בַּיּוֹם וּבַלָּֽיְלָה: ",
     "kind": "prayer"
    },
    {
     "text": "<small>(המבדיל)</small>",
     "kind": "instruction",
     "en": "(Hamavdil)"
    }
   ]
  },
  "he:Havdalah/Motzei Shabbat Songs:17": {
   "kind": "prayer"
  },
  "he:Havdalah/Motzei Shabbat Songs:18": {
   "kind": "prayer"
  },
  "he:Havdalah/Motzei Shabbat Songs:19": {
   "parts": [
    {
     "text": "הַבָּאִים יַשְׁרֵשׁ יַעֲקֹב. וְיֵרְדְּ מִיַּעֲקֹב. זְכָר אֵלֶּה יַעֲקֹב. ",
     "kind": "prayer"
    },
    {
     "text": "<small>(כצ\"ל)</small>",
     "kind": "instruction",
     "en": "(Correct reading)"
    }
   ]
  },
  "he:Havdalah/Motzei Shabbat Songs:20": {
   "kind": "prayer"
  },
  "he:Havdalah/Motzei Shabbat Songs:21": {
   "kind": "prayer"
  },
  "he:Havdalah/Motzei Shabbat Songs:22": {
   "kind": "prayer"
  },
  "he:Havdalah/Motzei Shabbat Songs:23": {
   "kind": "prayer"
  },
  "he:Havdalah/Motzei Shabbat Songs:24": {
   "kind": "prayer"
  },
  "he:Havdalah/Motzei Shabbat Songs:25": {
   "kind": "instruction",
   "en": "Sign: Abraham"
  },
  "he:Havdalah/Motzei Shabbat Songs:26": {
   "kind": "prayer"
  },
  "he:Havdalah/Motzei Shabbat Songs:27": {
   "parts": [
    {
     "text": "בּוֹ יִרְתֹּם רִכְבּוֹ. נָע בַּשְּׁבִי כִּי בוֹ. לֹא שָׁכַב לִבּוֹ. גַּם לֹא רָאָה שֵׁנָה: ",
     "kind": "prayer"
    },
    {
     "text": "<small>(אל אליהו)</small>",
     "kind": "instruction",
     "en": "(El Eliyahu)"
    }
   ]
  },
  "he:Havdalah/Motzei Shabbat Songs:28": {
   "parts": [
    {
     "text": "רַב מַחְלִי בִּרְאוֹת. כַּחְשִׁי וּמְשַׂנְאוֹת. יָפוֹת וּבְרִיאוֹת. בָּשָׂר וַתִּרְעֶינָה: ",
     "kind": "prayer"
    },
    {
     "text": "<small>(אל אליהו)</small>",
     "kind": "instruction",
     "en": "(El Eliyahu)"
    }
   ]
  },
  "he:Havdalah/Motzei Shabbat Songs:29": {
   "parts": [
    {
     "text": "הַשְׁקֵה צוּר מֵי רֹאשׁ. צַר עֵינָיו יִלְטֹשׁ. יוֹם עֵינַי לִקְדוֹשׁ. יִשְׂרָאֵל תִּשְׁעֶינָה: ",
     "kind": "prayer"
    },
    {
     "text": "<small>(אל אליהו)</small>",
     "kind": "instruction",
     "en": "(El Eliyahu)"
    }
   ]
  },
  "he:Havdalah/Motzei Shabbat Songs:30": {
   "parts": [
    {
     "text": "מָתַי תַּרְאֶה אוֹת. יֶשַׁע אֵל קוֹרְאוֹת. לְךָ וּלְךָ נוֹשְׂאוֹת. קוֹלָן וַתָּרֹנָּה [נ\"א: וַתִּבְכֶּינָה]: ",
     "kind": "prayer"
    },
    {
     "text": "<small>(אל אליהו)</small>",
     "kind": "instruction",
     "en": "(El Eliyahu)"
    }
   ]
  },
  "he:Havdalah/Motzei Shabbat Songs:31": {
   "parts": [
    {
     "text": "הַמַּלְאָךְ הַגּוֹאֵל. לִפְנֵי דַל שׁוֹאֵל. אָנָּא הָאֵל אֵל. אַבְרָהָם הַקְרֵה נָא: ",
     "kind": "prayer"
    },
    {
     "text": "<small>(אל אליהו)</small>",
     "kind": "instruction",
     "en": "(El Eliyahu)"
    }
   ]
  },
  "he:Havdalah/Motzei Shabbat Songs:32": {
   "kind": "instruction",
   "en": "Words: Rabbi Yosef Chaim zt\"l"
  },
  "he:Havdalah/Motzei Shabbat Songs:33": {
   "kind": "prayer"
  },
  "he:Havdalah/Motzei Shabbat Songs:34": {
   "parts": [
    {
     "text": "אֵלִיָּהוּ בַּעַל הָאוֹת. מַלְאַךְ יְהֹוָה צְבָאוֹת. זָכָה וְעָשָׂה נִפְלָאוֹת. אַשְׁרֵי הָעַיִן רָאָתְהוּ: ",
     "kind": "prayer"
    },
    {
     "text": "<small>(על בית)</small>",
     "kind": "instruction",
     "en": "(Al Beit)"
    }
   ]
  },
  "he:Havdalah/Motzei Shabbat Songs:35": {
   "parts": [
    {
     "text": "לָבַשׁ קִנְאָה בְּתוֹךְ עַמּוֹ. וְהָיָה יְהֹוָה עִמּוֹ. זָכָה וְלָקַח לְעַצְמוֹ. נֶפֶשׁ נָדָב וַאֲבִיהוּא: ",
     "kind": "prayer"
    },
    {
     "text": "<small>(על בית)</small>",
     "kind": "instruction",
     "en": "(Al Beit)"
    }
   ]
  },
  "he:Havdalah/Motzei Shabbat Songs:36": {
   "parts": [
    {
     "text": "יָדָיו רַב לוֹ בְּקִנְאָתוֹ. נָתַן לוֹ הָאֵל בְּרִיתוֹ. הַחַיִּים וְהַשָּׁלוֹם אִתּוֹ. רוּחַ יְהֹוָה תַּנְחֵהוּ: ",
     "kind": "prayer"
    },
    {
     "text": "<small>(על בית)</small>",
     "kind": "instruction",
     "en": "(Al Beit)"
    }
   ]
  },
  "he:Havdalah/Motzei Shabbat Songs:37": {
   "parts": [
    {
     "text": "הוּא בְאַרְבַּע עֲפִיפָתוֹ. וּבִשְׁמֵי מְרוֹמִים בֵּיתוֹ. אַשְׁרֵי אִישׁ יִזְכֶּה לִרְאוֹתוֹ. וְיִלְמַד תּוֹרָה מִפִּיהוּ: ",
     "kind": "prayer"
    },
    {
     "text": "<small>(על בית)</small>",
     "kind": "instruction",
     "en": "(Al Beit)"
    }
   ]
  },
  "he:Havdalah/Motzei Shabbat Songs:38": {
   "parts": [
    {
     "text": "וְאַשְׁרֵי נוֹתֵן לוֹ שָׁלוֹם. וְהוּא מַחֲזִיר לוֹ שָׁלוֹם. הַלְוַאי נִרְאֵהוּ בַחֲלוֹם. וְנִשְׂבַּע מֵאוֹר פָּנֵיהוּ: ",
     "kind": "prayer"
    },
    {
     "text": "<small>(על בית)</small>",
     "kind": "instruction",
     "en": "(Al Beit)"
    }
   ]
  },
  "he:Havdalah/Motzei Shabbat Songs:39": {
   "parts": [
    {
     "text": "חַי וְקַיָּם בְּעֹז וָאֵל. יַמְלִיץ טוֹב בְּעַד יִשְׂרָאֵל. וְחִישׁ יָבֹא עִם הַגּוֹאֵל. נָאווּ עַל הָרִים רַגְלֵיהוּ: ",
     "kind": "prayer"
    },
    {
     "text": "<small>(על בית)</small>",
     "kind": "instruction",
     "en": "(Al Beit)"
    }
   ]
  },
  "he:Havdalah/Motzei Shabbat Songs:40": {
   "parts": [
    {
     "text": "זְכוּתוֹ תָּגֵן עָלֵינוּ. הוּא יִכְתֹּב זְכֻיּוֹתֵינוּ. בְּמוֹצָאֵי שַׁבַּתֵּנוּ. בְּעֵץ הַחַיִּים יוֹשֵׁב הוּא: ",
     "kind": "prayer"
    },
    {
     "text": "<small>(על בית)</small>",
     "kind": "instruction",
     "en": "(Al Beit)"
    }
   ]
  },
  "he:Havdalah/Motzei Shabbat Songs:41": {
   "parts": [
    {
     "text": "קוֹל אֵלִיָּהוּ יַשְׁמִיעַ. שָׁלוֹם וִישׁוּעָה יַזְרִיעַ. כִּי עֵת הַזָּמִיר הִגִּיעַ. נָחָה רוּחַ אֵלִיָּהוּ: ",
     "kind": "prayer"
    },
    {
     "text": "<small>(על בית)</small>",
     "kind": "instruction",
     "en": "(Al Beit)"
    }
   ]
  },
  "he:Havdalah/Motzei Shabbat Songs:42": {
   "kind": "instruction",
   "en": "Sign: Yaakov Menoi Chazak"
  },
  "he:Havdalah/Motzei Shabbat Songs:43": {
   "kind": "prayer"
  },
  "he:Havdalah/Motzei Shabbat Songs:44": {
   "parts": [
    {
     "text": "יָאֲתָה לְךָ צוּרִי. לְקַבֵּץ עַם מְפֻזָּרִי. מִיַּד גּוֹי אַכְזָרִי. אֲשֶׁר כָּרָה לִי שׁוּחָה: ",
     "kind": "prayer"
    },
    {
     "text": "<small>(במוצאי)</small>",
     "kind": "instruction",
     "en": "(Bemotzei)"
    }
   ]
  },
  "he:Havdalah/Motzei Shabbat Songs:45": {
   "parts": [
    {
     "text": "עֵת דּוֹדִים תְּעוֹרֵר אֵל. לְמַלֵּט עַם אֲשֶׁר שׁוֹאֵל. רְאוֹת טוּבךָ בְּבוֹא גּוֹאֵל. לְשֶׂה פְּזוּרָה נִדָּחָה: ",
     "kind": "prayer"
    },
    {
     "text": "<small>(במוצאי)</small>",
     "kind": "instruction",
     "en": "(Bemotzei)"
    }
   ]
  },
  "he:Havdalah/Motzei Shabbat Songs:46": {
   "parts": [
    {
     "text": "קְרָא יֶשַׁע לְעַם נדָבָה. אֵל דָּגוּל מֵרְבָבָה. יְהִי הַשָּׁבוּעַ הַבָּא. לִישׁוּעָה וְלִרְוָחָה: ",
     "kind": "prayer"
    },
    {
     "text": "<small>(במוצאי)</small>",
     "kind": "instruction",
     "en": "(Bemotzei)"
    }
   ]
  },
  "he:Havdalah/Motzei Shabbat Songs:47": {
   "parts": [
    {
     "text": "בַּת צִיּוֹן הַשְּׁכוּלָה. אֲשֶׁר הִיא הַיּוֹם גְּעוּלָה. מְהֵרָה תִּהְיֶה בְּעוּלָה. אֵם הַבָּנִים שֹמֵחָה: ",
     "kind": "prayer"
    },
    {
     "text": "<small>(במוצאי)</small>",
     "kind": "instruction",
     "en": "(Bemotzei)"
    }
   ]
  },
  "he:Havdalah/Motzei Shabbat Songs:48": {
   "parts": [
    {
     "text": "מַעְיָנוֹת אֲזַי יזוּבוּן. וּפְדוּיִים עוֹד יְשׁוּבוּן. וּמִי יֶשַׁע יִשְׁאֲבוּן. וְהַצָּרָה נִשְׁכָּחָה: ",
     "kind": "prayer"
    },
    {
     "text": "<small>(במוצאי)</small>",
     "kind": "instruction",
     "en": "(Bemotzei)"
    }
   ]
  },
  "he:Havdalah/Motzei Shabbat Songs:49": {
   "parts": [
    {
     "text": "נְחֵה עַמְּךָ כְּאָב רַחֲמָן. יְצַפְצפוּ עַם לֹא אַלְמָן. דְּבַר יהוָֹה אֲשֶׁר נֶאֱמָן. בַּהֲקִימךָ הַבְטָחָה: ",
     "kind": "prayer"
    },
    {
     "text": "<small>(במוצאי)</small>",
     "kind": "instruction",
     "en": "(On Motzaei Shabbat)",
     "gloss": "Said only on Motzaei Shabbat"
    }
   ]
  },
  "he:Havdalah/Motzei Shabbat Songs:50": {
   "parts": [
    {
     "text": "וִידִידִים פְּלִיטֵי חֶרֶץ. נְגִינָתָם יִפְצחוּ בְּמֶרֶץ. בְּלִי צוָחָה וּבְלִי פֶרֶץ. אֵין יוֹצֵאת וְאֵין צְוָחָה: ",
     "kind": "prayer"
    },
    {
     "text": "<small>(במוצאי)</small>",
     "kind": "instruction",
     "en": "(On Motzaei Shabbat)",
     "gloss": "Said only on Motzaei Shabbat"
    }
   ]
  },
  "he:Havdalah/Motzei Shabbat Songs:51": {
   "parts": [
    {
     "text": "יְהִי הַחֹדֶשׁ הַזֶּה. כִּנְבוּאַת אֲבִי חוֹזֶה. וְיִשָּׁמַע בְּבַיִת זֶה. קוֹל שָׂשׂוֹן וְקוֹל שִׂמְחָה: ",
     "kind": "prayer"
    },
    {
     "text": "<small>(במוצאי)</small>",
     "kind": "instruction",
     "en": "(On Motzaei Shabbat)",
     "gloss": "Said only on Motzaei Shabbat"
    }
   ]
  },
  "he:Havdalah/Motzei Shabbat Songs:52": {
   "parts": [
    {
     "text": "חָזָק ימַלֵּא מִשְׁאֲלוֹתֵינוּ. אַמִּיץ יַעֲשֶׂה בַּקָּשָׁתֵנוּ. וְהוּא יִשְׁלַח בְּכָל מַעֲשֵׂה יָדֵינוּ. בְּרָכָה רְוָחָה וְהַצְלָחָה: ",
     "kind": "prayer"
    },
    {
     "text": "<small>(במוצאי)</small>",
     "kind": "instruction",
     "en": "(On Motzaei Shabbat)",
     "gloss": "Said only on Motzaei Shabbat"
    }
   ]
  },
  "he:Havdalah/Motzei Shabbat Songs:53": {
   "parts": [
    {
     "text": "בְּמוֹצָאֵי יוֹם גִּילָה. שִׁמְךָ נוֹרָא עֲלִילָה. שְׁלַח תִּשְׁבִּי לְעַם סְגֻלָּה. רֶוַח שָׂשׂוֹן וַהֲנָחָה: ",
     "kind": "prayer"
    },
    {
     "text": "<small>(במוצאי)</small>",
     "kind": "instruction",
     "en": "(On Motzaei Shabbat)",
     "gloss": "Said only on Motzaei Shabbat"
    }
   ]
  },
  "he:Havdalah/Motzei Shabbat Songs:54": {
   "parts": [
    {
     "text": "קוֹל צָהֳלָה וְרִנָּה. שְֹפָתֵינוּ אָז תְּרַנֵּנָה. אָנָּ֣א יְ֭הֹוָה הוֹשִׁ֘יעָ֥ה נָּ֑א אָנָּ֥א יְ֝הֹוָ֗ה הַצְלִ֘יחָ֥ה נָֽא: ",
     "kind": "prayer"
    },
    {
     "text": "<small>(במוצאי)</small>",
     "kind": "instruction",
     "en": "(On Motzaei Shabbat)",
     "gloss": "Said only on Motzaei Shabbat"
    }
   ]
  },
  "he:Havdalah/Motzei Shabbat Songs:55": {
   "kind": "instruction",
   "en": "Mnemonic: To S'adyah."
  },
  "he:Havdalah/Motzei Shabbat Songs:56": {
   "parts": [
    {
     "text": "<b>לַנֵּר </b>וְלִבְשָׂמִים,",
     "kind": "prayer"
    },
    {
     "text": " נַפְשִׁי מְיַחֵלָה. אִם תִּתְּנוּ לִי כּוֹס יַיִן לְהַבְדָּלָה: ",
     "kind": "prayer"
    },
    {
     "text": "<small>(אם תתנו)</small>",
     "kind": "instruction",
     "en": "(If you give)",
     "gloss": "Said if wine is provided for Havdalah"
    }
   ]
  },
  "he:Havdalah/Motzei Shabbat Songs:57": {
   "parts": [
    {
     "text": "סֹלּוּ דְרָכִים לִי,",
     "kind": "prayer"
    },
    {
     "text": " פַּנּוּ לְנָבוֹכָה. פִּתְחוּ שְׁעָרִים לִי,",
     "kind": "prayer"
    },
    {
     "text": " כָּל מַלְאֲכֵי מַעְלָה: ",
     "kind": "prayer"
    },
    {
     "text": "<small>(אם תתנו)</small>",
     "kind": "instruction",
     "en": "(If you give)",
     "gloss": "Said if wine is provided for Havdalah"
    }
   ]
  },
  "he:Havdalah/Motzei Shabbat Songs:58": {
   "parts": [
    {
     "text": "עֵינַי אֲנִי אֶשָּׂא,",
     "kind": "prayer"
    },
    {
     "text": " אֶל אֵל בְּלֵב כּוֹסֵף. מַמְצִיא צְרָכַי לִי,",
     "kind": "prayer"
    },
    {
     "text": " בַּיּוֹם וּבַלָּיְלָה: ",
     "kind": "prayer"
    },
    {
     "text": "<small>(אם תתנו)</small>",
     "kind": "instruction",
     "en": "(If you give)",
     "gloss": "Said if wine is provided for Havdalah"
    }
   ]
  },
  "he:Havdalah/Motzei Shabbat Songs:59": {
   "parts": [
    {
     "text": "דֵּי מַחֲסוֹר תֵּן לִי,",
     "kind": "prayer"
    },
    {
     "text": " מֵאוֹצְרוֹת טוּבָךְ. כִּי לַחֲסָדֶיךָ,",
     "kind": "prayer"
    },
    {
     "text": " אֵין קֵץ וְאֵין תִּכְלָה: ",
     "kind": "prayer"
    },
    {
     "text": "<small>(אם תתנו)</small>",
     "kind": "instruction",
     "en": "(If you give)",
     "gloss": "Said if wine is provided for Havdalah"
    }
   ]
  },
  "he:Havdalah/Motzei Shabbat Songs:60": {
   "parts": [
    {
     "text": "יִתְחַדְּשָׁה גִילִי,",
     "kind": "prayer"
    },
    {
     "text": " טַרְפִּי וְטוֹבָתִי. תָּסִיר יְגוֹנוֹתַי,",
     "kind": "prayer"
    },
    {
     "text": " מַכְאוֹב וּמַאְפֵלָה: ",
     "kind": "prayer"
    },
    {
     "text": "<small>(אם תתנו)</small>",
     "kind": "instruction",
     "en": "(If you give)",
     "gloss": "Said if wine is provided for Havdalah"
    }
   ]
  },
  "he:Havdalah/Motzei Shabbat Songs:61": {
   "parts": [
    {
     "text": "הִנֵּה יְמֵי מַעְשֶׂה,",
     "kind": "prayer"
    },
    {
     "text": " מִתְחַדְּשִׁים תָּמִיד. יִתְחַדְּשׁוּ בָהֶם,",
     "kind": "prayer"
    },
    {
     "text": " שָׁלוֹם וְטוֹב סֶלָה: ",
     "kind": "prayer"
    },
    {
     "text": "<small>(אם תתנו)</small>",
     "kind": "instruction",
     "en": "(If you give)",
     "gloss": "Said if wine is provided for Havdalah"
    }
   ]
  },
