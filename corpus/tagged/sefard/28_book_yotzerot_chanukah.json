  "he:Chanukah/Torah Reading:1": {
   "kind": "heading",
   "en": "Shacharit for Chanukah"
  },
  "he:Chanukah/Torah Reading:2": {
   "kind": "heading",
   "en": "Laws of Shacharit for Chanukah"
  },
  "he:Chanukah/Torah Reading:3": {
   "kind": "instruction",
   "en": "Pray as on a weekday, saying Al HaNissim in Modim. After the Amidah, recite full Hallel, Half Kaddish, take out the Torah, and read three men from Parashat Naso. On the first day: Kohen to 'for the dedication of the altar', Levi to 'full of incense', third to 'Elyasaph'. On the second day: Kohen to 'full of incense', Levi to 'son of Zechari', third repeats from 'On the second day'. For the rest of Chanukah, read the offering of that day. After reading: Half Kaddish, Ashrei, Uva LeTziyon (omit LaMenatzeach and Tefillah LeDavid, continue as usual, except on Rosh Chodesh: after Hallel say Shir Shel Yom, Barchi Nafshi, take out two Torahs; first: three men from Rosh Chodesh, Kohen to 'fourth hin', Levi to 'and its libation', third to end of Rosh Chodesh reading, no Kaddish; second: fourth man from Naso for that day's offering, Half Kaddish, Ashrei, Uva LeTziyon, Beis Yaakov, return Torahs, Half Kaddish, Musaf for Rosh Chodesh, say Al HaNissim in the confession. After Musaf: Kaddish Shalem, Kaddish Shalem, Kaveh El HaShem, Aleinu."
  },
  "he:Chanukah/Torah Reading:4": {
   "kind": "heading",
   "en": "Reading for the First Day of Chanukah"
  },
  "he:Chanukah/Torah Reading:5": {
   "kind": "instruction",
   "en": "On the first day of Chanukah, three men read from Parashat Naso up to 'Nachshon ben Aminadav'. Kohen to 'for the dedication of the altar', Levi to 'full of incense', third to 'Nachshon ben Aminadav'."
  },
  "he:Chanukah/Torah Reading:6": {
   "kind": "prayer",
   "role": "oleh"
  },
  "he:Chanukah/Torah Reading:7": {
   "kind": "heading",
   "en": "Reading for the Second Day of Chanukah"
  },
  "he:Chanukah/Torah Reading:8": {
   "kind": "instruction",
   "en": "On the second day, three men read: Kohen to 'full of incense', Levi to 'Nathanael ben Zuar', third repeats from 'On the second day' to the end of the offering. The same applies for the rest of Chanukah."
  },
  "he:Chanukah/Torah Reading:9": {
   "kind": "prayer",
   "role": "oleh"
  },
