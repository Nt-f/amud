<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Google Assistant App Actions. OPEN_APP_FEATURE: "open Shacharis in Amud",
       "show the Omer", "what is the Hebrew date in Amud". The shortcut id is the
       feature; routeFromLink (lib/features/integrations/prayer_links.dart)
       turns it into a screen. Synonyms are in values*/voice.xml (English,
       Hebrew, Yiddish). -->
  <capability android:name="actions.intent.OPEN_APP_FEATURE">
    <intent android:action="android.intent.action.VIEW">
      <url-template android:value="amud://voice/{prayer}" />
      <parameter android:name="feature" android:key="prayer" />
    </intent>
    <intent android:action="android.intent.action.VIEW" android:data="amud://siddur" />
  </capability>
  <!-- GET_THING: the user's own words ("ask Amud when is sunset") go to the
       Ask screen, which finds the topic. -->
  <capability android:name="actions.intent.GET_THING">
    <intent android:action="android.intent.action.VIEW">
      <url-template android:value="amud://voice/ask{?q}" />
      <parameter android:name="thing.name" android:key="q" />
    </intent>
    <intent android:action="android.intent.action.VIEW" android:data="amud://voice/ask" />
  </capability>
  <shortcut android:shortcutId="shacharit">
    <capability-binding android:key="actions.intent.OPEN_APP_FEATURE">
      <parameter-binding android:key="feature" android:value="@array/voice_shacharit" />
    </capability-binding>
  </shortcut>
