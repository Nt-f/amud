  "he:Lag BaOmer Songs/Bar Yochai:14": {
   "parts": [
    {
     "text": "<b>בַּר יוֹחָאי,",
     "kind": "prayer"
    },
    {
     "text": "</b> לִמְקוֹם אַבְנֵי שַׁיִשׁ,",
     "kind": "prayer"
    },
    {
     "text": " הִגַּעְתָּ לִפְנֵי ",
     "kind": "prayer"
    },
    {
     "text": "<small>(וּפְנֵי)</small>",
     "kind": "instruction",
     "en": "(and the face of)"
    },
    {
     "text": " אַרְיֵה לַיִשׁ,",
     "kind": "prayer"
    },
    {
     "text": " גַּם גֻּלַּת כּוֹתֶרֶת עַל עַיִשׁ,",
     "kind": "prayer"
    },
    {
     "text": " תָּשׁוּרִי וּמִי יְשׁוּרֶךָ:",
     "kind": "prayer"
    }
   ]
  },
