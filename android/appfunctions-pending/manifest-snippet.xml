        <!-- Android App Functions (Android 16+): assistants such as Gemini call these
             for spoken answers. The service class is generated by KSP from
             page/amud/appfunctions/AmudAppFunctions.kt. -->
        <service
            android:name=".appfunctions.AmudAppFunctionService"
            android:permission="android.permission.BIND_APP_FUNCTION_SERVICE"
            android:exported="true"
            tools:targetApi="36">
            <property android:name="android.app.appfunctions.schema" android:value="app_functions_schema.xsd" />
            <property android:name="android.app.appfunctions.v2" android:value="amud_app_function_service.xml" />
            <intent-filter>
                <action android:name="android.app.appfunctions.AppFunctionService" />
            </intent-filter>
        </service>
        <property android:name="android.app.appfunctions.app_metadata" android:resource="@xml/app_metadata" />
