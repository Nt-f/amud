  "he:Yotzerot/Parashat Sekalim:1": {
   "kind": "heading",
   "en": "Yotzerot"
  },
  "he:Yotzerot/Parashat Sekalim:2": {
   "kind": "heading",
   "en": "Yotzer for Parashat Shekalim"
  },
  "he:Yotzerot/Parashat Sekalim:3": {
   "kind": "prayer"
  },
  "he:Yotzerot/Parashat Sekalim:4": {
   "kind": "prayer"
  },
  "he:Yotzerot/Parashat Sekalim:5": {
   "kind": "prayer"
  },
  "he:Yotzerot/Parashat Sekalim:6": {
   "kind": "prayer"
  },
  "he:Yotzerot/Parashat Sekalim:7": {
   "parts": [
    {
     "text": "<b><b><small>חזן:</small>",
     "kind": "speaker",
     "en": "Chazzan:",
     "gloss": "Chazzan leads this line"
    },
    {
     "text": " <b>כָּפְרָם</b> פָּץ תֵּת לְאֻמִּים מַשְׂאֵת. לְנַטְּלָם לְנַשְּׂאָם בְּכִי תִשָּׂא אֶת: </b></b>",
     "kind": "prayer",
     "role": "chazzan"
    }
   ]
  },
  "he:Yotzerot/Parashat Sekalim:8": {
   "kind": "prayer",
   "role": "congregation"
  },
  "he:Yotzerot/Parashat Sekalim:9": {
   "parts": [
    {
     "text": "<b><b><small>חזן:</small>",
     "kind": "speaker",
     "en": "Chazzan:",
     "gloss": "Chazzan leads this line"
    },
    {
     "text": " <b>אַהֲבָה</b> עַל כָּל פֶּשַׁע כִּסִּיתָ. בְּגִין צֵל יְמִינְךָ לְגוֹנְנִי הִתְנַשֵּׂאתָ:</b></b>",
     "kind": "prayer",
     "role": "chazzan"
    }
   ]
  },
  "he:Yotzerot/Parashat Sekalim:10": {
   "kind": "prayer",
   "role": "congregation"
  },
  "he:Yotzerot/Parashat Sekalim:11": {
   "kind": "prayer"
  },
  "he:Yotzerot/Parashat Sekalim:12": {
   "kind": "prayer"
  },
  "he:Yotzerot/Parashat Sekalim:13": {
   "kind": "prayer"
  },
  "he:Yotzerot/Parashat Sekalim:14": {
   "parts": [
    {
     "text": "<b><b><small>חזן:</small>",
     "kind": "speaker",
     "en": "Chazzan:",
     "gloss": "Chazzan leads this line"
    },
    {
     "text": " <b>צוּרַת</b> מַטְבֵּעַ כְּחָז אֲבִי חוֹזֶה. צִוָּה צוּר לְצִיר כֵּן תֵּת מַתַּן זֶה: </b></b>",
     "kind": "prayer",
     "role": "chazzan"
    }
   ]
  },
  "he:Yotzerot/Parashat Sekalim:15": {
   "kind": "prayer",
   "role": "congregation"
  },
  "he:Yotzerot/Parashat Sekalim:16": {
   "parts": [
    {
     "text": "<b><b><small>חזן:</small>",
     "kind": "speaker",
     "en": "Chazzan:",
     "gloss": "Chazzan leads this line"
    },
    {
     "text": " <b>יָעִיר</b> וְיַחֲשׂוֹף זְרוֹעַ וְיַד מִמְּתִים. בְּזִיל נִטְפֵי לֶקֶשׁ לְהַחֲיוֹת מֵתִים:</b></b>",
     "kind": "prayer",
     "role": "chazzan"
    }
   ]
  },
  "he:Yotzerot/Parashat Sekalim:17": {
   "kind": "prayer",
   "role": "congregation"
  },
  "he:Yotzerot/Parashat Sekalim:18": {
   "kind": "prayer"
  },
  "he:Yotzerot/Parashat Sekalim:19": {
   "parts": [
    {
     "text": "<b><b><small>חזן:</small>",
     "kind": "speaker",
     "en": "Chazzan:",
     "gloss": "Chazzan leads this line"
    },
    {
     "text": " <b>שִׁקְלֵי</b> כֶסֶף כִּפּוּרִים כָּפְרָם לְהַדְבֵּר. שְׁמוּרִים לְזִכָּרוֹן תֵּת לְכָל הָעוֹבֵר:</b></b>",
     "kind": "prayer",
     "role": "chazzan"
    }
   ]
  },
  "he:Yotzerot/Parashat Sekalim:20": {
   "kind": "prayer",
   "role": "congregation"
  },
  "he:Yotzerot/Parashat Sekalim:21": {
   "parts": [
    {
     "text": "<b><b><small>חזן:</small>",
     "kind": "speaker",
     "en": "Chazzan:",
     "gloss": "Chazzan leads this line"
    },
    {
     "text": " <b>תְּכוּנָה</b> לְבֶדֶק הַבַּיִת וְכָל אִשִׁים. תֵּת בְּיַד הַכֹּהֲנִים כֶּסֶף הַקֳּדָשִׁים:</b></b>",
     "kind": "prayer",
     "role": "chazzan"
    }
   ]
  },
  "he:Yotzerot/Parashat Sekalim:22": {
   "kind": "prayer",
   "role": "congregation"
  },
  "he:Yotzerot/Parashat Sekalim:23": {
   "parts": [
    {
     "text": "<b><b><small>חזן:</small>",
     "kind": "speaker",
     "en": "Chazzan:",
     "gloss": "Chazzan leads this line"
    },
    {
     "text": " <b>תִּקְרָא</b> דְרוֹר כְּמֵאָז בּוֹ לְהַחְפִּישֵׁנוּ. תֵּת הֲמוֹן לְאֻמִּים תַּחַת נַפְשֵׁנוּ:</b></b>",
     "kind": "prayer",
     "role": "chazzan"
    }
   ]
  },
  "he:Yotzerot/Parashat Sekalim:24": {
   "kind": "prayer",
   "role": "congregation"
  },
  "he:Yotzerot/Parashat Sekalim:25": {
   "parts": [
    {
     "text": "<b><b><small>חזן:</small>",
     "kind": "speaker",
     "en": "Chazzan:",
     "gloss": "Chazzan leads this line"
    },
    {
     "text": " <b>תּוֹקֶף</b> עוֹז אִדְּרוּךָ עַל יָם. תִּזְכּוֹר לְעָם מִסְפָּרָם כְּחוֹל הַיָּם. </b></b>",
     "kind": "prayer",
     "role": "chazzan"
    }
   ]
  },
  "he:Yotzerot/Parashat Sekalim:26": {
   "parts": [
    {
     "text": "<b><b><small>חו\"ק:</small>",
     "kind": "speaker",
     "en": "Congregation:",
     "gloss": "Congregation responds"
    },
    {
     "text": " <b>יִמְלוֹךְ</b> יְהֹוָה לְעוֹלָם אֱלֹהַיִךְ צִיוֹן לְדוֹר וָדוֹר הַלְלוּיָהּ: וְאַתָּה קָדוֹשׁ יוֹשֵׁב תְּהִלּוֹת יִשְׂרָאֵל אֵל נָא:</b></b>",
     "kind": "prayer",
     "role": "congregation"
    }
   ]
  },
  "he:Yotzerot/Parashat Sekalim:27": {
   "kind": "prayer"
  },
  "he:Yotzerot/Parashat Sekalim:28": {
   "parts": [
    {
     "text": "<b><b><small>חו\"ק:</small>",
     "kind": "speaker",
     "en": "Congregation:",
     "gloss": "Congregation responds"
    },
    {
     "text": " <b>חַי</b> וְקַיָם נוֹרָא וּמָרוֹם וְקָדוֹשׁ:</b></b>",
     "kind": "prayer",
     "role": "congregation"
    }
   ]
  },
  "he:Yotzerot/Parashat Sekalim:29": {
   "kind": "prayer"
  },
  "he:Yotzerot/Parashat Sekalim:30": {
   "parts": [
    {
     "text": "<b><b><small>חזן:</small>",
     "kind": "speaker",
     "en": "Chazzan:",
     "gloss": "Chazzan leads this line"
    },
    {
     "text": " <b>רַחוּם</b> כְּרִחַמְתָּ נְשׂוּאֶיךָ בְּכֶסֶף כִּפּוּרִים. כֵּן שְׁעֵה שְׂפָתֵינוּ בְּשִׁלּוּם פָּרִים:</b></b>",
     "kind": "prayer",
     "role": "chazzan"
    }
   ]
  },
  "he:Yotzerot/Parashat Sekalim:31": {
   "kind": "prayer"
  },
  "he:Yotzerot/Parashat Sekalim:32": {
   "parts": [
    {
     "text": "<b><b><small>חו\"ק:</small>",
     "kind": "speaker",
     "en": "Congregation:",
     "gloss": "Congregation responds"
    },
    {
     "text": " <b>עַד</b> אֶשָּׂא רֹאשׁ. כְּמוֹ מֵרֹאשׁ. לְהַקְדִּישׁ לְקָדוֹשׁ:</b></b>",
     "kind": "prayer",
     "role": "congregation"
    }
   ]
  },
  "he:Yotzerot/Parashat Sekalim:33": {
   "parts": [
    {
     "text": "<b><b><small>חו\"ק:</small>",
     "kind": "speaker",
     "en": "Congregation:",
     "gloss": "Congregation responds"
    },
    {
     "text": " <b>עַד</b> בְּמֹאזְנֵי צֶדֶק. יַכְרִיעֵנִי לְצֶדֶק. נוֹרָא וְקָדוֹשׁ:</b></b>",
     "kind": "prayer",
     "role": "congregation"
    }
   ]
  },
  "he:Yotzerot/Parashat Sekalim:34": {
   "kind": "prayer"
  },
  "he:Yotzerot/Parashat Sekalim:35": {
   "parts": [
    {
     "text": "<b><b><small>חזן:</small>",
     "kind": "speaker",
     "en": "Chazzan:",
     "gloss": "Chazzan leads this line"
    },
    {
     "text": " <b>עַד</b> אֶשָׂא רֹאשׁ. כְּמוֹ מֵרֹאשׁ. לְהַקְדִּישׁ לְקָדוֹשׁ:</b></b>",
     "kind": "prayer",
     "role": "chazzan"
    }
   ]
  },
  "he:Yotzerot/Parashat Sekalim:36": {
   "kind": "prayer"
  },
  "he:Yotzerot/Parashat Sekalim:37": {
   "kind": "prayer"
  },
  "he:Yotzerot/Parashat Sekalim:38": {
   "kind": "prayer"
  },
  "he:Yotzerot/Parashat Sekalim:39": {
   "kind": "prayer"
  },
  "he:Yotzerot/Parashat Sekalim:40": {
   "kind": "prayer"
  },
  "he:Yotzerot/Parashat Sekalim:41": {
   "parts": [
    {
     "text": "<b>וּכְמוֹ</b> נִתַּן חֶשְׁבּוֹן עַל כֹּל. כֵּן נִתַּן מִשְׁקַל וָפֶלֶס לַכֹּל. מַתְחִיל מִכִּכָּר עַד פְּרוּטָה הַקְטַנָּה: כִּכָּר הַגָּדוֹל כְּגֹדֶל שְׁנֵי מָנֶה. ",
     "kind": "prayer"
    },
    {
     "text": "<small> <small>(נוסח הגר\"א כִּכָּר הַגָּדוֹל כְּגֹדֶל שִׁשִּׁים מָנֶה,",
     "kind": "prayer"
    },
    {
     "text": " וְהַמָּנֶה מִתְחַשֵּׁב בְּעֶשְׂרִים וְחָמֵשׁ סֶלַע וְהַסֶּלַע וכו' כי בקע ושקל הכל אחד)</small>",
     "kind": "prayer"
    },
    {
     "text": " </small>,",
     "kind": "prayer"
    },
    {
     "text": " וְהַמָּנֶה עוֹלֶה עַד שִׁשִׁים שֶׁקֶל. וְהַשֶׁקֶל מִתְחַשֵׁב בְּעֶשְׂרִים וְחָמֵשׁ סֶלַע. וְהַסֶּלַע חֶצְיוֹ בֶּקַע וּרְבִיעַ זוּז. וְהַזוּז מִתְחַלֵק לְפֶלֶג וְחוֹמְשׁוֹ מָעָה. נִמְצָא הַזוּז חָמֵשׁ מָעוֹת כֶּסֶף. וְהַמָּעָה שְׁתֵּי פוּנְדְּיוֹנוֹת. בְּאִסָּר דָת. וְהָאִסָּר עוֹלֶה עַד שְׁמוֹנֶה פְּרוּטוֹת. נִמְצָא הַבֶּקַע כְּאַרְבַּע מֵאוֹת פְּרוּטוֹת. וְהֵם בִּכְתָב חֲרוּטוֹת. וּבְפֶה מְפוֹרָטוֹת: ",
     "kind": "prayer"
    }
   ]
  },
