  },
  "he:Festivals/Selichot/Ten of Tevet:43": {
   "parts": [
    {
     "kind": "prayer",
     "node": "tachanun.yud_gimmel_middot",
     "role": "chazzan_then_congregation",
     "minyan": true,
     "text": "יְהֹוָה יְהֹוָה אֵל רַחוּם וְחַנּוּן אֶרֶךְ אַפַּיִם וְרַב חֶסֶד וֶאֱמֶת: נֹצֵר חֶסֶד לָאֲלָפִים נֹשֵׂא עָוֹן וָפֶשַׁע וְחַטָּאָה וְנַקֵּה: וְסָלַחְתָּ לַעֲוֹנֵנוּ וּלְחַטָּאתֵנוּ וּנְחַלְתָּנוּ: "
    },
    {
     "kind": "prayer",
     "node": "selichot.fast_day",
     "text": "סְלַח לָנוּ אָבִינוּ כִּי חָטָאנוּ מְחַל לָנוּ מַלְכֵּנוּ כִּי פָשָׁעְנוּ: כִּי אַתָּה אֲדֹנָי טוֹב וְסַלָּח וְרַב חֶסֶד לְכָל קֹרְאֶיךָ: "
    }
   ]
  },
  "he:Festivals/Selichot/Ten of Tevet:28": {
   "parts": [
    {
     "kind": "instruction",
     "en": "Refrain: \"Avotai\"",
     "node": "x.selichot.piyyut",
     "text": "אבותי:"
    },
    {
     "kind": "prayer",
     "node": "x.selichot.piyyut",
     "text": " רֵאשִׁית בִּכּוּרָה לְרֵאשִׁית הַחֵרֶם. שֵׁם אֲחֵרִים הִזְכִּירָה וְהֶעָוֹן גּוֹרֵם. פְּנֵי אֵל לֹא הִכִּירָה וְשֻׁטְּפָה בְזֶרֶם. צָרָה כְּמַבְכִּירָה כָּעֵת בַּמָּרוֹם תַּמְרִיא. "
    }
   ]
  },
  "he:Festivals/Selichot/Ten of Tevet:29": {
   "parts": [
    {
     "kind": "instruction",
     "en": "Refrain: \"Avotai\"",
     "node": "x.selichot.piyyut",
     "text": "אבותי:"
    },
    {
     "kind": "prayer",
     "node": "x.selichot.piyyut",
     "text": " אֱלֹהִים הֵבִיא יוֹם רָעָה וּמָצוֹר. צִוָּה צָרַי סְבִיבַי עוֹלָלַי לִבְצוֹר. יוֹם הֵרַךְ לְבָבִי. וְאֵין כֹּחַ לַעֲצוֹר. וְדִבֶּר אֶל נָבִיא. מְשׁוֹל אֶל בֵּית הַמֶּרִי. "
    }
   ]
  },
  "he:Festivals/Selichot/Ten of Tevet:30": {
   "parts": [
    {
     "kind": "instruction",
     "en": "Refrain: \"Avotai\"",
     "node": "x.selichot.piyyut",
     "text": "אבותי:"
    },
    {
     "kind": "prayer",
     "node": "x.selichot.piyyut",
     "text": " מִיּשְׁבֵי שַׁעַר הֶעֱבִיר אַדֶּרֶת. חֲמָתוֹ כָּאֵשׁ הִבְעִיר וְהֵרִים עֲטֶרֶת. וּמִלְּבָנוֹן יַעַר הִשְׁלִיךְ תִּפְאֶרֶת. וְרוּחַ סוֹעָה וָסַעַר תְּסַמֵּר שַׂעֲרַת בְּשָׂרִי. "
    }
   ]
  },
  "he:Festivals/Selichot/Ten of Tevet:31": {
   "parts": [
    {
     "kind": "instruction",
     "en": "Refrain: \"Avotai\"",
     "node": "x.selichot.piyyut",
     "text": "אבותי:"
    },
    {
     "kind": "prayer",
     "node": "x.selichot.piyyut",
     "text": " יָפְיָפִית נִמְשַׁלְתְּ. וְעַתָּה קְדוֹרַנִית. בֶּעָוֹן כִּי כָשַׁלְתְּ. וְלִבֵּךְ אֲחוֹרַנִית. זִנְּבוּךְ וְנֶחֱשַׁלְתְּ. רִאשׁוֹנָה וְשֵׁנִית. וְהָחְתֵּל לֹא חֻתַּלְתְּ. מְעַט צֳרִי. "
    }
   ]
  },
  "he:Festivals/Selichot/Ten of Tevet:32": {
   "parts": [
    {
     "kind": "instruction",
     "en": "Refrain: \"Avotai\"",
     "node": "x.selichot.piyyut",
     "text": "אבותי:"
    },
    {
     "kind": "prayer",
     "node": "x.selichot.piyyut",
     "text": " צַדִּיק הַצּוּר תָּם. נְשׂוֹא עָוֹן נִלְאָה. מִכְּרוּב לְמִפְתָּן לְפִנַּת גַּג דָּאָה. מֵעָוֹן הַנִּכְתָּם. וְצַעֲקָתָם בָּאָה. רַבָּה רָעָתָם כְּעֵץ עֹשֶׂה פֶּרִי. "
    }
   ]
  },
  "he:Festivals/Selichot/Ten of Tevet:33": {
   "parts": [
    {
     "kind": "instruction",
     "en": "Refrain: \"Avotai\"",
     "node": "x.selichot.piyyut",
     "text": "אבותי:"
    },
    {
     "kind": "prayer",
     "node": "x.selichot.piyyut",
     "text": " חִזֵּק כָּל קָמַי תּוֹכֵן הָעֲלִילוֹת. כִּי מָלְאוּ יָמַי בְּרוֹעַ מִפְעָלוֹת. וּמִבֹּשֶׁת עֲלוּמַי שָׁכַחְתִּי גְמוּלוֹת. נוֹתֵן לַחְמִי וּמֵימַי פִּשְׁתִּי וְצַמְרִי. "
    }
   ]
  },
  "he:Festivals/Selichot/Ten of Tevet:34": {
   "parts": [
    {
     "kind": "instruction",
     "en": "Refrain: \"Avotai\"",
     "node": "x.selichot.piyyut",
     "text": "אבותי:"
    },
    {
     "kind": "prayer",
     "node": "x.selichot.piyyut",
     "text": " קָמַי פִּיהֶם פָּעֲרוּ וְנַחֲלָתִי בִּלֵּעוּ. מְאֹד עָלַי גָּבָרוּ וְדָמִי שָׁתוּ וְלָעוּ. נָכְרִים עָלַי צָרוּ וְאֶת אַחַי הֵרֵעוּ. הָאוֹמְרִים עָרוּ עָרוּ בְּנֵי שֵׂעִיר הַחוֹרִי. "
    }
   ]
  },
  "he:Festivals/Selichot/Ten of Tevet:35": {
   "parts": [
    {
     "kind": "instruction",
     "en": "Refrain: \"Avotai\"",
     "node": "x.selichot.piyyut",
     "text": "אבותי:"
    },
    {
     "kind": "prayer",
     "node": "x.selichot.piyyut",
     "text": " אְָמְרוּ לְכוּ נְכַלֵּם וְנַשְׁבִּיתָה זִכְרָם. אֵל קַנֹּא וְנוֹקֵם גָּמְלֵם יִשְׂאוּ אֶת שִׁבְרָם. כְּמַעֲשֵׂיהֶם שַׁלֵּם וְיֵבֹשׁוּ מִשִּׂבְרָם. כְּאִישׁ חֲלוֹם חוֹלֵם שְׁלֹשָׁה סַלֵּי חוֹרִי. "
    }
   ]
  },
  "he:Festivals/Selichot/Ten of Tevet:36": {
   "parts": [
    {
     "kind": "instruction",
     "en": "Refrain: \"Avotai\"",
     "node": "x.selichot.piyyut",
     "text": "אבותי:"
    },
    {
     "kind": "prayer",
     "node": "x.selichot.piyyut",
     "text": " פִּצְעִי לֹא רֻכָּכָה וְחַבּוּרוֹתַי רֶצַח. וְעֵינִי הֻכְהָתָה צוֹפָה לְדוֹדִי צַח. הַעוֹד לֹא שָׁכָכָה חֲמָתוֹ לָנֶצַח. עַל מֶה עָשָׂה כָּכָה וּמֶה חֳרִי. "
    }
   ]
  },
  "he:Festivals/Selichot/Ten of Tevet:37": {
   "parts": [
    {
     "kind": "instruction",
     "en": "Refrain: \"Avotai\"",
     "node": "x.selichot.piyyut",
     "text": "אבותי:"
    },
    {
     "kind": "prayer",
     "node": "x.selichot.piyyut",
     "text": " רַחוּם זֶה אֵלִי אַל לָעַד תִּזְנַח. אָרְכוּ יְמֵי אֶבְלִי וְעוֹד לִבִּי נֶאֱנַח. שׁוּבָה אֵל לְאָהֳלִי מְקוֹמְךָ אַל תַּנַּח. שַׁלֵּם יְמֵי אֶבְלִי כִּי תָבֹא עַל שְׂכָרִי. "
    }
   ]
  },
  "he:Festivals/Selichot/Ten of Tevet:38": {
   "parts": [
    {
     "kind": "instruction",
     "en": "Refrain: \"Avotai\"",
     "node": "x.selichot.piyyut",
     "text": "אבותי:"
    },
    {
     "kind": "prayer",
     "node": "x.selichot.piyyut",
     "text": " יְהֹוָה מְנָת חֶלְקִי חוּשָׁה לִי לְעֶזְרָה. וּפִתַּחְתָּ שַׂקִּי שִׂמְחָה לִי לְאַזְּרָה. וְתַגִּיהַּ אֶת חָשְׁכִּי בְאוֹרְךָ לְהָאִירָה. אֶת נֶשֶׁף חִשְׁקִי כִּי אַתָּה נֵרִי. "
    }
   ]
  },
  "he:Festivals/Selichot/Ten of Tevet:39": {
   "parts": [
    {
     "kind": "instruction",
     "en": "Refrain: \"Avotai\"",
     "node": "x.selichot.piyyut",
     "text": "אבותי:"
    },
    {
     "kind": "prayer",
     "node": "x.selichot.piyyut",
     "text": " מִיָּגוֹן וַאֲנָחָה פְּדֵה אֵל אֶת נַפְשִׁי. עֲשֵׂה לְעַמְּךָ הֲנָחָה. מַלְכִּי וּקְדוֹשִׁי. תַּהֲפוֹךְ לָרְוָחָה. אֶת צוֹם הַחֲמִישִׁי. לְשָׂשׂוֹן וּלְשִׂמְחָה. צוֹם הָרְבִיעִי וְצוֹם הָעֲשִׂירִי. "
    }
   ]
  },
