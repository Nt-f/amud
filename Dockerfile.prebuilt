# Deploys the PRECOMPILED web app from web-dist/ — no Flutter SDK needed.
#   docker build -f Dockerfile.prebuilt -t flutter-siddur .
#   docker run -d -p 8088:8088 flutter-siddur   → http://localhost:8088
# Rebuild web-dist/ with tool/build_web.sh, or just use the default Dockerfile.
FROM nginx:1.29-alpine
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY web-dist/ /usr/share/nginx/html/
EXPOSE 8088
HEALTHCHECK --interval=30s --timeout=3s CMD wget -qO- http://127.0.0.1:8088/ >/dev/null || exit 1
