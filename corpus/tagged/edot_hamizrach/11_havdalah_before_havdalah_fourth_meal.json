   "kind": "instruction",
   "en": "When blessing over the candle, bend the tips of the right fingers into the palm, with the thumb covered under the four fingers, and bent before the candle and before oneself (O.C. 296, 675)."
  },
  "he:Havdalah/Havdala:14": {
   "kind": "prayer"
  },
  "he:Havdalah/Havdala:15": {
   "kind": "prayer"
  },
  "he:Havdalah/Havdala:16": {
