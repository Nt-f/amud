     ]
    },
    {
     "text": " חַיִּים,",
     "kind": "prayer",
     "node": "amidah.birkat_kohanim",
     "role": "chazzan",
     "voice": "aloud",
     "minyan": true,
     "gestures": [
      "raise_hands"
     ]
    },
    {
     "text": " חֵן וָחֶסֶד,",
     "kind": "prayer",
     "node": "amidah.birkat_kohanim",
     "role": "chazzan",
     "voice": "aloud",
     "minyan": true,
     "gestures": [
      "raise_hands"
     ]
    },
    {
     "text": " וְרַחֲמִים,",
     "kind": "prayer",
     "node": "amidah.birkat_kohanim",
     "role": "chazzan",
     "voice": "aloud",
     "minyan": true,
     "gestures": [
      "raise_hands"
     ]
    },
    {
     "text": " עָלֵינוּ וְעַל כָּל יִשְׂרָאֵל עַמֶּךָ. בָּרְכֵנוּ אָבִינוּ,",
     "kind": "prayer",
     "node": "amidah.birkat_kohanim",
     "role": "chazzan",
     "voice": "aloud",
     "minyan": true,
     "gestures": [
      "raise_hands"
     ]
    },
    {
     "text": " כֻּלָּנוּ כְּאֶחָד ",
     "kind": "prayer",
     "node": "amidah.birkat_kohanim",
     "role": "chazzan",
     "voice": "aloud",
     "minyan": true,
     "gestures": [
      "raise_hands"
     ]
    },
    {
     "text": "<small>(יַחַד)</small>",
     "kind": "prayer",
     "node": "amidah.birkat_kohanim",
     "role": "chazzan",
     "voice": "aloud",
     "minyan": true,
     "gestures": [
      "raise_hands"
     ]
    },
    {
     "text": " בְּאוֹר פָּנֶיךָ,",
     "kind": "prayer",
     "node": "amidah.birkat_kohanim",
     "role": "chazzan",
     "voice": "aloud",
     "minyan": true,
     "gestures": [
      "raise_hands"
     ]
    },
    {
     "text": " כִּי בְאוֹר פָּנֶיךָ נָתַתָּ לָּנוּ יְהֹוָה אֱלֹהֵינוּ,",
     "kind": "prayer",
     "node": "amidah.birkat_kohanim",
     "role": "chazzan",
     "voice": "aloud",
     "minyan": true,
     "gestures": [
      "raise_hands"
     ]
    },
    {
     "text": " תּוֹרַת חַיִּים,",
     "kind": "prayer",
     "node": "amidah.birkat_kohanim",
     "role": "chazzan",
     "voice": "aloud",
     "minyan": true,
     "gestures": [
      "raise_hands"
     ]
    },
    {
     "text": " וְאַהֲבַת חֶסֶד,",
     "kind": "prayer",
     "node": "amidah.birkat_kohanim",
     "role": "chazzan",
     "voice": "aloud",
     "minyan": true,
     "gestures": [
      "raise_hands"
     ]
    },
    {
     "text": " וּצְדָקָה וּבְרָכָה וְרַחֲמִים,",
     "kind": "prayer",
     "node": "amidah.birkat_kohanim",
     "role": "chazzan",
     "voice": "aloud",
     "minyan": true,
     "gestures": [
      "raise_hands"
     ]
    },
    {
     "text": " וְחַיִּים וְשָׁלוֹם. ",
     "kind": "prayer",
     "node": "amidah.birkat_kohanim",
     "role": "chazzan",
     "voice": "aloud",
     "minyan": true,
     "gestures": [
      "raise_hands"
     ]
    },
    {
     "text": "<small>(וְכָל טוּב)</small>",
     "kind": "prayer",
     "node": "amidah.birkat_kohanim",
     "role": "chazzan",
     "voice": "aloud",
     "minyan": true,
     "gestures": [
      "raise_hands"
     ]
    },
    {
     "text": " וְטוֹב יִהְיֶה בְּעֵינֶיךָ לְבָרְכֵנוּ וּלְבָרֵךְ אֶת כָּל עַמְּךָ יִשְׂרָאֵל בְּכָל עֵת וּבְכָל שָׁעָה בִּשְׁלוֹמֶךָ,",
     "kind": "prayer",
     "node": "amidah.birkat_kohanim",
     "role": "chazzan",
     "voice": "aloud",
     "minyan": true,
     "gestures": [
      "raise_hands"
     ]
    },
    {
     "text": " בְּרֹב עֹז וְשָׁלוֹם. ",
     "kind": "prayer",
     "node": "amidah.birkat_kohanim",
     "role": "chazzan",
     "voice": "aloud",
