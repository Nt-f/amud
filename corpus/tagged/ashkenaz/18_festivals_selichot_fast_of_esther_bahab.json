  "he:Festivals/Selichot/Fast of Esther:26": {
   "kind": "prayer",
   "node": "x.selichot.piyyut"
  },
  "he:Festivals/Selichot/Fast of Esther:27": {
   "parts": [
    {
     "text": "במתי: ",
     "kind": "instruction",
     "en": "Refrain: \"במתי\"",
     "node": "x.selichot.piyyut"
    },
    {
     "kind": "prayer",
     "node": "x.selichot.piyyut",
     "text": "צָר וְאוֹיֵב הִלְטִישׁ עֵינָיו. פִּיהוּ פָעַר לִשְׁאוֹף עָנָיו. עִשֵּׁת בְּשֶׁלּוֹ לְהַשְׁמִיד קְהַל הֲמוֹנָיו. סֶגֶל לְאַבֵּד חָרַת בְּנִשְׁתְּוָנָיו. "
    }
   ]
  },
  "he:Festivals/Selichot/Fast of Esther:28": {
   "parts": [
    {
     "text": "במתי: ",
     "kind": "instruction",
     "en": "Refrain: \"במתי\"",
     "node": "x.selichot.piyyut"
    },
    {
     "kind": "prayer",
     "node": "x.selichot.piyyut",
     "text": "נוֹקֵם לְצָרִים וְנוֹטֵר לְאוֹיְבִים. מָדַדְתָּ מִדָּתָם כְּזָדוּ לַאֲהוּבִים. לוֹחֵם וְנִינָיו הוּתְלוּ מֻצְלָבִים. כְּבַחֲרוֹזֶת דָּגִים חוֹרְזוּ תְּחוּבִים. "
    }
   ]
  },
  "he:Festivals/Selichot/Fast of Esther:29": {
   "parts": [
    {
     "text": "במתי: ",
     "kind": "instruction",
     "en": "Refrain: \"במתי\"",
     "node": "x.selichot.piyyut"
    },
    {
     "kind": "prayer",
     "node": "x.selichot.piyyut",
     "text": "יוֹם אֲשֶׁר שִׂבְּרוּ צוֹרְרִים. טִבְחָה לָשִׁית בְּעַם נְצוּרִים. חֻלְּפָה הַדָּת וְנָפְלוּ פְגָרִים. זֻלְעֲפוּ זוֹעֲמוּ מוּבָסִים מֻגָרִים. "
    }
   ]
  },
  "he:Festivals/Selichot/Fast of Esther:30": {
   "parts": [
    {
     "text": "במתי: ",
     "kind": "instruction",
     "en": "Refrain: \"במתי\"",
     "node": "x.selichot.piyyut"
    },
    {
     "kind": "prayer",
     "node": "x.selichot.piyyut",
     "text": "וּבְכֵן יִתְעַלֶּה שִׁמְךָ וְיִתְנַשֵּׂא. הוֹדְךָ שְׁמֵי שָׁמַיִם כִּסָּה. דַּכִּים בְּרוֹמִמְךָ נְתוּנִים לִמְשִׁסָּה. גֵּיא וַאֲפָסֶיהָ תְּהִלָּתְךָ מְכַסָּה. "
    }
   ]
  },
  "he:Festivals/Selichot/Fast of Esther:31": {
   "parts": [
    {
     "text": "במתי: ",
     "kind": "instruction",
     "en": "Refrain: \"במתי\"",
     "node": "x.selichot.piyyut"
    },
    {
     "kind": "prayer",
     "node": "x.selichot.piyyut",
     "text": "בִּינָה הֲגִינֵנוּ עַתָּה וּרְאֵה בַצָּר. בְּאַפְּךָ קוּמָה עַל צוֹרֵר הַצָּר. אָדוֹן קְרָאנוּךָ מִן הַמֵּצָר. אָנָּא הוֹצִיאֵנוּ לַמֶּרְחָב וְחַלְּצֵנוּ מִצָּר. "
    }
   ]
  },
  "he:Festivals/Selichot/Fast of Esther:32": {
   "parts": [
    {
     "text": "במתי: ",
     "kind": "instruction",
     "en": "Refrain: \"במתי\"",
     "node": "x.selichot.piyyut"
    },
    {
     "kind": "prayer",
     "node": "x.selichot.piyyut",
     "text": "מְאֹד תַּרְבֶּה לָנוּ מְחִילָה. שְׁמַע תְּפִלָּה וְהַעֲבֵר תִּפְלָה. לוֹחֲצֵינוּ יַשְׁלִימוּ אִתָּנוּ וַעֲוֹנוֹתֵינוּ תַשְׁלִיךְ בִּמְצוּלָה. מִמֶּנּוּ רַחֲמֶיךָ לֹא תִכְלָא "
    }
   ]
  },
