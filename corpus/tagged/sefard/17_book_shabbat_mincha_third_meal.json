  "he:Shabbat Mincha/Pirkei Avot:3:18": {
   "parts": [
    {
     "text": "<b>יח</b> הוּא הָיָה אוֹמֵר,",
     "kind": "prayer"
    },
    {
     "text": " חָבִיב אָדָם שֶׁנִּבְרָא בְצֶלֶם,",
     "kind": "prayer"
    },
    {
     "text": " חִבָּה יְתֵרָה נוֹדַעַת לוֹ שֶׁנִּבְרָא בְצֶלֶם,",
     "kind": "prayer"
    },
    {
     "text": " שֶׁנֶּאֱמַר: כִּי בְצֶלֶם אֱלֹהִים עָשָׂה אֶת הָאָדָם. חֲבִיבִין יִשְׂרָאֵל שֶׁנִּקְרְאוֹ בָנִים לַמָּקוֹם,",
     "kind": "prayer"
    },
    {
     "text": " חִבָּה יְתֵרָה נוֹדַעַת לָהֶם שֶׁנִּקְרְאוֹ בָנִים לַמָּקוֹם,",
     "kind": "prayer"
    },
    {
     "text": " שֶׁנֶּאֱמַר: בָּנִים אַתֶּם לַיהֹוָה ",
     "kind": "prayer"
    },
    {
     "text": "<small>צריך לקרוא <small>לַדוֹנָי</small>",
     "kind": "instruction",
     "en": "Must read 'Ladoni'"
    },
    {
     "text": "</small> אֱלֹהֵיכֶם. חֲבִיבִין יִשְׂרָאֵל שֶׁנִּתַּן לָהֶם כְּלִי חֶמְדָּה. חִבָּה יְתֵרָה נוֹדַעַת לָהֶם,",
     "kind": "prayer"
    },
    {
     "text": " שֶׁנִּתַּן לָהֶם כְּלִי חֶמְדָּה שֶׁבּוֹ נִבְרָא הָעוֹלָם,",
     "kind": "prayer"
    },
    {
     "text": " שֶׁנֶּאֱמַר: כִּי לֶקַח טוֹב נָתַתִּי לָכֶם. תּוֹרָתִי אַל תַּעֲזֹבוּ: ",
     "kind": "prayer"
    }
   ]
  },
