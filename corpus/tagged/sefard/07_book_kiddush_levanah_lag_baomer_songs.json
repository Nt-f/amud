  "he:Kiddush Levanah:1": {
   "kind": "heading",
   "en": "Kiddush Levanah"
  },
  "he:Kiddush Levanah:2": {
   "kind": "instruction",
   "en": "The main Kiddush Levanah, according to the Ari, is recited after seven days have passed since the molad. From the eighth day onward is the time for Kiddush Levanah. One should recite it in fine garments and with joy, for it is the reception of the Shechinah. Stand with feet straight facing due east. When you reach 'Baruch Yotzarch', turn your face toward the moon."
  },
  "he:Kiddush Levanah:3": {
   "kind": "prayer"
  },
  "he:Kiddush Levanah:4": {
   "kind": "prayer"
  },
  "he:Kiddush Levanah:5": {
   "kind": "instruction",
   "en": "Turn your face east, straighten your feet, and look at the moon once before beginning the blessing. Afterward, do not look at it at all."
  },
  "he:Kiddush Levanah:6": {
   "kind": "prayer"
  },
  "he:Kiddush Levanah:7": {
   "parts": [
    {
     "text": "<small><small>(ג\"פ:)</small>",
     "kind": "instruction",
     "en": "(Three times:)",
     "gloss": "Said three times"
    },
    {
     "text": "</small> <b>בָּרוּךְ</b> יוצְרֵךְ בָּרוּךְ עוֹשֵׂךְ בָּרוּךְ קוֹנֵךְ בָּרוּךְ בּוֹרְאֵךְ: ",
     "kind": "prayer",
     "repeat": 3
    }
   ]
  },
  "he:Kiddush Levanah:8": {
   "kind": "instruction",
   "en": "And dance three times, saying three times:"
  },
  "he:Kiddush Levanah:9": {
   "kind": "prayer"
  },
  "he:Kiddush Levanah:10": {
   "parts": [
    {
     "text": "<small><small>(ג\"פ:)</small>",
     "kind": "instruction",
     "en": "(Three times:)",
     "gloss": "Said three times"
    },
    {
     "text": "</small> <b>תִּפֹּל</b> עֲלֵיהֶם אֵימָתָה וָפַחַד בִּגְדֹל זְרוֹעֲךָ יִדְּמוּ כָּאָבֶן: ",
     "kind": "prayer",
     "repeat": 3
    }
   ]
  },
  "he:Kiddush Levanah:11": {
   "parts": [
    {
     "text": "<small><small>(ג\"פ:)</small>",
     "kind": "instruction",
     "en": "(Three times:)",
     "gloss": "Said three times"
    },
    {
     "text": "</small> <b>כָּאָבֶן</b> יִדְּמוּ זְרוֹעֲךָ בִּגְדֹל וָפַחַד אֵימָתָה עֲלֵיהֶם תִּפֹּל: ",
     "kind": "prayer",
     "repeat": 3
    }
   ]
  },
  "he:Kiddush Levanah:12": {
   "parts": [
    {
     "text": "<small><small>(ג\"פ:)</small>",
     "kind": "instruction",
     "en": "(Three times:)",
     "gloss": "Said three times"
    },
    {
     "text": "</small> <b>דָּוִד</b> מֶלֶךְ יִשְׂרָאֵל חַי וְקַיָּם: ",
     "kind": "prayer",
     "repeat": 3
    }
   ]
  },
  "he:Kiddush Levanah:13": {
   "parts": [
    {
     "text": "<small><small>(ואומר לחבירו ג\"פ:)</small>",
     "kind": "instruction",
     "en": "(And say to a friend three times:)",
     "gloss": "Said to a friend three times"
    },
    {
     "text": "</small> <b>שָׁלוֹם עֲלֵיכֶם: </b>",
     "kind": "prayer",
     "repeat": 3
    }
   ]
  },
  "he:Kiddush Levanah:14": {
   "parts": [
    {
     "text": "<small><small>(ואומר לחבירו ג\"פ:)</small>",
     "kind": "instruction",
