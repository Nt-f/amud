  "he:Yotzerot/Shabbat HaGadol:6": {
   "parts": [
    {
     "text": "<b><b><small>חזן:</small>",
     "kind": "speaker",
     "en": "Chazzan:",
     "role": "chazzan"
    },
    {
     "text": " <b>כִּתַּרְתָּ</b> כְלִיל לְנֶפֶשׁ מְשִׁיבַת. לְשֶׁעָבַר קִדַּמְתָּ מַתַּן שַׁבָּת:</b></b>",
     "kind": "prayer",
     "role": "chazzan",
     "voice": "aloud"
    }
   ]
  },
  "he:Yotzerot/Shabbat HaGadol:7": {
   "kind": "prayer",
   "role": "congregation",
   "voice": "aloud"
  },
  "he:Yotzerot/Shabbat HaGadol:8": {
   "parts": [
    {
     "text": "<b><b><small>חזן:</small>",
     "kind": "speaker",
     "en": "Chazzan:",
     "role": "chazzan"
    },
    {
     "text": " <b>סַכּוֹתָה</b> לְרֹאשִׁי לְהַשְׁאִיר פָּלִיט. גָּנוֹן וְהִצִיל פָּסוֹחַ וְהִמְלִיט:</b></b>",
     "kind": "prayer",
     "role": "chazzan",
     "voice": "aloud"
    }
   ]
  },
  "he:Yotzerot/Shabbat HaGadol:9": {
   "kind": "prayer",
   "node": "shema.yotzer_or"
  },
  "he:Yotzerot/Shabbat HaGadol:10": {
   "kind": "prayer",
   "node": "shema.yotzer_or"
  },
  "he:Yotzerot/Shabbat HaGadol:11": {
   "kind": "prayer",
   "node": "shema.yotzer_or"
  },
  "he:Yotzerot/Shabbat HaGadol:12": {
   "parts": [
    {
     "text": "<b><b><small>חזן:</small>",
     "kind": "speaker",
     "en": "Chazzan:",
     "role": "chazzan"
    },
    {
     "text": " <b>תְּעוּבִים</b> פַּסּוּ בְּאַף לְהַכְנִיעָן. תָּקְפָה חֲרָדָה בַּעֲמָלֵק וּכְנָעַן:</b></b>",
     "kind": "prayer",
     "role": "chazzan",
     "voice": "aloud"
    }
   ]
  },
  "he:Yotzerot/Shabbat HaGadol:13": {
   "kind": "prayer",
   "role": "congregation",
   "voice": "aloud"
  },
  "he:Yotzerot/Shabbat HaGadol:14": {
   "parts": [
    {
     "text": "<b><b><small>חזן:</small>",
     "kind": "speaker",
     "en": "Chazzan:",
     "role": "chazzan"
    },
    {
     "text": " <b>תְּכוֹנֵן</b> אֻלָמְךָ מִזְבֵּחַ וְסוֹבֵב. לְהַגְשִׁים תֶּחִי יְשֵׁנִים דוֹבֵב:</b></b>",
     "kind": "prayer",
     "role": "chazzan",
     "voice": "aloud"
    }
   ]
  },
  "he:Yotzerot/Shabbat HaGadol:15": {
   "kind": "prayer",
   "node": "shema.yotzer_or"
  },
  "he:Yotzerot/Shabbat HaGadol:16": {
   "kind": "prayer",
   "node": "shema.yotzer_or"
  },
  "he:Yotzerot/Shabbat HaGadol:17": {
   "parts": [
    {
     "text": "<b><b><small>חזן:</small>",
     "kind": "speaker",
     "en": "Chazzan:",
     "role": "chazzan"
    },
    {
     "text": " <b>לִמְדַּנִי</b> לָנוּחַ בְּשַׁבָּת מֵהַדְאִיבִי. לְהַאֲכִילִי נַחֲלַת יַעֲקֹב אָבִי:</b></b>",
     "kind": "prayer",
     "role": "chazzan",
     "voice": "aloud"
    }
   ]
  },
  "he:Yotzerot/Shabbat HaGadol:18": {
   "parts": [
    {
     "text": "<b><b><small>חו\"ק:</small>",
     "kind": "speaker",
     "en": "Congregation:",
     "role": "congregation"
    },
    {
     "text": " <b>יִמְלוֹךְ</b> יְהֹוָה לְעוֹלָם אֱלֹהַיִךְ צִיוֹן לְדוֹר וָדוֹר הַלְלוּיָהּ: וְאַתָּה קָדוֹשׁ יוֹשֵׁב תְּהִלּוֹת יִשְׂרָאֵל אֵל נָא:</b></b>",
     "kind": "prayer",
     "role": "congregation",
     "voice": "aloud"
    }
   ]
  },
  "he:Yotzerot/Shabbat HaGadol:19": {
   "kind": "prayer",
   "role": "chazzan",
   "voice": "aloud"
  },
  "he:Yotzerot/Shabbat HaGadol:20": {
   "parts": [
    {
     "text": "<b><b><small>חו\"ק:</small>",
     "kind": "speaker",
     "en": "Congregation:",
     "role": "congregation"
    },
    {
     "text": " <b>חַי</b> וְקַיָם נוֹרָא וּמָרוֹם וְקָדוֹשׁ:</b></b>",
     "kind": "prayer",
     "role": "congregation",
     "voice": "aloud"
    }
   ]
  },
  "he:Yotzerot/Shabbat HaGadol:21": {
   "kind": "prayer",
   "role": "chazzan",
   "voice": "aloud"
  },
  "he:Yotzerot/Shabbat HaGadol:22": {
   "parts": [
    {
     "text": "<b><b><small>חזן:</small>",
     "kind": "speaker",
     "en": "Chazzan:",
     "role": "chazzan"
    },
    {
     "text": " <b>חֲנָמַל</b> בָּרָד וּרְשָׁפִים. זִלְעֵף בַּעֲלֵי כְשָׁפִים. קָרְסוּ כָּרְעוּ כְשׁוּפִים. עֲפַר אֶרֶץ שׁוֹאֲפִים:</b></b>",
     "kind": "prayer",
     "role": "chazzan",
     "voice": "aloud"
    }
   ]
  },
  "he:Yotzerot/Shabbat HaGadol:23": {
   "kind": "prayer",
   "role": "congregation",
   "voice": "aloud"
  },
  "he:Yotzerot/Shabbat HaGadol:24": {
   "parts": [
    {
     "text": "<b><b><small>חו\"ק:</small>",
     "kind": "speaker",
     "en": "Congregation:",
     "role": "congregation"
    },
    {
     "text": " <b>יוֹצְאֵי</b> חִפָּזוֹן. סִפְּקָם מָזוֹן. לְשׂוֹבַע וְלֹא לְרָזוֹן. קָדוֹשׁ:</b></b>",
     "kind": "prayer",
     "role": "congregation",
     "voice": "aloud"
    }
   ]
  },
  "he:Yotzerot/Shabbat HaGadol:25": {
   "parts": [
    {
     "text": "<b>אֲמָנָה</b> גְדוֹלָה הָיְתָה בָעָם. בְּלִי לְהִתְלוֹנֵן זֹאת הַפַּעַם. גּוֹעָה לוֹמַר מַה נִטְעָם: <b>",
     "kind": "prayer",
     "role": "chazzan",
     "voice": "aloud"
    },
    {
     "text": "<small>יוצאי:</small></b>",
     "kind": "instruction",
     "en": "Yotzei:",
     "gloss": "Response cue for congregation"
    }
   ]
  },
  "he:Yotzerot/Shabbat HaGadol:26": {
   "parts": [
    {
     "text": "<b><b>דֶּרֶךְ שְׁלֹשָׁה נֵלֵךְ בַּמִּדְבָּר. הִגִּיד מֵאָז מַנְהִיג וְדַבָּר. וְלֹא כִחַד מֵהֶם דָּבָר. <b>",
     "kind": "prayer",
     "role": "chazzan",
     "voice": "aloud"
    },
    {
     "text": "<small>יוצאי:</small></b> </b></b>",
     "kind": "instruction",
     "en": "Yotzei:",
     "gloss": "Response cue for congregation"
    }
   ]
  },
  "he:Yotzerot/Shabbat HaGadol:27": {
   "parts": [
    {
     "text": "<b><b>זְרִיזִים חָשׁוּ לְהַקְדִּישׁ קְרוּאָיו. חָסוּ בְּמַטְרִיף כָּל בְּרוּאָיו. טוֹב אֵין מַחְסוֹר לִירֵאָיו. <b>",
     "kind": "prayer",
     "role": "chazzan",
     "voice": "aloud"
    },
    {
     "text": "<small>יוצאי:</small></b> </b></b>",
     "kind": "instruction",
     "en": "Yotzei:",
     "gloss": "Response cue for congregation"
    }
   ]
  },
  "he:Yotzerot/Shabbat HaGadol:28": {
   "parts": [
    {
     "text": "<b><b>יָחִיד שְׁמָרָהּ לְמִדָּה שְׂרוּעָה. כְּלוּלוֹתַיִךְ אֶזְכּוֹר חֶסֶד לְפָרְעָה. לֶכְתֵּךְ אַחֲרַי בַּמִּדְבָּר בְּאֶרֶץ לֹא זְרוּעָה. <b>",
     "kind": "prayer",
     "role": "chazzan",
     "voice": "aloud"
    },
    {
     "text": "<small>יוצאי:</small></b> </b></b>",
     "kind": "instruction",
     "en": "Yotzei:",
     "gloss": "Response cue for congregation"
    }
   ]
  },
  "he:Yotzerot/Shabbat HaGadol:29": {
   "parts": [
    {
     "text": "<b><b>מְקוֹם צִפְעוֹנִים נָחָשׁ שָׂרָף וְעַקְרָב. נָסְעוּ קְדוֹשִׁים לַשֶׁמֶשׁ וְשָׁרָב. שָׂב וְעוֹלֵל וּמִקְנֶה רָב. <b>",
     "kind": "prayer",
     "role": "chazzan",
     "voice": "aloud"
    },
    {
     "text": "<small>יוצאי:</small></b> </b></b>",
     "kind": "instruction",
     "en": "Yotzei:",
     "gloss": "Response cue for congregation"
    }
   ]
  },
  "he:Yotzerot/Shabbat HaGadol:30": {
   "parts": [
    {
     "text": "<b><b>עֲדָרִים הִשְׂכִּילוּ מַדָּע לְהַחֲכִּימָם. פִּסַּת מִשְׁאָרוֹת נָשְׂאוּ בְּהַשְׁכִּימָם. צְרוּרוֹת בְּשִׂמְלוֹתָם עַל שִׁכְמָם. <b>",
     "kind": "prayer",
     "role": "chazzan",
     "voice": "aloud"
    },
    {
     "text": "<small>יוצאי:</small></b> </b></b>",
     "kind": "instruction",
     "en": "Yotzei:",
     "gloss": "Response cue for congregation"
    }
   ]
  },
  "he:Yotzerot/Shabbat HaGadol:31": {
   "parts": [
    {
     "text": "<b><b>קִטּוּף הָעִסָּה בַּחֲרָרָה קְמוּצָה. רְצוּפָה בְּרָאשֵׁיהֶם שֶׁלֹּא חֻמָּצָה. שֶׁמֶשׁ שֶׁזָפַתָּהּ וַאֲכָלוּהָ מַצָּה. <b>",
     "kind": "prayer",
     "role": "chazzan",
     "voice": "aloud"
    },
    {
     "text": "<small>יוצאי:</small></b> </b></b>",
     "kind": "instruction",
     "en": "Yotzei:",
     "gloss": "Response cue for congregation"
    }
   ]
  },
  "he:Yotzerot/Shabbat HaGadol:32": {
   "parts": [
    {
     "text": "<b><b>תּוּפִינֵי שִׁשִּׁים וְאַחַת בְּמִשְׁטָר. טָעֲמוּ וְאָרְחוּ בְּשִׁיּוּר הַמְּנֻטָּר. עַד לֶחֶם מִשָׁמַיִם הוּמְטָר. <b>",
     "kind": "prayer",
     "role": "chazzan",
     "voice": "aloud"
    },
    {
     "text": "<small>יוצאי:</small></b></b></b>",
     "kind": "instruction",
