     "kind": "prayer"
    }
   ]
  },
  "he:Chanukah/Menorah Lighting:30": {
   "parts": [
    {
     "text": "<b><b>נָא גִבּוֹר דּוֹרְשֵׁי יִחוּדְךָ כְּבָבַת שָׁמְרֵם. ",
