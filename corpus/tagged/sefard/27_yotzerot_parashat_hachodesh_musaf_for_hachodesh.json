  "he:Yotzerot/Musaf for Hachodesh:1": {
   "kind": "heading",
   "en": "Musaf for the Parashah of the New Month"
  },
  "he:Yotzerot/Musaf for Hachodesh:2": {
   "kind": "prayer"
  },
  "he:Yotzerot/Musaf for Hachodesh:3": {
   "kind": "prayer"
  },
  "he:Yotzerot/Musaf for Hachodesh:4": {
   "kind": "prayer"
  },
  "he:Yotzerot/Musaf for Hachodesh:5": {
   "kind": "prayer"
  },
  "he:Yotzerot/Musaf for Hachodesh:6": {
   "parts": [
    {
     "text": "<b><b><small>חזן:</small>",
     "kind": "speaker",
     "en": "Chazzan:"
    },
    {
     "text": " <b>אַרְבָּעָה</b> רָאשֵׁי שָׁנִים בַּמַּחֲזֶה. בֵּאַרְתָּ זֶה מִזֶּה לַחוֹזֶה. כַּאֲשֶׁר שָׁמַעְנוּ כֵּן עוֹד נֶחֱזֶה. לְגוֹנְנֵמוֹ בְּמָגֵן בַּחֹדֶשׁ הַזֶּה:</b></b>",
     "kind": "prayer",
     "role": "chazzan",
     "voice": "aloud"
    }
   ]
  },
  "he:Yotzerot/Musaf for Hachodesh:7": {
   "kind": "prayer"
  },
  "he:Yotzerot/Musaf for Hachodesh:8": {
   "kind": "prayer"
  },
  "he:Yotzerot/Musaf for Hachodesh:9": {
   "kind": "prayer"
  },
  "he:Yotzerot/Musaf for Hachodesh:10": {
   "kind": "prayer"
  },
  "he:Yotzerot/Musaf for Hachodesh:11": {
   "parts": [
    {
     "text": "<b><b><small>חזן:</small>",
     "kind": "speaker",
     "en": "Chazzan:"
    },
    {
     "text": " <b>אַרְבַּע</b> תְּקוּפוֹת בַּשָּׁנָה. תְּחַדֵּשׁ אוֹרָם כְּבָרִאשׁוֹנָה. כַּאֲשֶׁר שָׁמַעְנוּ כֵּן עוֹד חִישׁ נָא. הַחֲיֵינוּ בְגֶשֶׁם בָּרִאשׁוֹן לְחָדְשֵׁי הַשָּׁנָה:</b></b>",
     "kind": "prayer",
     "role": "chazzan",
     "voice": "aloud"
    }
   ]
  },
  "he:Yotzerot/Musaf for Hachodesh:12": {
   "kind": "prayer"
  },
  "he:Yotzerot/Musaf for Hachodesh:13": {
   "kind": "instruction",
   "en": "Keter (Crown)"
  },
  "he:Yotzerot/Musaf for Hachodesh:14": {
   "kind": "prayer",
   "role": "congregation_then_chazzan"
  },
  "he:Yotzerot/Musaf for Hachodesh:15": {
   "parts": [
    {
     "text": "<small><b><b><small><b>קו\"ח:</b></small>",
     "kind": "speaker",
     "en": "Congregation:"
    },
    {
     "text": " קָדוֹשׁ קָדוֹשׁ קָדוֹשׁ יְהֹוָה צְבָאוֹת מְלֹא כָל הָאָרֶץ כְּבוֹדוֹ: ",
     "kind": "prayer",
     "role": "congregation"
    },
    {
     "text": "<small><b>חזן:</b></small>",
     "kind": "speaker",
     "en": "Chazzan:"
    },
    {
     "text": " כְּבוֹדוֹ מָלֵא עוֹלָם. מְשָׁרְתָיו שׁוֹאֲלִים זֶה לָזֶה אַיֵּה מְקוֹם כְּבוֹדוֹ לְהַעֲרִיצוֹ. לְעֻמָּתָם מְשַׁבְּחִים וְאוֹמְרִים: </b></b></small>",
     "kind": "prayer",
     "role": "chazzan"
    }
   ]
  },
  "he:Yotzerot/Musaf for Hachodesh:16": {
   "parts": [
    {
     "text": "<small><b><b><small><b>קו\"ח:</b></small>",
     "kind": "speaker",
     "en": "Congregation:"
    },
    {
     "text": " בָּרוּךְ כְּבוֹד יְהֹוָה מִמְּקוֹמוֹ: ",
     "kind": "prayer",
     "role": "congregation"
    },
    {
     "text": "<small><b>חזן:</b></small>",
     "kind": "speaker",
     "en": "Chazzan:"
    },
    {
     "text": " מִמְּקוֹמוֹ הוּא יִפֶן בְּרַחֲמָיו לְעַמּוֹ. וְיָחוֹן עַם הַמְיַחֲדִים שְׁמוֹ עֶרֶב וָבוֹקֶר בְּכָל יוֹם תָּמִיד. פַּעֲמַיִם בְּאַהֲבָה שְׁמַע אוֹמְרִים: </b></b></small>",
     "kind": "prayer",
     "role": "chazzan"
    }
   ]
  },
  "he:Yotzerot/Musaf for Hachodesh:17": {
   "parts": [
    {
     "text": "<small><b><b><small><b>קו\"ח:</b></small>",
     "kind": "speaker",
     "en": "Congregation:"
    },
    {
     "text": " שְׁמַע יִשְׂרָאֵל יְהֹוָה אֱלֹהֵינוּ יְהֹוָה אֶחָד: ",
     "kind": "prayer",
     "role": "congregation"
    },
    {
     "text": "<small><b>חזן:</b></small>",
     "kind": "speaker",
     "en": "Chazzan:"
    },
    {
     "text": " הוּא אֱלֹהֵינוּ הוּא אָבִינוּ. הוּא מַלְכֵּנוּ הוּא מוֹשִׁיעֵנוּ. וְהוּא יוֹשִׁיעֵנוּ וְיִגְאָלֵנוּ שֵׁנִית וְיַשְׁמִיעֵנוּ בְּרַחֲמָיו שֵׁנִית לְעֵינֵי כָּל חַי לֵאמֹר. הֵן גָּאַלְתִּי אֶתְכֶם אַחֲרִית כְּרֵאשִׁית לִהְיוֹת לָכֶם לֵאלֹהִים: </b></b></small>",
     "kind": "prayer",
     "role": "chazzan"
    }
   ]
  },
  "he:Yotzerot/Musaf for Hachodesh:18": {
   "parts": [
    {
     "text": "<small><b><b><small><b>קו\"ח:</b></small>",
     "kind": "speaker",
     "en": "Congregation:"
    },
    {
     "text": " אֲנִי יְהֹוָה אֱלֹהֵיכֶם: ",
     "kind": "prayer",
     "role": "congregation"
    },
    {
     "text": "<small><b>חזן:</b></small>",
     "kind": "speaker",
     "en": "Chazzan:"
    },
    {
     "text": " וּבְדִבְרֵי קָדְשְׁךָ כָּתוּב לֵאמֹר: ",
     "kind": "prayer",
     "role": "chazzan"
    },
    {
     "text": "<small><b>קו\"ח:</b></small>",
     "kind": "speaker",
     "en": "Congregation:"
    },
    {
     "text": " יִמְלֹךְ יְהֹוָה לְעוֹלָם. אֱלֹהַיִךְ צִיּוֹן לְדֹר וָדֹר. הַלְלוּיָהּ:</b></b></small>",
     "kind": "prayer",
     "role": "congregation"
    }
   ]
  },
  "he:Yotzerot/Musaf for Hachodesh:19": {
   "parts": [
    {
     "text": "<small><b><b><small><b>חזן:</b></small>",
     "kind": "speaker",
     "en": "Chazzan:"
    },
    {
     "text": "לְדוֹר וָדוֹר נַגִּיד גָּדְלֶךָ. וּלְנֵצַח נְצָחִים קְדֻשָּׁתְךָ נַקְדִּישׁ. וְשִׁבְחֲךָ אֱלֹהֵינוּ מִפִּינוּ לֹא יָמוּשׁ לְעוֹלָם וָעֶד. כִּי אֵל מֶלֶךְ גָּדוֹל וְקָדוֹשׁ אָתָּה:</b></b></small><b><b></b></b>",
     "kind": "prayer",
     "role": "chazzan"
    }
   ]
