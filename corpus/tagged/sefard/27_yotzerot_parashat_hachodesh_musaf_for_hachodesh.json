  "he:Yotzerot/Parashat HaChodesh:5": {
   "kind": "prayer"
  },
  "he:Yotzerot/Parashat HaChodesh:6": {
   "parts": [
    {
     "text": "<b><b><small>חזן:</small>",
     "kind": "speaker",
     "en": "Chazzan:"
    },
    {
     "text": " <b>כָּסַף</b> וְדָפַק בְּפִתְחֵי יְשֵׁנָה. לְחַפְּשָׁהּ בָּרִאשׁוֹן לְחָדְשֵׁי הַשָּׁנָה: <b>לִי</b> עוֹד תִּגְנוֹן. בְּפָסוֹחַ וְגָנוֹן: </b></b>",
     "kind": "prayer",
     "role": "chazzan",
     "voice": "aloud"
    }
   ]
  },
  "he:Yotzerot/Parashat HaChodesh:7": {
   "parts": [
    {
     "text": "<b><b><small>חזן:</small>",
     "kind": "speaker",
     "en": "Chazzan:"
    },
    {
     "text": " <b>בְּגוֹנְנָךְ</b> לְבָנוֹן. בְּמָגִנַּת יִנּוֹן:</b></b>",
     "kind": "prayer",
     "role": "chazzan",
     "voice": "aloud"
    }
   ]
  },
  "he:Yotzerot/Parashat HaChodesh:8": {
   "kind": "prayer"
  },
  "he:Yotzerot/Parashat HaChodesh:9": {
   "kind": "prayer"
  },
  "he:Yotzerot/Parashat HaChodesh:10": {
   "kind": "prayer"
  },
  "he:Yotzerot/Parashat HaChodesh:11": {
   "parts": [
    {
     "text": "<b><b><small>חזן:</small>",
     "kind": "speaker",
     "en": "Chazzan:"
    },
    {
     "text": " <b>צְלִיחַת</b> יַרְדֵּן בּוֹ לְהַתְווֹת. צְפִיַּת שֶׂה לְבֵית אָבוֹת:</b></b>",
     "kind": "prayer",
     "role": "chazzan",
     "voice": "aloud"
    }
   ]
  },
  "he:Yotzerot/Parashat HaChodesh:12": {
   "kind": "prayer"
  },
  "he:Yotzerot/Parashat HaChodesh:13": {
   "parts": [
    {
     "text": "<b><b><small>חזן:</small>",
     "kind": "speaker",
     "en": "Chazzan:"
    },
    {
     "text": " <b>שְׂשׂוֹן</b> יִשְׁעֲךָ לָנוּ הָשִׁיבָה. וּבִתְחִיַּת גֶּשֶׁם נֵחָשֵׁבָה:</b></b>",
     "kind": "prayer",
     "role": "chazzan",
     "voice": "aloud"
    }
   ]
  },
  "he:Yotzerot/Parashat HaChodesh:14": {
   "kind": "prayer"
  },
  "he:Yotzerot/Parashat HaChodesh:15": {
   "kind": "prayer"
  },
  "he:Yotzerot/Parashat HaChodesh:16": {
   "parts": [
    {
     "text": "<b><b><small>חזן:</small>",
     "kind": "speaker",
     "en": "Chazzan:"
    },
    {
     "text": " <b>תּוֹקֶף</b> הַדְרַת מֶלֶךְ מִלְהִמָּעֵט. הוּרְשַׁם לְהִמָּנוֹת בִּוְאִם יִמְעַט:</b></b>",
     "kind": "prayer",
     "role": "chazzan",
     "voice": "aloud"
    }
   ]
  },
  "he:Yotzerot/Parashat HaChodesh:17": {
   "kind": "prayer"
  },
  "he:Yotzerot/Parashat HaChodesh:18": {
   "parts": [
    {
     "text": "<b><b><small>חזן:</small>",
     "kind": "speaker",
     "en": "Chazzan:"
    },
    {
     "text": " <b>יְדִידֵי</b> עַם קְדוֹשׁוֹ. הוֹשִׁיעָה לוֹ יְמִינוֹ וּזְרוֹעַ קָדְשׁוֹ:</b></b>",
     "kind": "prayer",
     "role": "chazzan",
     "voice": "aloud"
    }
   ]
  },
  "he:Yotzerot/Parashat HaChodesh:19": {
   "kind": "prayer"
  },
  "he:Yotzerot/Parashat HaChodesh:20": {
   "parts": [
    {
     "text": "<b><b><small>חזן:</small>",
     "kind": "speaker",
     "en": "Chazzan:"
    },
    {
     "text": " <b>וְנוֹבִיל</b> שַׁי בַּקּוֹדֶשׁ. בָּרִאשׁוֹן בְּאֶחָד לַחוֹדֶשׁ:</b></b>",
     "kind": "prayer",
     "role": "chazzan",
     "voice": "aloud"
    }
   ]
  },
  "he:Yotzerot/Parashat HaChodesh:21": {
   "parts": [
    {
     "text": "<b><b><small>חו\"ק:</small>",
     "kind": "speaker",
     "en": "Congregation:"
    },
    {
     "text": " <b>יִמְלוֹךְ</b> יְהֹוָה לְעוֹלָם אֱלֹהַיִךְ צִיוֹן לְדוֹר וָדוֹר הַלְלוּיָהּ: וְאַתָּה קָדוֹשׁ יוֹשֵׁב תְּהִלּוֹת יִשְׂרָאֵל אֵל נָא:</b></b>",
     "kind": "prayer",
     "role": "congregation",
     "voice": "aloud"
    }
   ]
  },
  "he:Yotzerot/Parashat HaChodesh:22": {
   "kind": "prayer"
  },
  "he:Yotzerot/Parashat HaChodesh:23": {
   "parts": [
    {
     "text": "<b><b><small>חו\"ק:</small>",
     "kind": "speaker",
     "en": "Congregation:"
    },
    {
     "text": " <b>חַי</b> וְקַיָם נוֹרָא וּמָרוֹם וְקָדוֹשׁ:</b></b>",
     "kind": "prayer",
     "role": "congregation",
     "voice": "aloud"
    }
   ]
  },
  "he:Yotzerot/Parashat HaChodesh:24": {
   "kind": "prayer"
  },
  "he:Yotzerot/Parashat HaChodesh:25": {
   "parts": [
    {
     "text": "<b><b><small>חזן:</small>",
     "kind": "speaker",
     "en": "Chazzan:"
    },
    {
     "text": " <b>רֵעִים</b> כְּנִתַּן לָמוֹ מַסּוֹרֶת אִמְּצוּ. לְחַשֵּׁב לְעַבֵּר וּלְקַדֵּשׁ סְפוֹרוֹת כְּמָצְאוּ:</b></b>",
     "kind": "prayer",
     "role": "chazzan",
     "voice": "aloud"
    }
   ]
  },
  "he:Yotzerot/Parashat HaChodesh:26": {
   "kind": "prayer"
  },
  "he:Yotzerot/Parashat HaChodesh:27": {
   "parts": [
    {
     "text": "<b><b><small>חו\"ק:</small>",
     "kind": "speaker",
     "en": "Congregation:"
    },
    {
     "text": " <b>רִאשׁוֹן</b> הוּא לָכֶם. לִפְסוֹחַ עֲלֵיכֶם. לְהִתְקַדֵּשׁ בְּתוֹכְכֶם. קָדוֹשׁ:</b></b>",
     "kind": "prayer",
     "role": "congregation",
     "voice": "aloud"
    }
   ]
  },
  "he:Yotzerot/Parashat HaChodesh:28": {
   "parts": [
    {
     "text": "<b><b><small>חו\"ק:</small>",
     "kind": "speaker",
     "en": "Congregation:"
    },
    {
     "text": " <b>לָכֶם</b> הוּא רִאשׁוֹן. נְצוּרֵי כְאִישׁוֹן. לְהַעֲרִיץ לְאֵל אַחֲרוֹן וְרִאשׁוֹן. קָדוֹשׁ:</b></b>",
     "kind": "prayer",
     "role": "congregation",
     "voice": "aloud"
    }
   ]
  },
  "he:Yotzerot/Parashat HaChodesh:29": {
   "kind": "prayer"
  },
  "he:Yotzerot/Parashat HaChodesh:30": {
   "kind": "prayer"
  },
  "he:Yotzerot/Parashat HaChodesh:31": {
   "kind": "prayer"
  },
  "he:Yotzerot/Parashat HaChodesh:32": {
   "kind": "prayer"
  },
  "he:Yotzerot/Parashat HaChodesh:33": {
   "kind": "prayer"
  },
  "he:Yotzerot/Parashat HaChodesh:34": {
   "kind": "prayer"
  },
  "he:Yotzerot/Parashat HaChodesh:35": {
   "kind": "prayer"
  },
  "he:Yotzerot/Parashat HaChodesh:36": {
   "parts": [
    {
     "text": "<b>וְרֶגֶשׁ</b> קַדִּישִׁין. אֲשֶׁר לַבְּקָרִים מִתְחַדְּשִׁים. לִפְנֵי שִׁיר זֶה לֹא מַקְדִּישִׁים: וְנַהַם שִׁנְאֲנִּים. אֲשֶׁר טַעֲמָם לֹא מְשַׁנִּים. לִפְנֵי שִׁיר זֶה לֹא מְשַׁנְּנִים: וּפַחַד שְׂרָפִים. אֲשֶׁר בְּרֶגַע כֹּל שׂוֹרְפִים. לִפְנֵי שִׁיר זֶה לֹא רוֹפְפִים: כִּי כָל מַחֲנוֹת מְשָׁרְתִים קְדוֹשִׁים. מְשָׁרְתָיו יְהוּ מַקְדִּישִׁים: וְגַם הֲמוֹן צְבָא מַלְאָכִים. מַנְעִימָיו יְהוּ מַמְלִיכִים: וּמְרוּצוֹת חֵיל זִקִּים. כֹּחָם יְהוּ מְחַזְּקִים. וְזִיו מִשְׁלַחַת בְּרָקִים. פְּנֵיהֶם יְהוּ מַבְרִיקִים. וְחוּצָה לָמוֹ הֹוִים. מִתְעַלְּסִים בָּאֳהָבִים: וְעַד מְחִיצָתָם לֹא בָאִים. בְּאִשָׁם נִלְהָבִים. וּבְגַחַלְתָּם נִכְוִים. וּבְפָאֲרָם הֵם נֶאֱלָמִים: וְעֵת כִּי יַתְחִילוּ יָחִישׁוּ. וְעֵת כִּי יַתְכִּילוּ יָחִילוּ. וְעֵת כִּי יִגְמוֹרוּ יַעֲרִיצוּ. וְעֵת כִּי יָחִישׁוּ ",
     "kind": "prayer"
    },
    {
     "text": "<small>(נ\"א יֶחֱשׁוּ)</small>",
     "kind": "note",
     "en": "(MS reads: yichshu)"
    },
    {
     "text": " יַקְדִּישׁוּ. וְעֵת כִּי יִשְׁתּוֹקוּ יְשַׁלֵּשׁוּ קְדֻשָּׁה מְשֻׁלֶּשֶׁת:",
     "kind": "prayer"
    }
   ]
  },
  "he:Yotzerot/Parashat HaChodesh:37": {
   "kind": "instruction",
   "en": "Kedushah"
  },
  "he:Yotzerot/Parashat HaChodesh:38": {
   "kind": "prayer",
   "role": "congregation_then_chazzan",
   "voice": "aloud"
  },
  "he:Yotzerot/Parashat HaChodesh:39": {
   "parts": [
    {
     "text": "<small><b><b><small>קו\"ח:</small>",
     "kind": "speaker",
     "en": "Congregation:"
    },
    {
     "text": " <b>קָדוֹשׁ</b> קָדוֹשׁ קָדוֹשׁ יְהֹוָה צְבָאוֹת. מְלֹא כָל הָאָרֶץ כְּבוֹדוֹ: ",
     "kind": "prayer",
     "role": "congregation",
     "voice": "aloud"
    },
    {
     "text": "<small>חזן:</small>",
     "kind": "speaker",
     "en": "Chazzan:"
    },
    {
     "text": " <b>אָז.</b> בְּקוֹל רַעַשׁ גָּדוֹל אַדִּיר וְחָזָק. מַשְׁמִיעִים קוֹל. מִתְנַשְּׂאִים לְעֻמַּת שְׂרָפִים. לְעֻמָּתָם מְשַׁבְּחִים וְאוֹמְרִים: </b></b></small>",
     "kind": "prayer",
     "role": "chazzan",
     "voice": "aloud"
    }
   ]
  },
  "he:Yotzerot/Parashat HaChodesh:40": {
   "parts": [
    {
     "text": "<small><b><b><small>קו\"ח:</small>",
     "kind": "speaker",
     "en": "Congregation:"
    },
    {
     "text": " <b>בָּרוּךְ</b> כְּבוֹד יְהֹוָה מִמְּקוֹמוֹ: ",
     "kind": "prayer",
     "role": "congregation",
     "voice": "aloud"
    },
    {
     "text": "<small>חזן:</small>",
     "kind": "speaker",
     "en": "Chazzan:"
    },
    {
     "text": " מִמְּקוֹמְךָ מַלְכֵּנוּ תוֹפִיעַ. וְתִמְלוֹךְ עָלֵינוּ ",
     "kind": "prayer",
     "role": "chazzan",
     "voice": "aloud"
    },
    {
     "text": "<small> <small>(מְהֵרָה)</small>",
     "kind": "note",
     "en": "(Soon)"
    },
    {
     "text": " </small> כִּי מְחַכִּים אֲנַחְנוּ לָךְ. מָתַי תִּמְלֹךְ בְּצִיּוֹן. בְּקָרוֹב בְּיָמֵינוּ לְעוֹלָם וָעֶד תִּשְׁכּוֹן. תִּתְגַּדֵּל וְתִתְקַדֵּשׁ בְּתוֹךְ יְרוּשָׁלַיִם עִירְךָ לְדוֹר וָדוֹר וּלְנֵצַח נְצָחִים. וְעֵינֵינוּ תִרְאֶינָה מַלְכוּתֶךָ כַּדָּבָר הָאָמוּר בְּשִׁירֵי עֻזֶּךָ. עַל יְדֵי דָּוִד מְשִׁיחַ צִדְקֶךָ: </b></b></small>",
     "kind": "prayer",
     "role": "chazzan",
     "voice": "aloud"
    }
   ]
  },
  "he:Yotzerot/Parashat HaChodesh:41": {
   "parts": [
    {
     "text": "<small><b><b><small>קו\"ח:</small>",
     "kind": "speaker",
     "en": "Congregation:"
    },
    {
     "text": " <b>יִמְלֹךְ</b> יְהֹוָה לְעוֹלָם. אֱלֹהַיִךְ צִיּוֹן לְדֹר וָדֹר. הַלְלוּיָהּ:</b></b></small><b><b> </b></b>",
     "kind": "prayer",
     "role": "congregation",
     "voice": "aloud"
    }
   ]
  },
