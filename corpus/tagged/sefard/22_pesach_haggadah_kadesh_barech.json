  "he:Pesach Haggadah/Kadesh:9": {
   "parts": [
    {
     "text": "<small><b>בָּרוּךְ</b> אַתָּה יְהֹוָה אֱלֹהֵינוּ מֶלֶךְ הָעוֹלָם,",
     "kind": "prayer"
    },
    {
     "text": " אֲשֶׁר בָּחַר בָּנוּ מִכָּל עָם וְרוֹמְמָנוּ מִכָּל לָשׁוֹן וְקִדְּשָׁנוּ בְּמִצְוֹתָיו. וַתִּתֶּן לָנוּ יְהֹוָה אֱלֹהֵינוּ בְּאַהֲבָה <small> <small>(בשבת <b>שַׁבָּתוֹת לִמְנוּחָה וּ</b>)</small>",
     "kind": "prayer",
     "when": "shabbat"
    },
    {
     "text": " </small>מוֹעֲדִים לְשִׂמְחָה,",
     "kind": "prayer"
    },
    {
     "text": " חַגִּים וּזְמַנִּים לְשָׂשׂוֹן,",
     "kind": "prayer"
    },
    {
     "text": " אֶת יוֹם ",
     "kind": "prayer"
    },
    {
     "text": "<small> <small>(בשבת: <b>הַשַׁבָּת הַזֶה וְאֶת יוֹם</b>)</small>",
     "kind": "prayer",
     "when": "shabbat"
    },
    {
     "text": " </small> חַג הַמַצוֹת הַזֶה,",
     "kind": "prayer"
    },
    {
     "text": " זְמַן חֵרוּתֵנוּ ",
     "kind": "prayer"
    },
    {
     "text": "<small> <small>(בשבת: <b>בְּאַהֲבָה,",
     "kind": "prayer",
     "when": "shabbat"
    },
    {
     "text": "</b>)</small>",
     "kind": "prayer"
    },
    {
     "text": " </small>מִקְרָא קֹדֶשׁ,",
     "kind": "prayer"
    },
    {
     "text": " זֵכֶר לִיצִיאַת מִצְרָיִם. כִּי בָנוּ בָחַרְתָּ וְאוֹתָנוּ קִדַּשְׁתָּ מִכָּל הָעַמִּים, ",
     "kind": "prayer",
     "when": "shabbat"
    },
    {
     "text": "<small> <small>(בשבת: <b>וְשַׁבָּת</b>)</small>",
     "kind": "prayer"
    },
    {
     "text": " </small>וּמוֹעֲדֵי קָדְשֶׁךָ ",
     "kind": "prayer",
     "when": "shabbat"
    },
    {
     "text": "<small> <small>(בשבת: <b>בְּאַהֲבָה וּבְרָצוֹן,",
     "kind": "prayer"
    },
    {
     "text": "</b>)</small>",
     "kind": "prayer",
     "when": "shabbat"
    },
    {
     "text": " </small>בְּשִׂמְחָה וּבְשָׂשׂוֹן הִנְחַלְתָּנוּ. <b>בָּרוּךְ</b> אַתָּה יְהֹוָה,",
     "kind": "prayer"
    },
    {
     "text": " מְקַדֵּשׁ ",
     "kind": "prayer"
    },
    {
     "text": "<small> <small>(בשבת: <b>הַשַׁבָּת וְ</b>)</small>",
     "kind": "prayer"
    },
    {
     "text": " </small>יִשְׂרָאֵל וְהַזְּמַנִּים:</small>",
     "kind": "prayer"
    }
   ]
  },
