     "clean": "בשנת העיבור עד חודש ניסן"
    },
    {
     "kind": "prayer",
     "voice": "silent",
     "when": "leapYear && hMonth in [7, 8, 9, 10, 11, 12, 13]",
     "text": "וּלְכַפָּרַת פָּשַׁע"
    },
    {
     "kind": "prayer",
     "voice": "silent",
     "text": "</small></em>. כִּי בְעַמְּךָ יִשרָאֵל בָּחַרְתָּ מִכָּל הָאֻמּות. וְחֻקֵּי רָאשֵׁי חֳדָשִׁים לָהֶם קָבָעְתָּ: "
    }
