  "he:Third Meal/Zemirot:54": {
   "kind": "note",
   "en": "The author of the zemer is Rabbi Yehuda HaLevi, and his name is signed in the acrostic of the stanzas."
  },
  "he:Third Meal/Zemirot:55": {
   "parts": [
    {
     "text": "<b>י</b>וֹם שַׁבָּתוֹן אֵין לִשְׁכֹּחַ,",
     "kind": "prayer"
    },
    {
     "text": " זִכְרוֹ כְּרֵיחַ הַנִּיחֹחַ, ",
     "kind": "prayer"
    },
    {
     "text": "<small>יוֹנָה מָצְאָה בוֹ מָנוֹחַ,",
     "kind": "prayer"
    },
    {
     "text": " וְשָׁם יָנוּחוּ יְגִיעֵי כֹחַ:</small>",
     "kind": "prayer"
    }
   ]
  },
  "he:Third Meal/Zemirot:56": {
   "parts": [
    {
     "text": "<b>הַ</b>יּוֹם נִכְבָּד לִבְנֵי אֱמוּנִים,",
     "kind": "prayer"
    },
    {
     "text": " זְהִירִים לְשָׁמְרוֹ אָבוֹת וּבָנִים,",
     "kind": "prayer"
    },
    {
     "text": " חָקוּק בִּשְׁנֵי לֻחוֹת אֲבָנִים,",
     "kind": "prayer"
    },
    {
     "text": " מֵרֹב אוֹנִים וְאַמִּיץ כֹּחַ: ",
     "kind": "prayer"
    },
    {
     "text": "<small>יוֹנָה מָצְאָה בוֹ מָנוֹחַ,",
     "kind": "prayer"
    },
    {
     "text": " וְשָׁם יָנוּחוּ יְגִיעֵי כֹחַ:</small>",
     "kind": "prayer"
    }
   ]
  },
  "he:Third Meal/Zemirot:57": {
   "parts": [
    {
     "text": "<b>וּ</b>בָאוֹ כֻלָּם בִּבְרִית יַחַד,",
     "kind": "prayer"
    },
    {
     "text": " נַעֲשֶׂה וְנִשְׁמַע אָמְרוּ כְּאֶחָד,",
     "kind": "prayer"
    },
    {
     "text": " וּפָתְחוּ וְעָנוּ יְהֹוָה אֶחָד,",
     "kind": "prayer"
    },
    {
     "text": " בָּרוּךְ הַנּוֹתֵן לַיָּעֵף כֹּחַ: ",
     "kind": "prayer"
    },
    {
     "text": "<small>יוֹנָה מָצְאָה בוֹ מָנוֹחַ,",
     "kind": "prayer"
    },
    {
     "text": " וְשָׁם יָנוּחוּ יְגִיעֵי כֹחַ:</small>",
     "kind": "prayer"
    }
   ]
  },
  "he:Third Meal/Zemirot:58": {
   "parts": [
    {
     "text": "<b>דִּ</b>בֶּר בְּקָדְשׁוֹ בְּהַר הַמּוֹר,",
     "kind": "prayer"
    },
    {
     "text": " יוֹם הַשְּׁבִיעִי זָכוֹר וְשָׁמוֹר,",
     "kind": "prayer"
    },
    {
     "text": " וְכל פִּקּוּדָיו יַחַד לִגְמֹר,",
     "kind": "prayer"
    },
    {
     "text": " חַזֵּק מָתְנַיִם וְאַמֵּץ כֹּחַ. ",
     "kind": "prayer"
    },
    {
     "text": "<small>יוֹנָה מָצְאָה בוֹ מָנוֹחַ,",
     "kind": "prayer"
    },
    {
     "text": " וְשָׁם יָנוּחוּ יְגִיעֵי כֹחַ:</small>",
     "kind": "prayer"
    }
   ]
  },
  "he:Third Meal/Zemirot:59": {
   "parts": [
    {
     "text": "<b>הָ</b>עָם אֲשֶׁר נָע כַּצֹּאן תָּעָה,",
     "kind": "prayer"
    },
    {
     "text": " יִזְכֹּר לְפֹקְדוֹ בְּרִית וּשְׁבוּעָה,",
     "kind": "prayer"
    },
    {
     "text": " לְבַל יַעֲבוֹר בָּם מִקְרֵה רָעָה,",
     "kind": "prayer"
    },
    {
     "text": " כַּאֲשֶׁר נִשְׁבַּעְתָּ עַל מֵי נֹחַ. ",
     "kind": "prayer"
    },
    {
     "text": "<small>יוֹנָה מָצְאָה בוֹ מָנוֹחַ,",
     "kind": "prayer"
    },
    {
     "text": " וְשָׁם יָנוּחוּ יְגִיעֵי כֹחַ:</small>",
     "kind": "prayer"
    }
   ]
  },
