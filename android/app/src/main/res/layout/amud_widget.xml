<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="14dp" android:background="@drawable/widget_background">
    <TextView android:id="@+id/widget_date" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="21sp" android:textColor="#172A5C" android:textStyle="bold" android:maxLines="1" />
    <TextView android:id="@+id/widget_parsha" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="15sp" android:textColor="#172A5C" android:maxLines="1" />
    <TextView android:id="@+id/widget_zman" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="17sp" android:textColor="#172A5C" android:layout_marginTop="6dp" android:maxLines="2" />
    <TextView android:id="@+id/widget_omer" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="15sp" android:textColor="#172A5C" />
    <TextView android:id="@+id/widget_candles" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="13sp" android:textColor="#172A5C" android:maxLines="2" />
    <TextView android:id="@+id/widget_location" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="#52627C" android:maxLines="1" />
</LinearLayout>
