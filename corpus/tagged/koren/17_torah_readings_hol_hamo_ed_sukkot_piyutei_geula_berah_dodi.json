  },
  "en:Torah Readings/Shemini Atzeret:2": {
   "parts": [
    {
     "text": "<i class=\"instruction\">Outside Israel, the Torah Reading for Shemini Atzeret is the same as that of the eighth day of Pesaḥ, page </i>",
     "kind": "instruction"
    },
    {
     "text": "1142",
     "kind": "prayer"
    },
    {
     "text": "<i class=\"instruction\">. In Israel the Torah Reading for Shemini Atzeret is that of Simḥat Torah, page </i>",
     "kind": "instruction"
    },
    {
     "text": "1160",
     "kind": "prayer"
    },
    {
     "text": "<i class=\"instruction\">. The following Maftir is then read:</i>",
     "kind": "instruction"
    }
   ],
   "he": [
    "he:Torah Readings/Shemini Atzeret:4"
   ]
  },
