  "en:Torah Readings/Hol HaMo'ed Sukkot:35": {
   "parts": [
    {
     "text": "<i class=\"instruction\">The Torah reading for Shabbat ḥol HaMo’ed Sukkot is the same as that of Shabbat ḥol HaMo’ed Pesaḥ</i>",
     "kind": "instruction"
    },
    {
     "text": "( ",
     "kind": "prayer"
    },
    {
     "text": "<i class=\"instruction\">page</i>",
     "kind": "instruction"
    },
    {
     "text": "1135).",
     "kind": "prayer"
    },
    {
     "text": "<i class=\"instruction\"> The Maftir is the Torah reading of the day of ḥol HaMo’ed Sukkot on which Shabbat falls.</i>",
     "kind": "instruction"
    }
   ],
   "he": [
