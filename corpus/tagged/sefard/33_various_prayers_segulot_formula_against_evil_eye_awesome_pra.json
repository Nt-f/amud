 "he": {
  "he:Various Prayers & Segulot/Letter of Ramban:1": {
   "kind": "heading",
   "en": "Letter of the Ramban"
  },
  "he:Various Prayers & Segulot/Letter of Ramban:2": {
   "kind": "note",
   "en": "This letter was sent by the Ramban from his city to Katalonia to his son on the topic of humility. He commanded that it be read once a week, and that others learn it with him, so that one becomes accustomed to it by heart, to educate children in the fear of Heaven. He promised that on the day one reads this letter, Heaven will answer whatever one asks. Anyone who makes it a habit to recite it will surely be saved from all trouble and assured of a portion in the World to Come."
  },
  "he:Various Prayers & Segulot/Letter of Ramban:3": {
   "kind": "instruction",
   "en": "From the book Ma'orot Sapir:"
  },
  "he:Various Prayers & Segulot/Letter of Ramban:4": {
   "parts": [
    {
     "text": "<b>שְׁמַע</b> בְּנִי מוּסַר אָבִיךָ,",
     "kind": "prayer"
    },
    {
     "text": " וְאַל תִּטּוֹשׁ תּוֹרַת אִמֶּךָ. תִּתְנַהֵג תָּמִיד לְדַבֵּר כָּל דְּבָרֶיךָ בְּנַחַת לְכָל אָדָם וּבְכָל עֵת,",
     "kind": "prayer"
    },
    {
     "text": " וּבָזֶה תִּנָצֵל מִן הַכַּעַס,",
     "kind": "prayer"
    },
    {
     "text": " שֶׁהִיא מִדָּה רָעָה לְהַחֲטִיא בְּנֵי אָדָם. וְכֵן אָמְרוּ רַבּוֹתֵינוּ זִכְרוֹנָם לִבְרָכָה,",
     "kind": "prayer"
    },
    {
     "text": " כָּל הַכּוֹעֵס כָּל מִינֵי גֵּיהִנָּם שׁוֹלְטִין בּוֹ,",
     "kind": "prayer"
    },
    {
     "text": " שֶׁנֶאֱמַר הָסֵר כַּעַס מִלִּבֶּךָ,",
     "kind": "prayer"
    },
    {
     "text": " וְהַעֲבֵר רָעָה מִבְּשָׂרֶךָ,",
     "kind": "prayer"
    },
    {
     "text": " וְאֵין רָעָה אֶלָא גֵּיהִנָם,",
     "kind": "prayer"
    },
    {
     "text": " שֶׁנֶאֱמַר וְגַם רָשָׁע לְיוֹם רָעָה. וְכַאֲשֶׁר תִּנָצֵל מִן הַכַּעַס תַּעֲלֶה עַל לִבְּךָ מִדַּת הָעֲנָוָה שֶׁהִיא מִדָּה טוֹבָה מִכָּל הַמִּדּוֹת טוֹבוֹת,",
     "kind": "prayer"
    },
    {
     "text": " שֶׁנֶאֱמַר עֵקֶב עֲנָוָה יִרְאַת יְהֹוָה: וּבַעֲבוּר הָעֲנָוָה תַּעֲלֶה עַל לִבְּךָ מִדַּת הַיִרְאָה,",
     "kind": "prayer"
    },
    {
     "text": " כִּי תִתֵּן אֶל לִבְּךָ תָּמִיד,",
     "kind": "prayer"
    },
    {
     "text": " מֵאַיִן בָּאתָ,",
     "kind": "prayer"
    },
    {
     "text": " וּלְאָן אַתָּה הוֹלֵךְ,",
     "kind": "prayer"
    },
    {
     "text": " וְשֶׁאַתָּה רִמָּה וְתוֹלֵעָה בְּחַיֶךָ,",
     "kind": "prayer"
    },
    {
     "text": " וְאַף כִּי בְמוֹתָךְ,",
     "kind": "prayer"
    },
    {
     "text": " וְלִפְנֵי מִי אַתָּה עָתִיד לִיתֵּן דִּין וְחֶשְׁבּוֹן,",
     "kind": "prayer"
    },
    {
     "text": " לִפְנֵי מֶלֶךְ הַכָּבוֹד,",
     "kind": "prayer"
    },
    {
     "text": " שֶׁנֶאֱמַר הִנֵּה הַשָׁמַיִם וּשְׁמֵי הַשָׁמַיִם לֹא יְכַלְכְּלוּךָ,",
     "kind": "prayer"
    },
    {
     "text": " אַף כִּי לִבּוֹת בְּנֵי אָדָם,",
     "kind": "instruction",
     "en": "(from the Holy Name)"
    },
    {
     "text": " וְנֶאֱמַר הֲלֹא אֶת הַשָׁמַיִם וְאֶת הָאָרֶץ אֲנִי מָלֵא נְאֻם יְהֹוָה וְכַאֲשֶׁר תַּחְשׁוֹב אֶת כָּל אֵלֶּה,",
     "kind": "prayer"
    },
    {
     "text": " תִּירָא מִבּוֹרְאֶךָ וְתִשְׁמוֹר מִן הַחֵטְא,",
     "kind": "prayer"
    },
    {
     "text": " וּבְמִדּוֹת הָאֵלֶּה תִּהְיֶה שָׂמֵחַ בְּחֶלְקֶךָ,",
     "kind": "prayer"
    },
    {
     "text": " וְכַאֲשֶׁר תִּתְנַהֵג בְּמִדַּת הָעֲנָוָה לְהִתְבּוֹשֵׁשׁ מִכָּל אָדָם וּלְהִתְפָּחֵד מִמֶּנּוּ ",
     "kind": "prayer"
    },
    {
     "text": "<small>(מהשי\"ת)</small>",
     "kind": "prayer"
    },
    {
     "text": " וּמִן הַחֵטְא,",
     "kind": "prayer"
    },
    {
     "text": " אָז תִּשְׁרֶה עָלֶיךָ רוּחַ הַשְׁכִינָה,",
     "kind": "prayer"
    },
    {
     "text": " וְזִיו כְּבוֹדָהּ,",
     "kind": "prayer"
    },
    {
     "text": " וְחַיֵּי עוֹלָם הַבָּא: וְעַתָּה בְּנִי דַע וּרְאֵה,",
     "kind": "prayer"
    },
    {
     "text": " כִּי הַמִּתְגָּאֶה בְּלִבּוֹ עַל הַבְּרִיוֹת,",
     "kind": "prayer"
    },
    {
     "text": " מוֹרֵד הוּא בְּמַלְכוּת שָׁמַיִם,",
     "kind": "prayer"
    },
    {
     "text": " כִּי מִתְפָּאֵר הוּא בִּלְבוּשׁ מַלְכוּת שָׁמַיִם,",
     "kind": "prayer"
    },
    {
     "text": " שֶׁנֶאֱמַר יְהֹוָה מָלָךְ גֵּאוּת לָבֵשׁ וגו'. וּבַמֶּה יִתְגָּאֶה לֵב הָאָדָם,",
     "kind": "prayer"
    },
    {
     "text": " אִם בְּעוֹשֶׁר,",
     "kind": "prayer"
    },
    {
     "text": " יְהֹוָה מוֹרִישׁ וּמַעֲשִׁיר,",
     "kind": "prayer"
    },
    {
     "text": " וְאִם בְּכָבוֹד,",
     "kind": "prayer"
    },
    {
     "text": " הֲלֹא לֵאלֹהִים הוּא,",
     "kind": "prayer"
    },
    {
     "text": " שֶׁנֶאֱמַר וְהָעוֹשֶׁר וְהַכָּבוֹד מִלְּפָנֶיךָ,",
     "kind": "prayer"
    },
    {
     "text": " וְאֵיךְ מִתְפָּאֵר בִּכְבוֹד קוֹנוֹ. וְאִם מִתְפָּאֵר בְּחָכְמָה,",
     "kind": "prayer"
    },
    {
     "text": " מֵסִיר שָׂפָה לְנֶאֱמָנִים,",
     "kind": "prayer"
    },
    {
     "text": " וְטַעַם זְקֵנִים יִקַּח. נִמְצָא הַכֹּל שָׁוֶה לִפְנֵי הַמָּקוֹם,",
     "kind": "prayer"
    },
    {
     "text": " כִּי בְאַפּוֹ מַשְׁפִּיל גֵּאִים,",
     "kind": "prayer"
    },
    {
     "text": " וּבִרְצוֹנוֹ מַגְבִּיהַּ שְׁפָלִים,",
     "kind": "prayer"
    },
    {
     "text": " לָכֵן הַשְׁפִּיל עַצְמְךָ וִינַשְׂאֲךָ הַמָּקוֹם: עַל כֵּן אֲפָרֵשׁ לְךָ אֵיךְ תִּתְנַהֵג בְּמִדַּת הָעֲנָוָה לָלֶכֶת בָּהּ תָּמִיד. כָּל דְּבָרֶיךָ יִהְיוּ בְּנַחַת,",
     "kind": "prayer"
    },
    {
     "text": " וְרֹאשְׁךָ כָּפוּף,",
     "kind": "prayer"
    },
    {
     "text": " וְעֵינֶיךָ יַבִּיטוּ לְמַטָּה לָאָרֶץ וְלִבְּךָ לְמַעְלָה,",
     "kind": "prayer"
    },
    {
     "text": " וְאַל תַּבִּיט בִּפְנֵי אָדָם בְּדַבֶּרְךָ עִמּוֹ,",
     "kind": "prayer"
    },
    {
     "text": " וְכָל אָדָם יִהְיֶה גָּדוֹל מִמְּךָ בְּעֵינֶיךָ,",
     "kind": "prayer"
    },
    {
     "text": " וְאִם חָכָם אוֹ עָשִׁיר הוּא,",
     "kind": "prayer"
    },
    {
     "text": " עָלֶיךָ לְכַבְּדוֹ. וְאִם רָשׁ הוּא,",
     "kind": "prayer"
    },
    {
     "text": " וְאַתָּה עָשִׁיר אוֹ חָכָם מִמֶּנּוּ,",
     "kind": "prayer"
    },
    {
     "text": " חֲשׁוֹב בְּלִבְּךָ כִּי אַתָּה חַיָּב מִמֶּנּוּ וְהוּא זַכַּאי מִמְּךָ,",
     "kind": "prayer"
    },
    {
     "text": " שֶׁאִם הוּא חוֹטֵא הוּא שׁוֹגֵג וְאַתָּה מֵזִיד: בְּכָל דְּבָרֶיךָ וּמַעֲשֶׂיךָ וּמַחְשְׁבוֹתֶיךָ וּבְכָל עֵת,",
     "kind": "prayer"
    },
    {
     "text": " חֲשׁוֹב בְּלִבָּךְ כְּאִילּוּ אַתָּה עוֹמֵד לִפְנֵי הַקָדוֹשׁ בָּרוּךְ הוּא,",
     "kind": "prayer"
    },
    {
     "text": " וּשְׁכִינָתוֹ עָלֶיךָ. כִּי כְּבוֹדוֹ מָלֵא הָעוֹלָם,",
     "kind": "prayer"
    },
    {
     "text": " וּדְבָרֶיךָ יִהְיוּ בְּאֵימָה וּבְיִרְאָה כְּעֶבֶד לִפְנֵי רַבּוֹ,",
     "kind": "prayer"
    },
    {
     "text": " וְתִתְבַּיֵּשׁ מִכָּל אָדָם,",
     "kind": "prayer"
    },
    {
     "text": " וְאִם יִקְרָאֲךָ אִישׁ אַל תַּעֲנֵהוּ בְּקוֹל רָם,",
     "kind": "prayer"
    },
    {
     "text": " רַק בְּנַחַת כְּעוֹמֵד לִפְנֵי רַבּוֹ: וֶהֱוֵי זָּהִיר לִקְרוֹת בַּתּוֹרָה תָמִיד אֲשֶׁר תּוּכַל לְקַיְמָהּ,",
     "kind": "prayer"
    },
    {
     "text": " וְכַאֲשֶׁר תָּקוּם מִן הַסֵּפֶר,",
     "kind": "prayer"
    },
    {
     "text": " תְּחַפֵּשׂ בַּאֲשֶׁר לָמַדְּתָּ אִם יֵשׁ בּוֹ דָּבָר אֲשֶׁר תּוּכַל לְקַיְּמוֹ,",
     "kind": "prayer"
    },
    {
     "text": " וּתְפַשְׁפֵּשׁ בְּמַעֲשֶׂיךָ בַּבֹּקֶר וּבָעֶרֶב,",
     "kind": "prayer"
    },
    {
     "text": " וּבָזֶה יִהְיוּ כָּל יָמֶיךָ בִּתְשׁוּבָה: וְהָסֵר כָּל דִבְרֵי הָעוֹלָם מִלִבְּךָ בְּעֵת הַתְּפִלָּה,",
     "kind": "prayer"
    },
    {
     "text": " וְהָכֵן לִבְּךָ לִפְנֵי הַמָקוֹם בָּרוּךְ הוּא,",
     "kind": "prayer"
    },
    {
     "text": " וְטַהֵר רַעְיוֹנֶיךָ,",
     "kind": "prayer"
    },
    {
     "text": " וַחֲשׁוֹב הַדִּבּוּר קוֹדֶם שֶׁתּוֹצִיאֶנּוּ מִפִּיךָ,",
     "kind": "prayer"
    },
    {
     "text": " וְכֵן תַּעֲשֶׂה כָּל יְמֵי חַיֵּי הֶבְלֶךָ בְּכָל דָבָר וְדָבָר וְלֹא תֶחֱטָא,",
     "kind": "prayer"
    },
    {
     "text": " וּבָזֶה יִהְיוּ דְּבָרֶיךָ וּמַעֲשֶׂיךָ וּמַחְשְׁבוֹתֶיךָ יְשָׁרִים,",
     "kind": "prayer"
    },
    {
     "text": " וּתְפִלָּתְךָ תִּהְיֶה זַכָּה וּבָרָה וּנְקִיָּה וּמְכֻוֶּנֶת וּמְקֻבֶּלֶת לִפְנֵי הַמָּקוֹם בָּרוּךְ הוּא,",
     "kind": "prayer"
    },
    {
     "text": " שֶׁנֶאֱמַר תָּכִין לִבָּם תַּקְשִׁיב אָזְנֶיךָ: תִּקְרָא הָאִגֶּרֶת הַזֹּאת פַּעַם אַחַת בַּשָׁבוּעַ וְלֹא תִפְחוֹת,",
     "kind": "prayer"
    },
    {
     "text": " לְקַיְּמָהּ וְלָלֶכֶת בָּהּ תָּמִיד אַחַר הַשֵׁם יִתְבָּרַךְ,",
     "kind": "prayer"
    },
    {
     "text": " לְמַעַן תַּצְלִיחַ בְּכָל דְּרָכֶיךָ וְתִזְכֶּה לְעוֹלָם הַבָּא הַצָּפוּן לַצַּדִּיקִים,",
     "kind": "prayer"
    },
    {
     "text": " וּבְכָל יוֹם שֶׁתִּקְרָאֶנָּה יַעֲנוּךָ מִן הַשָׁמַיִם כַּאֲשֶׁר יַעֲלֶה עַל לִבְּךָ לִשְׁאוֹל עַד עוֹלָם אָמֵן סֶלָה:",
     "kind": "prayer"
    }
   ]
  },
