  "he:Festivals/Selichot/Yom Kippur Katan:27": {
   "kind": "prayer",
   "node": "x.selichot.piyyut"
  },
  "he:Festivals/Selichot/Yom Kippur Katan:28": {
   "kind": "prayer",
   "node": "x.selichot.piyyut"
  },
  "he:Festivals/Selichot/Yom Kippur Katan:29": {
   "parts": [
    {
     "text": "<em><small>חזן</small></em> ",
     "kind": "speaker",
     "en": "Chazzan:",
     "role": "chazzan",
     "node": "x.selichot.piyyut"
    },
    {
     "kind": "prayer",
     "node": "x.selichot.piyyut",
     "text": "מַשְׂאַת כַּפַּי מִנְחַת עֶרֶב רְצֵה נָא בְכֹשֶׁר, תִּכּוֹן תְּפִלָּתִי קְטוֹרֶת לְפָנֶיךָ בְּתֹם וּבְיֹשֶׁר, בְּקָרְאִי עֲנֵנִי צוּרִי הַיּוֹם יִפְנֶה: ",
     "role": "chazzan"
    }
   ]
  },
  "he:Festivals/Selichot/Yom Kippur Katan:30": {
   "parts": [
    {
     "text": "<em><small>קהל</small></em> - ",
     "kind": "speaker",
     "en": "Congregation:",
     "role": "congregation",
     "node": "x.selichot.piyyut"
    },
    {
     "kind": "prayer",
     "node": "x.selichot.piyyut",
     "text": "כַּאֲשֶׁר יָבִיאוּ בְּנֵי יִשְׂרָאֵל אֶת הַמִּנְחָה: ",
     "role": "congregation"
    }
   ]
  },
  "he:Festivals/Selichot/Yom Kippur Katan:31": {
   "parts": [
    {
     "text": "<em><small>חזן</small></em> - ",
     "kind": "speaker",
     "en": "Chazzan:",
     "role": "chazzan",
     "node": "x.selichot.piyyut"
    },
    {
     "kind": "prayer",
     "node": "x.selichot.piyyut",
     "text": "רֵיחַ נִיחוֹחַ אִמְרֵי פִי לְפָנֶיךָ צוּר עוֹלָמִים, חֶלְבִּי וְדָמִי הַנִּמְעַט בְּצוֹמִי תְּמוּר חֲלָבִים וְדָמִים, קַבֵּל הֶגְיוֹן לִבִּי אֲשֶׁר עָרַכְתִּי הַיּוֹם ",
     "role": "chazzan"
    },
    {
     "kind": "note",
     "en": "Another version: \"zeh kamah yamim\" (\"these several days\")",
     "node": "x.selichot.piyyut",
     "text": "<em><small>נ\"א זֶה כַּמָה יָמִים</small></em>"
    },
    {
     "kind": "prayer",
     "node": "x.selichot.piyyut",
     "text": " בַּנְעִימִים: ",
     "role": "chazzan"
    }
   ]
  },
  "he:Festivals/Selichot/Yom Kippur Katan:32": {
   "parts": [
    {
     "text": "<em><small>קהל</small></em> - ",
     "kind": "speaker",
     "en": "Congregation:",
     "role": "congregation",
     "node": "x.selichot.piyyut"
    },
    {
     "kind": "prayer",
     "node": "x.selichot.piyyut",
     "text": "כְּחַטָּאת כָּאָשָׁם וְכַמִּנְחָה: ",
     "role": "congregation"
    }
   ]
  },
  "he:Festivals/Selichot/Yom Kippur Katan:33": {
   "parts": [
    {
     "text": "<em><small>חזן</small></em> - ",
     "kind": "speaker",
     "en": "Chazzan:",
     "role": "chazzan",
     "node": "x.selichot.piyyut"
    },
    {
     "kind": "prayer",
     "node": "x.selichot.piyyut",
     "text": "דְרוֹשׁ נָא בְּיוֹם זֶה דּוֹרְשֶׁיךָ וְהִדָּרֵשׁ לָהֶם בְּנִיב שְׂפָתָיִם, שְׁעֵה לְמַעֲמָדָם וְטַהֲרֵם כַּכֶּסֶף מְזֻקָּק שִׁבְעָתָיִם, וּרְצֵה שִׂיחָתָם כְּשֶׂה אַחַת מִן הַצֹאן מִן הַמָּאתָיִם: ",
     "role": "chazzan"
    }
   ]
  },
  "he:Festivals/Selichot/Yom Kippur Katan:34": {
   "parts": [
    {
     "text": "<em><small>קהל</small></em> - ",
     "kind": "speaker",
     "en": "Congregation:",
     "role": "congregation",
     "node": "x.selichot.piyyut"
    },
    {
     "kind": "prayer",
     "node": "x.selichot.piyyut",
     "text": "מִמַּשְׁקֵה יִשְׂרָאֵל לַמִּנְחָה: ",
     "role": "congregation"
    }
   ]
  },
  "he:Festivals/Selichot/Yom Kippur Katan:35": {
   "parts": [
    {
     "text": "<em><small>חזן</small></em> - ",
     "kind": "speaker",
     "en": "Chazzan:",
     "role": "chazzan",
     "node": "x.selichot.piyyut"
    },
    {
     "kind": "prayer",
     "node": "x.selichot.piyyut",
     "text": "כָּלִיל וְעוֹלָה תְּחִנָתִי תֵּחָשֵׁב וּמַשְׂטִינִי רִיב תָּרִיב, וְתוֹצִיא כָאוֹר צִדְקִי טֶרֶם יָבוֹא הַשֶּׁמֶשׁ וְיַעֲרִיב, שָׁפוֹךְ כַּמַיִם לִבּוֹ בִּתְפִלָּתוֹ כָּל אִישׁ. ",
     "role": "chazzan"
    }
   ]
  },
  "he:Festivals/Selichot/Yom Kippur Katan:36": {
   "parts": [
    {
     "text": "<em><small>קהל</small></em> - ",
     "kind": "speaker",
     "en": "Congregation:",
     "role": "congregation",
     "node": "x.selichot.piyyut"
    },
    {
     "kind": "prayer",
     "node": "x.selichot.piyyut",
     "text": "וְהִקְרִיב הַמַּקְרִיב קָרְבָּנוֹ לַיהֹוָה מִנְחָה: ",
     "role": "congregation"
    }
   ]
  },
  "he:Festivals/Selichot/Yom Kippur Katan:37": {
   "parts": [
    {
     "text": "<em><small>חזן</small></em> - ",
     "kind": "speaker",
     "en": "Chazzan:",
     "role": "chazzan",
     "node": "x.selichot.piyyut"
    },
    {
     "kind": "prayer",
     "node": "x.selichot.piyyut",
     "text": "יְשֻׁרוּן עַמְּךָ יָשִׁיר חַסְדְּךָ בְּטוֹב לֶקַח, הַטֵּה אֵלָיו אָזְנְךָ וּשְׁמָע וְעֵינֶיךָ פְּקַח, וּרְאֵה כִּי טוֹב מִסְתּוֹפֵף בְּשַׁעֲרֵי רַחֲמֶיךָ: ",
     "role": "chazzan"
    }
   ]
  },
  "he:Festivals/Selichot/Yom Kippur Katan:38": {
   "parts": [
    {
     "text": "<em><small>קהל</small></em> - ",
     "kind": "speaker",
     "en": "Congregation:",
     "role": "congregation",
     "node": "x.selichot.piyyut"
    },
    {
     "kind": "prayer",
     "node": "x.selichot.piyyut",
     "text": "וַיִּקַּח מִן הַבָּא בְּיָדוֹ מִנְחָה: ",
     "role": "congregation"
    }
   ]
  },
  "he:Festivals/Selichot/Yom Kippur Katan:39": {
   "parts": [
    {
     "text": "<em><small>חזן</small></em> - ",
     "kind": "speaker",
     "en": "Chazzan:",
     "role": "chazzan",
     "node": "x.selichot.piyyut"
    },
    {
     "kind": "prayer",
     "node": "x.selichot.piyyut",
     "text": "בְּרוֹב רַחֲמֶיךָ אֲמָרַי הַאֲזִינָה יְהֹוָה הֲגִיגִי בִּינָה, אִם נָא מָצָאתִי חֵן בְּעֵינֶיךָ אֱלֹהֵי קֶדֶם מְעוֹנָה, וְלָקַחְתָּ מִנְחָתִי מִיָּדִי אֲשֶׁר הֵבֵאתִי לְךָ בִּתְחִנָּה: ",
     "role": "chazzan"
    }
   ]
  },
  "he:Festivals/Selichot/Yom Kippur Katan:40": {
   "parts": [
    {
     "text": "<em><small>קהל</small></em> - ",
     "kind": "speaker",
     "en": "Congregation:",
     "role": "congregation",
     "node": "x.selichot.piyyut"
    },
    {
     "kind": "prayer",
     "node": "x.selichot.piyyut",
     "text": "וַיְהִי כַּעֲלוֹת הַמִּנְחָה: ",
     "role": "congregation"
    }
   ]
  },
  "he:Festivals/Selichot/Yom Kippur Katan:41": {
   "parts": [
    {
     "text": "<em><small>חזן</small></em> - ",
     "kind": "speaker",
     "en": "Chazzan:",
     "role": "chazzan",
     "node": "x.selichot.piyyut"
    },
    {
     "kind": "prayer",
     "node": "x.selichot.piyyut",
     "text": "שַׁדַּי לֹא מְצָאנוּךָ שַׂגִּיא כֹחַ לָעֵדָה מִקֶּדֶם קָנִיתָ, אֶחָד הַמַּרְבֶּה וְאֶחָד הַמַּמְעִיט בְּשׁוּבוֹ נַפְשׁוֹ רָצִיתָ, אַךְ יְכַוֵּן לִבּוֹ לְפָנֶיךָ בְּמִנְחָתוֹ בְּעֵת הַקְרִיב אוֹתָהּ: ",
     "role": "chazzan"
    }
