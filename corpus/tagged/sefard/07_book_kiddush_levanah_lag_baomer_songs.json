  },
  "he:Kiddush Levanah:23": {
   "kind": "instruction",
   "en": "Mourner's Kaddish:"
  },
  "he:Kiddush Levanah:24": {
   "parts": [
    {
     "text": "<small> <b>יִתְגַּדַּל</b> וְיִתְקַדַּשׁ שְׁמֵהּ רַבָּא. בְּעָלְמָא דִּי בְרָא כִרְעוּתֵהּ וְיַמְלִיךְ מַלְכוּתֵה,",
     "kind": "prayer",
     "role": "mourner",
     "voice": "aloud",
     "minyan": true
    },
    {
     "text": " וְיַצְמַח פֻּרְקָנֵה,",
     "kind": "prayer",
     "role": "mourner",
     "voice": "aloud",
     "minyan": true
    },
    {
     "text": " וִיקָרֵב מְשִׁיחֵהּ. בְּחַיֵּיכוֹן וּבְיוֹמֵיכוֹן וּבְחַיֵּי דְכָל בֵּית יִשְׂרָאֵל,",
     "kind": "prayer",
     "role": "mourner",
     "voice": "aloud",
     "minyan": true
    },
    {
     "text": " בַּעֲגָלָא וּבִזְמַן קָרִיב,",
     "kind": "prayer",
     "role": "mourner",
     "voice": "aloud",
     "minyan": true
    },
    {
     "text": " וְאִמְרוּ אָמֵן. <b>יְהֵא שְׁמֵהּ רַבָּא מְבָרַךְ לְעָלַם וּלְעָלְמֵי עָלְמַיָּא יִתְבָּרַךְ.</b> וְיִשְׁתַּבַּח. וְיִתְפָּאַר. וְיִתְרוֹמַם. וְיִתְנַשֵּׂא. וְיִתְהַדָּר. וְיִתְעַלֶּה. וְיִתְהַלָּל שְׁמֵהּ דְּקֻדְשָׁא,",
     "kind": "prayer",
     "role": "mourner",
     "voice": "aloud",
     "minyan": true
    },
    {
     "text": " בְּרִיךְ הוּא. לְעֵלָּא <small>(בעשי\"ת וּלְעֵלָּא מִכָּל)</small>",
     "kind": "instruction",
     "role": "mourner",
     "voice": "aloud",
     "minyan": true,
     "en": "(During the Ten Days of Repentance:)",
     "gloss": "Added during Aseret Yemei Teshuva",
     "forgot": true,
     "when": "aseretYemeiTeshuva"
    },
    {
     "text": " מִן כָּל בִּרְכָתָא וְשִׁירָתָא,",
     "kind": "prayer",
     "role": "mourner",
     "voice": "aloud",
     "minyan": true
    },
    {
     "text": " תֻּשְׁבְּחָתָא וְנֶחֱמָתָא,",
     "kind": "prayer",
     "role": "mourner",
     "voice": "aloud",
     "minyan": true
    },
    {
     "text": " דַּאֲמִירָן בְּעָלְמָא,",
     "kind": "prayer",
     "role": "mourner",
     "voice": "aloud",
     "minyan": true
    },
    {
     "text": " וְאִמְרוּ אָמֵן: </small>",
     "kind": "prayer",
     "role": "mourner",
     "voice": "aloud",
     "minyan": true
    }
   ]
  },
  "he:Kiddush Levanah:25": {
   "parts": [
    {
     "text": "<b>יְהֵא</b> שְׁלָמָא רַבָּא מִן שְׁמַיָּא וְחַיִּים טוֹבִים עָלֵינוּ וְעַל כָּל יִשְׂרָאֵל וְאִמְרוּ אָמֵן: <b>עֹשֶׂה</b> שָׁלוֹם ",
     "kind": "prayer",
     "role": "mourner",
     "voice": "aloud",
     "minyan": true
    },
    {
     "text": "<small> <small>(בעשי\"ת <b>הַשָּׁלוֹם</b>)</small>",
     "kind": "instruction",
     "role": "mourner",
     "voice": "aloud",
     "minyan": true,
     "en": "(During the Ten Days of Repentance:)",
     "gloss": "Added during Aseret Yemei Teshuva",
     "forgot": true,
     "when": "aseretYemeiTeshuva"
    },
    {
     "text": " </small> בִּמְרוֹמָיו הוּא יַעֲשֶׂה שָׁלוֹם עָלֵינוּ וְעַל כָּל יִשְׂרָאֵל וְאִמְרוּ אָמֵן: ",
     "kind": "prayer",
     "role": "mourner",
     "voice": "aloud",
     "minyan": true
    }
   ]
  },
