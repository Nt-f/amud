    }
   ]
  },
  "he:Kiddush Levanah:15": {
   "parts": [
    {
     "text": "<small><small>(ג\"פ:)</small>",
     "kind": "instruction",
     "en": "(Three times:)",
     "gloss": "Said three times"
    },
    {
     "text": "</small> <b>סִמָּן</b> טוֹב וּמַזָּל טוֹב יְהֵא לָנוּ וּלְכָל יִשְׂרָאֵל אָמֵן: ",
     "kind": "prayer",
     "repeat": 3
    }
   ]
