  },
  "he:Festivals/Selichot/Fast of Gedalia:263": {
   "parts": [
    {
     "kind": "prayer",
     "node": "selichot.fast_day",
     "role": "chazzan",
     "text": "סְלַח נָא לַעֲו‍ֹן הָעָם הַזֶּה כְּגֹדֶל חַסְדֶּךָ וְכַאֲשֶׁר נָשָׂאתָה לָעָם הַזֶּה מִמִּצְרַיִם וְעַד הֵנָּה: <em><small>במדבר יד, יט</small></em>    "
    },
    {
     "kind": "prayer",
     "node": "selichot.fast_day",
     "role": "chazzan",
     "text": "ושם נאמר: "
    },
    {
     "kind": "prayer",
     "node": "selichot.fast_day",
     "role": "congregation",
     "text": "וַיֹּאמֶר יְיָ סָלַחְתִּי כִּדְבָרֶךָ: <em><small>במדבר יד, כ</small></em>"
    }
   ]
  },
